{
  "name": "@tylix/core",
  "version": "2.1.0",
  "description": "The Tylix server core: HTTP server and router, Laravel-style log channels, metrics and health checks, a shared store (memory, database, Redis), cache, rate limiting, a queue with retries and backoff, scheduler, channels and plugins.",
  "license": "MIT",
  "author": "Mbiyrukzz",
  "type": "module",
  "keywords": [
    "tylix",
    "core",
    "http",
    "server",
    "router",
    "observability",
    "cache",
    "queue",
    "websocket",
    "logging",
    "log-channels",
    "plugins",
    "retries",
    "backoff",
    "scheduler"
  ],
  "homepage": "https://github.com/Mbiyrukzz/tylix/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mbiyrukzz/tylix.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Mbiyrukzz/tylix/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test 'src/**/*.test.js'"
  },
  "dependencies": {
    "@tylix/auth": "^2.1.0",
    "@tylix/orm": "^2.1.0",
    "@tylix/shared": "^2.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1"
  }
}

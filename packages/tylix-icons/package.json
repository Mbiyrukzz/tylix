{
  "name": "tylix-icons",
  "version": "1.1.0",
  "description": "Icons for Tylix apps: native .tyx components plus React, Vue, Svelte and Angular components, from one source.",
  "license": "MIT",
  "author": "Mbiyrukzz",
  "type": "module",
  "keywords": [
    "tylix",
    "icons",
    "ui",
    "components",
    "svg",
    "react",
    "vue",
    "svelte",
    "angular"
  ],
  "homepage": "https://github.com/Mbiyrukzz/tylix/tree/main/packages/tylix-icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mbiyrukzz/tylix.git",
    "directory": "packages/tylix-icons"
  },
  "bugs": {
    "url": "https://github.com/Mbiyrukzz/tylix/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "sideEffects": false,
  "exports": {
    "./react": {
      "types": "./react/index.d.ts",
      "default": "./react/index.js"
    },
    "./vue": {
      "types": "./vue/index.d.ts",
      "default": "./vue/index.js"
    },
    "./svelte": {
      "types": "./svelte/index.d.ts",
      "svelte": "./svelte/index.js",
      "default": "./svelte/index.js"
    },
    "./angular": {
      "types": "./angular/index.d.ts",
      "default": "./angular/fesm2022/index.mjs"
    },
    "./data": {
      "types": "./data/index.d.ts",
      "default": "./data/index.js"
    },
    "./tylix-components.json": "./tylix-components.json",
    "./icons/*": "./icons/*",
    "./package.json": "./package.json"
  },
  "files": [
    "icons",
    "react",
    "vue",
    "svelte",
    "angular",
    "data",
    "src/icons.json",
    "tylix-components.json",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3",
    "svelte": ">=5",
    "@angular/core": ">=20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "private": false
}

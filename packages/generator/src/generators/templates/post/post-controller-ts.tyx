/**
 * Feature: Post (owner-scoped override, TypeScript)
 *
 * Generated by PostBoilerplateGenerator, replacing the default
 * ControllerGenerator output so that:
 *   - index/show only return the logged-in user's own posts
 *   - store always sets user_id from req.user, never from the client
 *   - destroy/update 403 if the post belongs to someone else
 *
 * publicIndex/publicShow are the exception: they are read-only, safe to
 * call without logging in, and are registered in app/routes/web.ts
 * (outside requireAuth) at /api/public/posts.
 *
 * cover_image is optional and must be a path produced by UploadController
 * (/uploads/<32 hex>.<ext>), never an arbitrary URL. The file is removed
 * when the post is deleted or its cover is replaced.
 */

import fs from "node:fs/promises";
import path from "node:path";
import type { TylixRequest, TylixResponse } from "@tylix/core";
import { Post } from "../models/Post.js";
import { User } from "../models/User.js";
import { validatePost } from "../validators/PostValidator.js";

export interface PostRow {
    id: number;
    title: string;
    body: string;
    cover_image: string | null;
    user_id: number;
    created_at: string;
    updated_at: string;
    [key: string]: unknown;
}

interface UserRow {
    id: number;
    name?: string | null;
    [key: string]: unknown;
}

const EXCERPT_LENGTH = 180;
const COVER_RE = /^\/uploads\/[a-f0-9]{32}\.(png|jpg|webp|gif)$/;

function cleanCover(value: unknown): string | null {
    if (!value) return null;
    const text = String(value);
    return COVER_RE.test(text) ? text : null;
}

// Deletes an uploaded file. Only paths that match COVER_RE are touched,
// so a bad value in the database can never point outside public/uploads.
async function removeCover(cover: unknown): Promise<void> {
    if (!cover || !COVER_RE.test(String(cover))) return;
    try {
        await fs.unlink(path.join(process.cwd(), "public", String(cover)));
    } catch {
        // Already gone, or not removable: the post operation still succeeds.
    }
}

function newestFirst(a: PostRow, b: PostRow): number {
    return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
}

// Only the fields a public visitor should see. Never expose user_id
// or the author's email.
async function authorName(userId: number): Promise<string> {
    try {
        const user = (await User.find(userId)) as UserRow | null;
        return user?.name ?? "Anonymous";
    } catch {
        return "Anonymous";
    }
}

export class PostController {
    async index(req: TylixRequest, res: TylixResponse) {
        const posts = (await Post.all()) as PostRow[];
        const ownPosts = posts
            .filter((p) => p.user_id === req.user?.userId)
            .sort(newestFirst);

        return res.json(ownPosts);
    }

    async show(req: TylixRequest, res: TylixResponse) {
        const post = (await Post.find(req.params.id)) as PostRow | null;

        if (!post) {
            res.status(404);
            return res.json({ error: "Post not found." });
        }
        if (post.user_id !== req.user?.userId) {
            res.status(403);
            return res.json({ error: "You don't have permission to view this post." });
        }

        return res.json(post);
    }

    async publicIndex(req: TylixRequest, res: TylixResponse) {
        const posts = ((await Post.all()) as PostRow[]).sort(newestFirst);

        const result = [];
        for (const p of posts) {
            const body = String(p.body ?? "");
            result.push({
                id: p.id,
                title: p.title,
                excerpt:
                    body.length > EXCERPT_LENGTH
                        ? body.slice(0, EXCERPT_LENGTH).trimEnd() + "…"
                        : body,
                cover_image: p.cover_image ?? null,
                author: await authorName(p.user_id),
                created_at: p.created_at,
            });
        }

        return res.json(result);
    }

    async publicShow(req: TylixRequest, res: TylixResponse) {
        const post = (await Post.find(req.params.id)) as PostRow | null;

        if (!post) {
            res.status(404);
            return res.json({ error: "Post not found." });
        }

        return res.json({
            id: post.id,
            title: post.title,
            body: post.body,
            cover_image: post.cover_image ?? null,
            author: await authorName(post.user_id),
            created_at: post.created_at,
        });
    }

    async store(req: TylixRequest, res: TylixResponse) {
        const result = validatePost(req.body);
        if (!result.valid) {
            res.status(422);
            return res.json({ errors: result.errors });
        }

        const cover = cleanCover(req.body.cover_image);
        if (req.body.cover_image && !cover) {
            res.status(422);
            return res.json({ errors: { cover_image: ["Invalid cover image."] } });
        }

        const post = await Post.create({
            title: req.body.title,
            body: req.body.body,
            cover_image: cover,
            user_id: req.user?.userId,
        });

        res.status(201);
        return res.json(post);
    }

    async update(req: TylixRequest, res: TylixResponse) {
        const post = (await Post.find(req.params.id)) as PostRow | null;
        if (!post) {
            res.status(404);
            return res.json({ error: "Post not found." });
        }
        if (post.user_id !== req.user?.userId) {
            res.status(403);
            return res.json({ error: "You don't have permission to edit this post." });
        }

        const result = validatePost(req.body);
        if (!result.valid) {
            res.status(422);
            return res.json({ errors: result.errors });
        }

        const cover = cleanCover(req.body.cover_image);
        if (req.body.cover_image && !cover) {
            res.status(422);
            return res.json({ errors: { cover_image: ["Invalid cover image."] } });
        }

        const previousCover = post.cover_image;

        const updated = await Post.update(post.id, {
            title: req.body.title,
            body: req.body.body,
            cover_image: cover,
        });

        if (previousCover && previousCover !== cover) {
            await removeCover(previousCover);
        }

        return res.json(updated);
    }

    async destroy(req: TylixRequest, res: TylixResponse) {
        const post = (await Post.find(req.params.id)) as PostRow | null;

        if (!post) {
            res.status(404);
            return res.json({ error: "Post not found." });
        }
        if (post.user_id !== req.user?.userId) {
            res.status(403);
            return res.json({ error: "You don't have permission to delete this post." });
        }

        await Post.delete(post.id);
        await removeCover(post.cover_image);

        res.status(204);
        return res.end();
    }
}
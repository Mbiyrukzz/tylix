{
  "name": "@tylix/cli",
  "version": "2.1.0",
  "description": "The Tylix command line: dev server, production server with workers, builds, migrations with rollbacks, generators, queue and channel workers, typed API client, static export, deployment adapters, plugins, logs, tinker and doctor.",
  "license": "MIT",
  "author": "Mbiyrukzz",
  "type": "module",
  "keywords": [
    "tylix",
    "cli",
    "dev-server",
    "ssr",
    "generator",
    "migrations",
    "static-site-generation",
    "ssg",
    "deploy",
    "typed-api",
    "plugins"
  ],
  "homepage": "https://github.com/Mbiyrukzz/tylix/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mbiyrukzz/tylix.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Mbiyrukzz/tylix/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "./src/index.js",
  "types": "./src/testing.d.ts",
  "bin": {
    "tylix": "src/index.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./testing": {
      "types": "./src/testing.d.ts",
      "default": "./src/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test src/**/*.test.js"
  },
  "dependencies": {
    "@tylix/auth": "^2.1.0",
    "@tylix/compiler": "^2.1.0",
    "@tylix/core": "^2.1.0",
    "@tylix/generator": "^2.1.0",
    "@tylix/mail": "^2.1.0",
    "@tylix/orm": "^2.1.0",
    "@tylix/pwa": "^2.1.0",
    "@tylix/shared": "^2.1.0"
  }
}


page {{PageName}}

state
  messages: []
  draft: ""
  channel: null

onMount
  async {
    this.channel = useChannel("{{channelName}}")
 this.channel.onMessage((data) => this.messages = this.messages.concat([data]))
  }

action
  send() {
    if this.draft.trim() is not "" {
      this.channel.send({ text: this.draft })
      this.draft = ""
    }
  }

template
  <div class="max-w-lg mx-auto px-6 py-10">
    <p class="tx-eyebrow mb-3">Live channel</p>
    <h1 class="text-xl font-semibold text-ink mb-4">{{PageName}} — live via useChannel("{{channelName}}")</h1>

    <div class="tx-well p-4 mb-4 min-h-[200px] flex flex-col gap-2">
{{#if messages.length is 0}}
      <p class="text-muted text-sm italic">No messages yet — open this page in two tabs and try it.</p>
{{/if}}
{{#each m in messages}}
      <p class="text-soft text-sm">{{ m.text }}</p>
{{/each}}
    </div>

    <div class="flex gap-2">
      <input
        value="{{ draft }}"
        oninput="{{ draft = $event.target.value }}"
        placeholder="Type a message…"
        class="tx-input flex-1 mb-0"
      />
      <button onclick="{{ send() }}" class="tx-btn tx-btn-primary">
        Send
      </button>
    </div>
  </div>
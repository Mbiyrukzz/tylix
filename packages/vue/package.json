{
  "name": "@tylix/vue",
  "version": "1.0.0",
  "description": "Vue frontend for Tylix: auth and API composables, plus the Vite adapter the Tylix CLI loads.",
  "license": "MIT",
  "author": "Mbiyrukzz",
  "type": "module",
  "keywords": [
    "tylix",
    "vue",
    "adapter",
    "composables",
    "ssr",
    "vite"
  ],
  "homepage": "https://github.com/Mbiyrukzz/tylix/tree/main/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mbiyrukzz/tylix.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/Mbiyrukzz/tylix/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./adapter": {
      "types": "./src/adapter.d.ts",
      "default": "./src/adapter.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    }
  },
  "files": [
    "src",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test src/*.test.js"
  },
  "dependencies": {
    "@tylix/client": "^1.0.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "vue": "^3.5.0"
  }
}

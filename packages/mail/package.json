{
  "name": "@tylix/mail",
  "version": "1.3.0",
  "description": "Email for any Node app: SMTP, Resend, SendGrid, Postmark, Mailgun and Amazon SES transports, templates, attachments and a test fake. Plugs into Tylix with Mailables and a mail log.",
  "license": "MIT",
  "author": "Mbiyrukzz",
  "type": "module",
  "keywords": [
    "mail",
    "email",
    "smtp",
    "resend",
    "sendgrid",
    "postmark",
    "mailgun",
    "ses",
    "tylix"
  ],
  "homepage": "https://github.com/Mbiyrukzz/tylix/tree/main/packages/mail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mbiyrukzz/tylix.git",
    "directory": "packages/mail"
  },
  "bugs": {
    "url": "https://github.com/Mbiyrukzz/tylix/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "Mailer.js",
    "Mailable.js",
    "createMailer.js",
    "mime.js",
    "template.js",
    "SmtpClient.js",
    "models",
    "transports",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@tylix/orm": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@tylix/orm": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}

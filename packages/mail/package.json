{
  "name": "@tylix/mail",
  "version": "0.7.0",
  "description": "Mail system for Tylix: Mailables, SMTP and log drivers, and mail logging",
  "license": "MIT",
  "author": "Mbiyrukzz",
  "type": "module",
  "keywords": [
    "tylix",
    "mail",
    "email",
    "smtp"
  ],
  "homepage": "https://github.com/Mbiyrukzz/tylix/tree/main/packages/mail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mbiyrukzz/tylix.git",
    "directory": "packages/mail"
  },
  "bugs": {
    "url": "https://github.com/Mbiyrukzz/tylix/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "Mailer.js",
    "Mailable.js",
    "models",
    "drivers",
    "SmtpClient.js",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tylix/shared": "^0.7.0",
    "@tylix/generator": "^0.7.0"
  },
  "peerDependencies": {
    "@tylix/orm": "^0.7.0"
  }
}

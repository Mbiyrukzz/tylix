{
  "name": "@tylix/mail",
  "version": "0.5.0",
  "description": "Mail system for Tylix: Mailables, SMTP and log drivers, and mail logging",
  "type": "module",
  "keywords": [
    "tylix",
    "mail",
    "email",
    "smtp"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "Mailer.js",
    "Mailable.js",
    "models",
    "drivers",
    "SmtpClient.js"
  ],
  "dependencies": {
    "@tylix/shared": "^0.5.0"
  },
  "peerDependencies": {
    "@tylix/orm": "^0.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

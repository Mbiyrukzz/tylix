{
  "name": "create-tylix",
  "version": "0.6.0",
  "type": "module",
  "keywords": [
    "tylix",
    "framework",
    "ui"
  ],
  "main": "./src/index.js",
  "bin": {
    "create-tylix": "src/index.js"
  },
  "files": [
    "src",
    "assets"
  ],
  "scripts": {
    "build:starter-css": "tailwindcss -c tailwind.starter.config.js -i src/templates/starter-input.css -o src/templates/starter.css --minify",
    "prepublishOnly": "npm run build:starter-css"
  },
  "dependencies": {
    "@tylix/auth": "^0.6.0",
    "@tylix/cli": "^0.6.0",
    "@tylix/core": "^0.6.0",
    "@tylix/generator": "^0.6.0",
    "@tylix/shared": "^0.6.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

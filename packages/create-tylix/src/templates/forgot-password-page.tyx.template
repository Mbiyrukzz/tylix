page ForgotPassword

title "Forgot password"

needs
  Auth

state
  email: ""
  error: ""
  submitting: false
  sent: false

action
  setEmail(value) {
    this.email = value
  }

  async submit() {
    if this.submitting {
      return null
    }

    if not /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(this.email) {
      this.error = "Enter a valid email address."
      return null
    }

    this.error = ""
    this.submitting = true

    try {
      const result = await useApi("/api/auth/forgot-password", {
        method: "POST",
        body: { email: this.email }
      })

      // The server answers the same way whether or not the email is
      // registered, so this page can't reveal who has an account.
      if result.ok {
        this.sent = true
      } else if result.status is 429 {
        this.error = "Too many requests. Wait a minute and try again."
      } else {
        this.error = result.error ?? "Could not send the reset link. Try again."
      }
    } catch (err) {
      this.error = "Network error. Check your connection and try again."
    } finally {
      this.submitting = false
    }
  }

onMount
  {
    if Auth.user {
      window.location.href = "/dashboard"
    }
  }

template
  <div class="flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-sm rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-8">
{{#if sent}}
      <div data-testid="reset-sent">
        <h1 class="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
        <p class="text-sm text-zinc-500 mb-6">
          If <span class="text-zinc-900 dark:text-zinc-200">{{ email }}</span> has an account, a link to reset the password is on its way.
        </p>
        <a href="/login" class="text-sm text-emerald-600 dark:text-emerald-400 hover:underline">Back to login</a>
      </div>
{{#else}}
      <h1 class="text-2xl font-semibold tracking-tight mb-1">Forgot your password?</h1>
      <p class="text-sm text-zinc-500 mb-6">We'll email you a link to choose a new one.</p>

{{#if error}}
      <div role="alert" aria-live="polite" class="rounded-md border border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
        <p class="text-rose-700 dark:text-rose-400 text-sm">{{ error }}</p>
      </div>
{{/if}}

      <label for="email" class="block text-zinc-500 text-xs font-medium mb-1.5">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        autofocus
        value="{{ email }}"
        oninput="{{ setEmail(event.target.value) }}"
        onkeydown="{{ event.key is 'Enter' and submit() }}"
        class="w-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 rounded-md px-3.5 py-2.5 mb-4 text-sm outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
      />

      <button
        onclick="{{ submit() }}"
        disabled="{{ submitting }}"
        class="w-full bg-emerald-500 text-white dark:text-zinc-950 rounded-md py-2.5 text-sm font-semibold hover:bg-emerald-400 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        {{ submitting ? 'Sending…' : 'Send reset link' }}
      </button>

      <p class="text-sm text-zinc-500 text-center mt-6">
        <a href="/login" class="text-emerald-600 dark:text-emerald-400 hover:underline">Back to login</a>
      </p>
{{/if}}
    </div>
  </div>

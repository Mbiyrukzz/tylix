page ForgotPassword

title "Forgot password"

needs
  Auth

state
  email: ""
  error: ""
  submitting: false
  sent: false

action
  setEmail(value) {
    this.email = value
  }

  async submit() {
    if this.submitting {
      return null
    }

    if not /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(this.email) {
      this.error = "Enter a valid email address."
      return null
    }

    this.error = ""
    this.submitting = true

    try {
      const result = await useApi("/api/auth/forgot-password", {
        method: "POST",
        body: { email: this.email }
      })

      // The server answers the same way whether or not the email is
      // registered, so this page can't reveal who has an account.
      if result.ok {
        this.sent = true
      } else if result.status is 429 {
        this.error = "Too many requests. Wait a minute and try again."
      } else {
        this.error = result.error ?? "Could not send the reset link. Try again."
      }
    } catch (err) {
      this.error = "Network error. Check your connection and try again."
    } finally {
      this.submitting = false
    }
  }

onMount
  {
    if Auth.user {
      window.location.href = "/dashboard"
    }
  }

template
  <div class="flex items-center justify-center px-6 py-16">
    <div class="tx-card tx-glow">
{{#if sent}}
      <div data-testid="reset-sent">
        <h1 class="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
        <p class="text-sm text-muted mb-6">
          If <span class="text-ink">{{ email }}</span> has an account, a link to reset the password is on its way.
        </p>
        <a href="/login" class="text-sm tx-link">Back to login</a>
      </div>
{{#else}}
      <h1 class="text-2xl font-semibold tracking-tight mb-1">Forgot your password?</h1>
      <p class="text-sm text-muted mb-6">We'll email you a link to choose a new one.</p>

{{#if error}}
      <div role="alert" aria-live="polite" class="tx-alert tx-alert-error mb-6">
        <p class="text-sm">{{ error }}</p>
      </div>
{{/if}}

      <label for="email" class="tx-label">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        autofocus
        value="{{ email }}"
        oninput="{{ setEmail(event.target.value) }}"
        onkeydown="{{ event.key is 'Enter' and submit() }}"
        class="tx-input"
      />

      <button
        onclick="{{ submit() }}"
        disabled="{{ submitting }}"
        class="tx-btn tx-btn-primary tx-btn-block"
      >
        {{ submitting ? 'Sending…' : 'Send reset link' }}
      </button>

      <p class="text-sm text-muted text-center mt-6">
        <a href="/login" class="tx-link">Back to login</a>
      </p>
{{/if}}
    </div>
  </div>

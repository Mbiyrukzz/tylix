import { Component, inject, signal } from '@angular/core'
import { NavigationCancel, NavigationEnd, NavigationError, Router as AppRouter, RouterOutlet } from '@angular/router'
import { injectAppError } from '@tylix/angular'
import { ErrorPage } from './pages/error-page'
// @if auth
import { effect, untracked } from '@angular/core'
import { Router, type ActivatedRouteSnapshot } from '@angular/router'
import { decideAccess, injectAuth, useServerContext } from '@tylix/angular'
// @endif
import { Navbar } from './components/navbar'
import { PageLoading } from './components/page-loading'

@Component({
  selector: 'app-root',
  imports: [RouterOutlet, Navbar, ErrorPage, PageLoading],
  template: `
    <div class="tx-shell">
      <app-navbar />
      <main class="flex-1">
        <!-- An error Angular could not handle shows the error page instead
             of a half-rendered view. A new navigation clears it. -->
        @if (appError.error(); as error) {
          <app-error-page [error]="error" (retry)="appError.clear()" />
        } @else {
          @if (!settled()) {
            <app-page-loading />
          }
          <router-outlet />
        }
      </main>
      <footer class="border-t border-line">
        <div class="max-w-6xl mx-auto px-6 py-8 text-sm text-muted">Built with Tylix and Angular.</div>
      </footer>
    </div>
  `,
})
export class App {
  protected readonly appError = injectAppError()

  // The first page can wait on the session (a guarded route); the loader
  // shows until that navigation settles. Server-rendered pages already
  // have their content, so they start settled and hydrate the same.
  protected readonly settled = signal(typeof window === 'undefined' || Boolean(globalThis.__TYLIX_SSR__))
  private readonly navigation = inject(AppRouter).events.subscribe((event) => {
    if (event instanceof NavigationEnd || event instanceof NavigationCancel || event instanceof NavigationError) {
      this.settled.set(true)
      this.navigation.unsubscribe()
    }
  })
  // @if auth
  private readonly router = inject(Router)
  private readonly auth = injectAuth()

  constructor() {
    // On the server the guards have already decided; nothing changes later.
    if (useServerContext()) return

    // The route guards run on navigation. This covers the session changing
    // while a page is open: a logout in another tab, or a login finishing.
    effect(() => {
      if (this.auth.loading()) return
      const status = this.auth.status()
      untracked(() => {
        let route: ActivatedRouteSnapshot = this.router.routerState.snapshot.root
        while (route.firstChild) route = route.firstChild
        const decision = decideAccess(route.data['access'], status, this.router.url, route.queryParamMap.get('next'))
        if (decision && 'login' in decision) {
          this.router.navigate(['/login'], { queryParams: { next: decision.login }, replaceUrl: true })
        } else if (decision) {
          this.router.navigateByUrl(decision.to, { replaceUrl: true })
        }
      })
    })
  }
  // @endif
}

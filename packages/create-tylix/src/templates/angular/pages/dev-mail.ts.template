import { Component, inject } from '@angular/core'
import { MailLogStore } from '../providers/mail.store'

// Development only (app.routes registers this route when
// import.meta.env.DEV is true, and the API behind it doesn't exist in
// production). With MAIL_DRIVER=log, mails are recorded instead of sent, so
// verification and password-reset links can be clicked from here.
@Component({
  selector: 'app-dev-mail',
  providers: [MailLogStore],
  template: `
    <div class="max-w-4xl mx-auto px-6 py-12">
      <div class="flex items-center justify-between mb-2">
        <h1 class="text-3xl font-semibold tracking-tight">Dev mail log</h1>
        <button
          type="button"
          class="text-sm px-3.5 py-1.5 rounded-lg border border-line hover:bg-raised transition-colors"
          (click)="store.reload()"
        >
          Refresh
        </button>
      </div>
      <p class="text-sm text-muted mb-8">The last 50 mails, newest first. Only available in development.</p>

      @if (store.loading() && store.mails().length === 0) {
        <p class="text-sm text-muted">Loading…</p>
      } @else if (store.error()) {
        <p class="text-sm text-coral">{{ store.error() }}</p>
      } @else if (mails().length === 0) {
        <p class="text-sm text-muted">No mails yet.</p>
      } @else {
        <ul class="space-y-3" data-testid="mail-log">
          @for (mail of mails(); track mail.id) {
            <li class="tx-panel p-5">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-semibold">{{ mail.subject }}</p>
                  <p class="text-sm text-muted">To {{ mail.recipient }}</p>
                </div>
                <p class="text-xs text-muted shrink-0">{{ formatDate(mail.created_at) }}</p>
              </div>
              <div class="mt-3 flex flex-col gap-1">
                <!-- Plain href: these may be server URLs (/api/auth/verify-email). -->
                @for (link of linksIn(mail.body); track link.href) {
                  <a [href]="link.href" class="text-sm tx-link break-all">{{ link.label }}</a>
                }
              </div>
            </li>
          }
        </ul>
      }
    </div>
  `,
})
export class DevMail {
  protected readonly store = inject(MailLogStore)
  protected readonly mails = this.store.mails

  // A mail usually holds each link twice (href and text). The links are
  // made relative, so they open on this server whatever APP_URL says.
  protected linksIn(body: string) {
    return Array.from(new Set(String(body).match(/https?:\/\/[^\s"'<>]+/g) ?? [])).map((link) => ({
      label: link,
      href: link.replace(/^https?:\/\/[^/]+/, ''),
    }))
  }

  // A fixed locale and time zone: with SSR, a date must read the same on the
  // server and in the visitor's browser, or hydration fails.
  protected formatDate(value: string) {
    return new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))
  }
}

import { Component, input, signal } from '@angular/core'
import { FormsModule } from '@angular/forms'
import { RouterLink } from '@angular/router'
import { injectAuth, injectHydrated } from '@tylix/angular'
import { firstError } from '@tylix/shared/validation'
import { validateResetPassword } from '../../validators/AuthValidator'

const inputClass =
  'tx-input'

// Opened from the link in the reset email:
//   /reset-password?token=...&email=...
@Component({
  selector: 'app-reset-password',
  imports: [FormsModule, RouterLink],
  template: `
    <div class="flex items-center justify-center px-6 py-16">
      <div class="tx-card tx-glow">
        @if (!token() || !email()) {
          <h1 class="text-2xl font-semibold tracking-tight mb-2">This link is incomplete</h1>
          <p class="text-sm text-muted mb-6">Open the link from the email again, or ask for a new one.</p>
          <a routerLink="/forgot-password" class="text-sm tx-link">Request a new link</a>
        } @else if (done()) {
          <div data-testid="reset-done">
            <h1 class="text-2xl font-semibold tracking-tight mb-2">Password updated</h1>
            <p class="text-sm text-muted mb-6">For your security, every device was logged out. Log in with your new password.</p>
            <a
              routerLink="/login"
              class="tx-btn tx-btn-primary tx-btn-block"
            >
              Go to login
            </a>
          </div>
        } @else {
          <form (ngSubmit)="submit()">
            <h1 class="text-2xl font-semibold tracking-tight mb-1">Choose a new password</h1>
            <p class="text-sm text-muted mb-6">For {{ email() }}</p>

            @if (error()) {
              <div role="alert" class="tx-alert tx-alert-error mb-6">
                <p class="text-sm">{{ error() }}</p>
              </div>
            }

            <label for="password" class="tx-label">New password</label>
            <input id="password" name="password" type="password" autocomplete="new-password" autofocus [(ngModel)]="password" [class]="inputClass" />

            <label for="confirmPassword" class="tx-label">Confirm new password</label>
            <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" [(ngModel)]="confirmPassword" [class]="inputClass" />

            <button
              type="submit"
              [disabled]="submitting() || !hydrated()"
              class="tx-btn tx-btn-primary tx-btn-block"
            >
              {{ submitting() ? 'Saving…' : 'Update password' }}
            </button>
          </form>
        }
      </div>
    </div>
  `,
})
export class ResetPassword {
  // Submitting before hydration would reload the page; see injectHydrated.
  protected readonly hydrated = injectHydrated()

  // Query parameters, bound by withComponentInputBinding.
  readonly token = input<string>()
  readonly email = input<string>()

  protected readonly inputClass = inputClass
  private readonly auth = injectAuth()

  protected readonly password = signal('')
  protected readonly confirmPassword = signal('')
  protected readonly error = signal('')
  protected readonly submitting = signal(false)
  protected readonly done = signal(false)

  protected async submit() {
    if (this.submitting()) return
    const problem = firstError(
      validateResetPassword({ email: this.email() ?? '', token: this.token() ?? '', password: this.password() }),
    )
    if (problem) {
      this.error.set(problem)
      return
    }
    if (this.password() !== this.confirmPassword()) {
      this.error.set("Passwords don't match.")
      return
    }
    this.error.set('')
    this.submitting.set(true)
    const result = await this.auth.resetPassword({
      email: this.email() ?? '',
      token: this.token() ?? '',
      password: this.password(),
    })
    this.submitting.set(false)

    if (result.ok) this.done.set(true)
    else if (result.status === 0) this.error.set('Network error. Check your connection and try again.')
    else this.error.set(result.error ?? 'Could not reset the password. Try again.')
  }
}

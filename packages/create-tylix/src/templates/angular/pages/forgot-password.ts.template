import { Component, signal } from '@angular/core'
import { FormsModule } from '@angular/forms'
import { RouterLink } from '@angular/router'
import { injectAuth, injectHydrated } from '@tylix/angular'
import { firstError } from '@tylix/shared/validation'
import { validateForgotPassword } from '../../validators/AuthValidator'

@Component({
  selector: 'app-forgot-password',
  imports: [FormsModule, RouterLink],
  template: `
    <div class="flex items-center justify-center px-6 py-16">
      <div class="tx-card tx-glow">
        @if (sent()) {
          <div data-testid="reset-sent">
            <h1 class="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
            <p class="text-sm text-muted mb-6">
              If <span class="text-ink">{{ email() }}</span> has an account, a link to reset the password is on its way.
            </p>
            @if (isDev) {
              <p class="text-xs text-muted mb-6">
                No mail server yet? <a routerLink="/dev/mail" class="tx-link">Open the dev mail log</a>
              </p>
            }
            <a routerLink="/login" class="text-sm tx-link">Back to login</a>
          </div>
        } @else {
          <form (ngSubmit)="submit()">
            <h1 class="text-2xl font-semibold tracking-tight mb-1">Forgot your password?</h1>
            <p class="text-sm text-muted mb-6">We'll email you a link to choose a new one.</p>

            @if (error()) {
              <div role="alert" class="tx-alert tx-alert-error mb-6">
                <p class="text-sm">{{ error() }}</p>
              </div>
            }

            <label for="email" class="tx-label">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              autofocus
              [(ngModel)]="email"
              class="tx-input"
            />
            <button
              type="submit"
              [disabled]="submitting() || !hydrated()"
              class="tx-btn tx-btn-primary tx-btn-block"
            >
              {{ submitting() ? 'Sending…' : 'Send reset link' }}
            </button>
            <p class="text-sm text-muted text-center mt-6">
              <a routerLink="/login" class="tx-link">Back to login</a>
            </p>
          </form>
        }
      </div>
    </div>
  `,
})
export class ForgotPassword {
  // Submitting before hydration would reload the page; see injectHydrated.
  protected readonly hydrated = injectHydrated()

  protected readonly isDev = import.meta.env.DEV
  private readonly auth = injectAuth()

  protected readonly email = signal('')
  protected readonly error = signal('')
  protected readonly submitting = signal(false)
  protected readonly sent = signal(false)

  protected async submit() {
    if (this.submitting()) return
    const problem = firstError(validateForgotPassword({ email: this.email() }))
    if (problem) {
      this.error.set(problem)
      return
    }
    this.error.set('')
    this.submitting.set(true)
    const result = await this.auth.forgotPassword(this.email())
    this.submitting.set(false)

    // The server answers the same way whether or not the email is
    // registered, so this page can't be used to find out who has an account.
    if (result.ok) this.sent.set(true)
    else if (result.status === 429) this.error.set('Too many requests. Wait a minute and try again.')
    else if (result.status === 0) this.error.set('Network error. Check your connection and try again.')
    else this.error.set(result.error ?? 'Could not send the reset link. Try again.')
  }
}

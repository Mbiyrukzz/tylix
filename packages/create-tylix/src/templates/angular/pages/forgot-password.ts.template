import { Component, signal } from '@angular/core'
import { FormsModule } from '@angular/forms'
import { RouterLink } from '@angular/router'
import { injectAuth, injectHydrated } from '@tylix/angular'

@Component({
  selector: 'app-forgot-password',
  imports: [FormsModule, RouterLink],
  template: `
    <div class="flex items-center justify-center px-6 py-16">
      <div class="w-full max-w-sm rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-8">
        @if (sent()) {
          <div data-testid="reset-sent">
            <h1 class="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
            <p class="text-sm text-zinc-500 mb-6">
              If <span class="text-zinc-900 dark:text-zinc-200">{{ email() }}</span> has an account, a link to reset the password is on its way.
            </p>
            @if (isDev) {
              <p class="text-xs text-zinc-500 mb-6">
                No mail server yet? <a routerLink="/dev/mail" class="text-emerald-600 dark:text-emerald-400 hover:underline">Open the dev mail log</a>
              </p>
            }
            <a routerLink="/login" class="text-sm text-emerald-600 dark:text-emerald-400 hover:underline">Back to login</a>
          </div>
        } @else {
          <form (ngSubmit)="submit()">
            <h1 class="text-2xl font-semibold tracking-tight mb-1">Forgot your password?</h1>
            <p class="text-sm text-zinc-500 mb-6">We'll email you a link to choose a new one.</p>

            @if (error()) {
              <div role="alert" class="rounded-md border border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
                <p class="text-rose-700 dark:text-rose-400 text-sm">{{ error() }}</p>
              </div>
            }

            <label for="email" class="block text-zinc-500 text-xs font-medium mb-1.5">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              autofocus
              [(ngModel)]="email"
              class="w-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 rounded-md px-3.5 py-2.5 mb-4 text-sm outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
            />
            <button
              type="submit"
              [disabled]="submitting() || !hydrated()"
              class="w-full bg-emerald-500 text-white dark:text-zinc-950 rounded-md py-2.5 text-sm font-semibold hover:bg-emerald-400 transition-colors disabled:opacity-50"
            >
              {{ submitting() ? 'Sending…' : 'Send reset link' }}
            </button>
            <p class="text-sm text-zinc-500 text-center mt-6">
              <a routerLink="/login" class="text-emerald-600 dark:text-emerald-400 hover:underline">Back to login</a>
            </p>
          </form>
        }
      </div>
    </div>
  `,
})
export class ForgotPassword {
  // Submitting before hydration would reload the page; see injectHydrated.
  protected readonly hydrated = injectHydrated()

  protected readonly isDev = import.meta.env.DEV
  private readonly auth = injectAuth()

  protected readonly email = signal('')
  protected readonly error = signal('')
  protected readonly submitting = signal(false)
  protected readonly sent = signal(false)

  protected async submit() {
    if (this.submitting()) return
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(this.email())) {
      this.error.set('Enter a valid email address.')
      return
    }
    this.error.set('')
    this.submitting.set(true)
    const result = await this.auth.forgotPassword(this.email())
    this.submitting.set(false)

    // The server answers the same way whether or not the email is
    // registered, so this page can't be used to find out who has an account.
    if (result.ok) this.sent.set(true)
    else if (result.status === 429) this.error.set('Too many requests. Wait a minute and try again.')
    else if (result.status === 0) this.error.set('Network error. Check your connection and try again.')
    else this.error.set(result.error ?? 'Could not send the reset link. Try again.')
  }
}

import { Component, inject } from '@angular/core'
import { RouterLink } from '@angular/router'
import { PostStore } from '../providers/posts.store'

// One post, from PostStore (providers/), which follows the route's :id.
@Component({
  selector: 'app-post-detail',
  imports: [RouterLink],
  providers: [PostStore],
  template: `
    <article class="max-w-3xl mx-auto px-6 py-12">
      <a routerLink="/posts" class="text-sm text-emerald-600 dark:text-emerald-400 hover:underline">← All posts</a>
      @if (store.loading() && !store.post()) {
        <p class="text-sm text-zinc-500 mt-8">Loading…</p>
      } @else if (store.notFound()) {
        <div class="mt-8">
          <h1 class="text-2xl font-semibold">Post not found</h1>
          <p class="text-sm text-zinc-500 mt-2">It may have been deleted.</p>
        </div>
      } @else if (store.error()) {
        <p class="text-sm text-rose-600 mt-8">{{ store.error() }}</p>
      } @else if (store.post(); as data) {
        <h1 class="text-4xl font-semibold tracking-tight mt-6 mb-3" data-testid="post-title">{{ data.title }}</h1>
        <p class="text-sm text-zinc-500 mb-8">{{ data.author }} · {{ formatDate(data.created_at) }}</p>
        <div class="text-zinc-700 dark:text-zinc-300 leading-relaxed whitespace-pre-line">{{ data.body }}</div>
      }
    </article>
  `,
})
export class PostDetail {
  protected readonly store = inject(PostStore)

  // A fixed locale and time zone: with SSR, a date must read the same on the
  // server and in the visitor's browser, or hydration fails.
  protected formatDate(value: string) {
    return new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(value))
  }
}

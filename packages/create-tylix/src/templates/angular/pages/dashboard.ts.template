import { Component } from '@angular/core'
import { IconMail, IconServer, IconShieldCheck } from 'tylix-icons/angular'
import { injectAuth, injectHydrated } from '@tylix/angular'
// @if posts
import { inject, signal } from '@angular/core'
import { FormsModule } from '@angular/forms'
import { MyPostsStore } from '../providers/posts.store'
import { PageLoading } from '../components/page-loading'
// @endif

const cardClass = 'tx-panel p-5'

@Component({
  selector: 'app-dashboard',
  // @if posts
  imports: [FormsModule, IconMail, IconServer, IconShieldCheck, PageLoading],
  providers: [MyPostsStore],
  // @endif
  // @if !posts
  imports: [IconMail, IconServer, IconShieldCheck],
  // @endif
  template: `
    <div class="max-w-6xl mx-auto px-6 py-12">
      <p class="text-sm text-muted mb-1">Signed in as</p>
      <h1 class="text-3xl font-semibold tracking-tight mb-8" data-testid="dashboard-name">{{ auth.user()?.name }}</h1>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
        <div [class]="cardClass">
          <icon-mail class="w-4 h-4 text-mint mb-3" />
          <p class="text-xs text-muted mb-1">Email</p>
          <p class="text-sm font-semibold truncate">{{ auth.user()?.email }}</p>
        </div>
        <div [class]="cardClass">
          <icon-shield-check class="w-4 h-4 text-mint mb-3" />
          <p class="text-xs text-muted mb-1">Session</p>
          <p class="text-sm font-semibold">httpOnly cookie, refreshed automatically</p>
        </div>
        <div [class]="cardClass">
          <icon-server class="w-4 h-4 text-mint mb-3" />
          <p class="text-xs text-muted mb-1">Protected API</p>
          <p class="text-sm font-semibold">GET /api/me</p>
        </div>
      </div>
      <!-- @if posts -->

      <section>
        <h2 class="text-xl font-semibold tracking-tight mb-4">Your posts</h2>

        <form [class]="cardClass + ' mb-6'" (ngSubmit)="create()">
          @if (error()) {
            <p role="alert" class="text-coral text-sm mb-3">{{ error() }}</p>
          }
          <input
            name="title"
            placeholder="Title"
            [(ngModel)]="title"
            class="tx-input mb-3"
          />
          <textarea
            name="body"
            placeholder="Write something…"
            rows="3"
            [(ngModel)]="body"
            class="tx-input mb-3"
          ></textarea>
          @if (coverImage()) {
            <div class="relative mb-3">
              <img [src]="coverImage()" alt="Cover preview" class="w-full aspect-video object-cover rounded-lg border border-line" />
              <button
                type="button"
                class="absolute top-2 right-2 text-xs font-medium px-2.5 py-1 rounded-lg bg-panel/90 border border-line"
                (click)="coverImage.set('')"
              >
                Remove
              </button>
            </div>
          } @else {
            <label class="block mb-3">
              <span class="text-xs text-muted">Cover image (optional, PNG, JPEG, WebP or GIF, up to 2 MB)</span>
              <input
                type="file"
                name="cover_image"
                accept="image/png,image/jpeg,image/webp,image/gif"
                [disabled]="uploading() || !hydrated()"
                class="block w-full text-sm text-muted mt-1"
                (change)="pickImage($event)"
              />
            </label>
          }
          @if (uploading()) {
            <p class="text-xs text-muted mb-3">Uploading…</p>
          }
          <button
            type="submit"
            [disabled]="saving() || uploading() || !hydrated()"
            class="px-4 py-2 rounded-lg bg-brand text-white text-sm font-semibold hover:bg-brand-hover transition-colors disabled:opacity-50"
          >
            {{ saving() ? 'Saving…' : 'Publish post' }}
          </button>
        </form>

        @if (posts.loading() && posts.posts().length === 0) {
          <app-page-loading compact label="Loading posts" />
        } @else if (posts.error()) {
          <p class="text-sm text-coral">{{ posts.error() }}</p>
        } @else if (posts.posts().length) {
          <ul class="space-y-3" data-testid="posts">
            @for (post of posts.posts(); track post.id) {
              <li [class]="cardClass + ' flex items-start justify-between gap-4'">
                @if (post.cover_image) {
                  <img [src]="post.cover_image" alt="" class="w-20 h-14 object-cover rounded-lg border border-line shrink-0" />
                }
                <div class="flex-1 min-w-0">
                  <p class="font-semibold">{{ post.title }}</p>
                  <p class="text-sm text-muted mt-1 whitespace-pre-line">{{ post.body }}</p>
                </div>
                <button type="button" class="text-sm text-muted hover:text-coral transition-colors" (click)="remove(post.id)">
                  Delete
                </button>
              </li>
            }
          </ul>
        } @else {
          <p class="text-sm text-muted">No posts yet. Publish your first one above.</p>
        }
      </section>
      <!-- @endif -->
    </div>
  `,
})
export class Dashboard {
  // Submitting before hydration would reload the page; see injectHydrated.
  protected readonly hydrated = injectHydrated()

  protected readonly auth = injectAuth()
  protected readonly cardClass = cardClass
  // @if posts

  // Your posts, from MyPostsStore (providers/): the list plus create and
  // remove, which reload it. Only the logged-in user's posts.
  protected readonly posts = inject(MyPostsStore)

  protected readonly title = signal('')
  protected readonly body = signal('')
  protected readonly coverImage = signal('')
  protected readonly error = signal('')
  protected readonly saving = signal(false)
  protected readonly uploading = signal(false)

  // Uploads the picked image straight away; the post sends its URL.
  protected async pickImage(event: Event) {
    const input = event.target as HTMLInputElement
    const file = input.files?.[0]
    input.value = ''
    if (!file) return
    this.uploading.set(true)
    this.error.set('')
    const uploaded = await this.posts.uploadImage(file)
    this.uploading.set(false)
    if (uploaded.error) {
      this.error.set(uploaded.error)
      return
    }
    this.coverImage.set(uploaded.url ?? '')
  }

  protected async create() {
    if (this.saving() || this.uploading()) return
    if (!this.title().trim() || !this.body().trim()) {
      this.error.set('Give the post a title and some text.')
      return
    }
    this.saving.set(true)
    const problem = await this.posts.create({
      title: this.title().trim(),
      body: this.body().trim(),
      cover_image: this.coverImage() || null,
    })
    this.saving.set(false)
    if (problem) {
      this.error.set(problem)
      return
    }
    this.error.set('')
    this.title.set('')
    this.body.set('')
    this.coverImage.set('')
  }

  protected async remove(id: number) {
    const problem = await this.posts.remove(id)
    if (problem) this.error.set(problem)
  }
  // @endif
}

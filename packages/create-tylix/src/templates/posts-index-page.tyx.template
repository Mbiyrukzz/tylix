page PostsIndex

title "Posts"

state
  posts: []
  query: ""
  loading: true
  error: ""

computed
  filtered() {
    const q = this.query.trim().toLowerCase()
    if q is "" {
      return this.posts
    }
    return this.posts.filter(p => p.title.toLowerCase().includes(q) or p.excerpt.toLowerCase().includes(q))
  }

action
  formatDate(value) {
    if not value {
      return ""
    }
    return new Date(value).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })
  }

onMount
  async {
    const result = await useApi("/api/public/posts")
    if result.ok {
      this.posts = result.data
    } else {
      this.error = result.error ?? "Couldn't load posts."
    }
    this.loading = false
  }

template
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="max-w-2xl mb-10">
      <p class="text-xs font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-2">Blog</p>
      <h1 class="text-4xl font-semibold tracking-tight mb-3">Posts</h1>
      <p class="text-zinc-500 dark:text-zinc-400">Everything published on this site. No account needed to read.</p>
    </div>

    <input
      type="search"
      value="{{ query }}"
      oninput="{{ query = $event.target.value }}"
      placeholder="Search posts…"
      aria-label="Search posts"
      class="w-full max-w-md mb-10 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-sm px-3.5 py-2.5 outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
    />

{{#if loading}}
    <p class="text-sm text-zinc-500">Loading posts…</p>
{{#else if error}}
    <div role="alert" class="rounded-md border border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3">
      <p class="text-sm text-rose-700 dark:text-rose-400">{{ error }}</p>
    </div>
{{#else}}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
{{#each p in filtered}}
      <a href="{{ `/posts/${p.id}` }}" class="group flex flex-col overflow-hidden rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
{{#if p.cover_image}}
        <img src="{{ p.cover_image }}" alt="" class="w-full aspect-video object-cover border-b border-zinc-200 dark:border-zinc-800" />
{{/if}}
        <div class="flex flex-col p-6">
          <p class="text-xs text-zinc-500 mb-3">{{ formatDate(p.created_at) }} · {{ p.author }}</p>
          <h2 class="font-semibold tracking-tight mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">{{ p.title }}</h2>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed line-clamp-3">{{ p.excerpt }}</p>
        </div>
      </a>
{{#else}}
      <p class="col-span-full text-sm text-zinc-500">
        {{ query is "" ? "No posts yet." : "No posts match your search." }}
      </p>
{{/each}}
    </div>
{{/if}}
  </div>
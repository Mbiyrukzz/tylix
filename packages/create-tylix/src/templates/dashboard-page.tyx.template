page Dashboard

import { IconHome, IconPlus, IconDocument, IconFolder, IconArrowLeft, IconX, IconUser, IconDatabase } from "tylix-icons"

state
  user: null
  checkedAuth: false
  features: []
  posts: []
  postsLoading: true
  showCreateModal: false
  newPostTitle: ""
  newPostBody: ""
  creating: false
  createError: ""

onMount
  async {
    const me = await useApi("/api/me")

    if not me.ok {
      window.location.href = "/login"
      return null
    }

    this.user = me.data
    this.checkedAuth = true

    const featuresResult = await useApi("/api/_tylix/features")
    this.features = featuresResult.data.data.filter(f => f.table is not "posts")

    const postsResult = await getApi("posts")
    if postsResult.ok {
      this.posts = postsResult.data
    }
    this.postsLoading = false
  }

action
  async logout() {
    await useApi("/api/auth/logout", { method: "POST" })
    window.location.href = "/"
  }

  openCreateModal() {
    this.showCreateModal = true
    this.createError = ""
  }

  closeCreateModal() {
    this.showCreateModal = false
    this.newPostTitle = ""
    this.newPostBody = ""
    this.createError = ""
  }

  async createPost() {
    if this.creating {
      return null
    }

    if this.newPostTitle.trim() is "" {
      this.createError = "Give your post a title."
      return null
    }

    this.creating = true
    this.createError = ""

    const result = await postApi("posts", { title: this.newPostTitle, body: this.newPostBody })

    if result.ok {
      this.posts = [result.data].concat(this.posts)
      this.creating = false
      this.closeCreateModal()
    } else if result.status is 401 {
      window.location.href = "/login"
    } else {
      this.createError = result.error or "Couldn't create that post. Check the form and try again."
      this.creating = false
    }
  }

template
{{#if checkedAuth}}
  <div class="min-h-[calc(100vh-4rem)] grid grid-cols-1 lg:grid-cols-[240px_1fr]">

    <aside class="hidden lg:flex flex-col border-r border-slate-800 bg-slate-950 p-4">
      <a href="/dashboard" aria-current="page" class="flex items-center gap-2 px-3 py-2 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-slate-100 text-sm font-medium mb-1">
        <IconHome class="w-4 h-4" />
        Overview
      </a>
      <p class="px-3 pt-4 pb-2 text-slate-600 text-xs font-medium uppercase tracking-wide">Data</p>
{{#if features.length is 0}}
      <p class="px-3 py-2 text-slate-600 text-sm italic">
        No features yet
      </p>
{{/if}}
{{#each f in features}}
      <a href="{{ '/' + f.name.toLowerCase() + 'dashboard' }}" class="flex items-center justify-between px-3 py-2 rounded-lg text-slate-400 text-sm hover:bg-slate-900 hover:text-slate-100 transition">
        {{ f.name }}
      </a>
{{/each}}
    </aside>

    <div class="px-6 lg:px-10 py-10">
      <div class="flex items-center justify-between mb-10">
        <div>
          <h1 class="text-2xl font-semibold text-slate-100">Dashboard</h1>
{{#if user}}
          <p class="text-slate-500 text-sm mt-1">Welcome back, {{ user.name }}.</p>
{{/if}}
        </div>
        <button onclick="{{ logout() }}" class="text-sm text-slate-400 hover:text-slate-100 border border-slate-700 rounded-lg px-4 py-2 hover:bg-slate-900 hover:border-slate-600 transition">
          Log out
        </button>
      </div>

      <div class="flex items-center justify-between mb-5">
        <h2 class="text-slate-100 font-medium">Posts</h2>
        <button onclick="{{ openCreateModal() }}" class="inline-flex items-center gap-1.5 text-sm bg-emerald-500 text-slate-950 font-semibold rounded-lg px-4 py-2 hover:bg-emerald-400 transition">
          <IconPlus class="w-4 h-4" /> New Post
        </button>
      </div>

{{#if postsLoading}}
      <p class="text-slate-500 text-sm mb-8">Loading posts…</p>
{{/if}}

{{#if not postsLoading}}
{{#if posts.length is 0}}
      <div class="rounded-xl border border-slate-800 bg-slate-900 p-8 text-center mb-8">
        <div class="w-12 h-12 rounded-lg bg-emerald-500/10 flex items-center justify-center mx-auto mb-4">
          <IconDocument class="w-6 h-6 text-emerald-400" />
        </div>
        <h3 class="text-slate-100 font-medium mb-2">No posts yet</h3>
        <p class="text-slate-500 text-sm max-w-sm mx-auto">
          Click "New Post" above to create your first one.
        </p>
      </div>
{{/if}}

{{#if posts.length is not 0}}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-8">
{{#each p in posts}}
        <a href="{{ '/post/post-detail?id=' + p.id }}" class="block rounded-xl border border-slate-800 bg-slate-900 p-6 hover:border-slate-700 transition">
          <h3 class="text-slate-100 font-medium mb-2">{{ p.title }}</h3>
          <p class="text-slate-500 text-sm line-clamp-2">{{ p.body }}</p>
        </a>
{{/each}}
      </div>
{{/if}}
{{/if}}

{{#if features.length is not 0}}
      <p class="px-1 pb-3 text-slate-600 text-xs font-medium uppercase tracking-wide">Scaffolded Features</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-8">
{{#each f in features}}
        <a href="{{ '/' + f.name.toLowerCase() + 'dashboard' }}" class="block rounded-xl border border-slate-800 bg-slate-900 p-6 hover:border-slate-700 transition">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center mb-4">
            <IconFolder class="w-5 h-5 text-emerald-400" />
          </div>
          <h3 class="text-slate-100 font-medium mb-1">{{ f.name }}</h3>
          <p class="text-slate-500 text-sm">Manage {{ f.table }}</p>
        </a>
{{/each}}
      </div>
{{/if}}

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="rounded-xl border border-slate-800 bg-slate-900 p-5">
          <div class="flex items-center gap-1.5 mb-1">
            <IconUser class="w-3.5 h-3.5 text-slate-500" />
            <p class="text-slate-500 text-xs">Signed in as</p>
          </div>
{{#if user}}
          <p class="text-slate-100 text-sm font-medium">{{ user.email }}</p>
{{/if}}
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900 p-5">
          <div class="flex items-center gap-1.5 mb-1">
            <IconDatabase class="w-3.5 h-3.5 text-slate-500" />
            <p class="text-slate-500 text-xs">Database</p>
          </div>
          <p class="text-emerald-400 text-sm font-medium">Connected</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900 p-5">
          <div class="flex items-center gap-1.5 mb-1">
            <IconDocument class="w-3.5 h-3.5 text-slate-500" />
            <p class="text-slate-500 text-xs">Posts</p>
          </div>
          <p class="text-slate-100 text-sm font-medium">{{ posts.length }} created</p>
        </div>
      </div>

      <a href="/" class="inline-flex items-center gap-1.5 text-emerald-400 text-sm hover:underline mt-8">
        <IconArrowLeft class="w-4 h-4" /> Back to home
      </a>
    </div>
  </div>
{{/if}}

{{#if showCreateModal}}
  <div role="dialog" aria-modal="true" aria-labelledby="create-post-title" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 px-6">
    <div class="w-full max-w-md rounded-xl border border-slate-700 bg-slate-900 p-6">
      <div class="flex items-center justify-between mb-5">
        <h3 id="create-post-title" class="text-slate-100 font-medium">New Post</h3>
        <button onclick="{{ closeCreateModal() }}" aria-label="Close" class="text-slate-500 hover:text-slate-200">
          <IconX class="w-4 h-4" />
        </button>
      </div>

      <label for="new-post-title" class="block text-slate-400 text-xs mb-1.5">Title</label>
      <input
        id="new-post-title"
        type="text"
        autofocus
        value="{{ newPostTitle }}"
        oninput="{{ newPostTitle = $event.target.value }}"
        class="w-full mb-4 rounded-lg border border-slate-700 bg-slate-950 text-slate-100 text-sm px-3 py-2.5 focus:outline-none focus:border-emerald-500"
        placeholder="e.g. Launch week recap"
      />

      <label for="new-post-body" class="block text-slate-400 text-xs mb-1.5">Body</label>
      <textarea
        id="new-post-body"
        rows="4"
        value="{{ newPostBody }}"
        oninput="{{ newPostBody = $event.target.value }}"
        class="w-full mb-4 rounded-lg border border-slate-700 bg-slate-950 text-slate-100 text-sm px-3 py-2.5 focus:outline-none focus:border-emerald-500 resize-none"
        placeholder="Write something…"
      ></textarea>

{{#if createError}}
      <p role="alert" class="text-rose-400 text-sm mb-4">{{ createError }}</p>
{{/if}}

      <div class="flex items-center justify-end gap-3">
        <button onclick="{{ closeCreateModal() }}" class="text-sm text-slate-400 hover:text-slate-100 px-3 py-2">
          Cancel
        </button>
{{#if creating}}
        <button disabled class="text-sm bg-emerald-500 text-slate-950 font-semibold rounded-lg px-4 py-2 opacity-50 transition">
          Creating…
        </button>
{{/if}}
{{#if not creating}}
        <button onclick="{{ createPost() }}" class="inline-flex items-center gap-1.5 text-sm bg-emerald-500 text-slate-950 font-semibold rounded-lg px-4 py-2 hover:bg-emerald-400 transition">
          <IconPlus class="w-4 h-4" /> Create Post
        </button>
{{/if}}
      </div>
    </div>
  </div>
{{/if}}
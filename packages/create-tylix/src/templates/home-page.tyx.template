page Home

state
  loggedIn: false

onMount
  async {
    const me = await useApi("/api/me")
    if me.ok {
      this.loggedIn = true
    }
  }

template
  <div>
    <Hero loggedIn="{{ loggedIn }}" />
    <InstallSnippet />
    <Stats />
    <FeatureGrid />
    <Testimonials />
    <CTASection loggedIn="{{ loggedIn }}" />
    <SiteFooter />
  </div>
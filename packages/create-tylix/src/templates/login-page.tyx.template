page Login

import { IconCheck } from "tylix-icons"
import OAuthButtons from "./components/OAuthButtons"

title "Log in"

needs
  Auth

state
  email: ""
  password: ""
  remember: false
  error: ""
  submitting: false
  perks: [
    "Manage your posts from one dashboard",
    "Upload cover images for every post",
    "Your session refreshes automatically"
  ]

action
  setField(field, value) {
    this[field] = value
  }

  toggleRemember() {
    this.remember = not this.remember
  }

  validate() {
    if not /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(this.email) {
      return "Enter a valid email address."
    }
    if this.password.length is 0 {
      return "Enter your password."
    }
    return ""
  }

  messageFor(result) {
    switch result.status {
      case 401, 403 {
        return "Invalid email or password."
      }
      case 422 {
        const errors = result.data?.errors
        if errors {
          const firstField = Object.keys(errors)[0]
          return errors[firstField][0]
        }
        return "Check your details and try again."
      }
      case 429 {
        return "Too many attempts. Wait a minute and try again."
      }
      default {
        return result.error ?? "Could not log in. Try again."
      }
    }
  }

  async submit() {
    if this.submitting {
      return null
    }

    this.error = this.validate()
    if this.error {
      return null
    }

    this.submitting = true
    let succeeded = false

    try {
      const result = await Auth.login(this.email, this.password)

      if result.ok {
        succeeded = true
        window.location.href = "/dashboard"
      } else {
        this.error = this.messageFor(result)
      }
    } catch (err) {
      this.error = "Network error. Check your connection and try again."
    } finally {
      if not succeeded {
        this.submitting = false
      }
    }
  }

onMount
  {
    if Auth.user {
      window.location.href = "/dashboard"
    }
  }

template
  <div class="flex items-center justify-center px-6 py-16">
    <div class="tx-auth tx-glow">

      <div class="tx-auth-aside">
        <p class="tx-eyebrow mb-5">Signed-in session</p>
        <h2 class="text-2xl font-semibold tracking-tight mb-3">Welcome back</h2>
        <p class="text-sm text-muted mb-8 leading-relaxed">Log in to pick up where you left off.</p>
        <ul class="space-y-3">
{{#each perk in perks}}
          <li class="flex items-start gap-2.5 text-sm text-soft">
            <IconCheck class="w-4 h-4 mt-0.5 text-mint shrink-0" />
            {{ perk }}
          </li>
{{/each}}
        </ul>
      </div>

      <div class="tx-auth-form">
        <div class="w-full max-w-sm">
          <h1 class="text-2xl font-semibold tracking-tight mb-1">Log in</h1>
          <p class="text-sm text-muted mb-8">Continue to your dashboard.</p>

{{#if error}}
          <div role="alert" aria-live="polite" class="tx-alert tx-alert-error mb-6">
            <p class="text-sm">{{ error }}</p>
          </div>
{{/if}}

          <OAuthButtons returnTo="{{ '/dashboard' }}" />

          <label for="email" class="tx-label">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            autofocus
            placeholder="you@example.com"
            value="{{ email }}"
            oninput="{{ setField('email', event.target.value) }}"
            onkeydown="{{ event.key is 'Enter' and submit() }}"
            class="tx-input"
          />

          <label for="password" class="tx-label">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            placeholder="••••••••"
            value="{{ password }}"
            oninput="{{ setField('password', event.target.value) }}"
            onkeydown="{{ event.key is 'Enter' and submit() }}"
            class="tx-input"
          />

          <div class="flex items-center justify-between mb-6">
            <label class="flex items-center gap-2 text-sm text-muted">
              <input
                type="checkbox"
                checked="{{ remember }}"
                onclick="{{ toggleRemember() }}"
                class="rounded border-line-strong bg-canvas text-mint focus:ring-aqua"
              />
              Remember me
            </label>
            <a href="/forgot-password" class="text-sm tx-link">Forgot password?</a>
          </div>

          <button
            onclick="{{ submit() }}"
            disabled="{{ submitting }}"
            class="tx-btn tx-btn-primary tx-btn-block"
          >
            {{ submitting ? 'Logging in…' : 'Log in' }}
          </button>

          <p class="text-sm text-muted text-center mt-6">
            Need an account? <a href="/register" class="tx-link">Sign up</a>
          </p>
        </div>
      </div>
    </div>
  </div>
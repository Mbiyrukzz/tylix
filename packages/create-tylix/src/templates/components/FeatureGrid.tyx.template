component FeatureGrid

state
  features: [
    { name: "No virtual DOM", body: "Templates compile to targeted effects. State changes update only the text, attribute or list that depends on them." },
    { name: "One ORM, four drivers", body: "SQLite, PostgreSQL, MySQL or MongoDB. Pick one in the wizard and change it later in .env." },
    { name: "Generator-first CLI", body: "tylix make:feature scaffolds a model, migration and full CRUD API in one command." },
    { name: "Auth included", body: "Register, login, refresh tokens, email verification and password reset, scaffolded when you opt in." },
    { name: "Instant hot reload", body: "Edit a page or component and see it update in the browser without a manual refresh." },
    { name: "Readable syntax", body: "Word operators like and, or and not, plus plain if / each blocks in templates." }
  ]

template
  <section class="max-w-6xl mx-auto px-6 py-20">
    <div class="max-w-2xl mb-12">
      <h2 class="text-3xl font-semibold tracking-tight mb-3">Everything wired up on day one</h2>
      <p class="text-zinc-500 dark:text-zinc-400">Pick your stack in the wizard and get a working app, not a blank folder.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-px rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-200 dark:bg-zinc-800 overflow-hidden">
{{#each f, i in features}}
      <div class="bg-white dark:bg-zinc-950 p-7">
        <p class="text-xs font-mono text-emerald-500 mb-4">{{ '0' + (i + 1) }}</p>
        <h3 class="font-semibold tracking-tight mb-2">{{ f.name }}</h3>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">{{ f.body }}</p>
      </div>
{{/each}}
    </div>
  </section>
component SiteNavbar

import { IconSun, IconMoon, IconMenu, IconX } from "tylix-icons"

props
  showPosts: boolean

uses
  Auth
  Theme

state
  mobileMenuOpen: false

computed
  links() {
    const items = []
    if this.showPosts {
      items.push({ label: "Posts", href: "/posts" })
    }
    if Auth.user {
      items.push({ label: "Dashboard", href: "/dashboard" })
    }
    items.push({ label: "Docs", href: "https://tylix.dev/docs" })
    items.push({ label: "GitHub", href: "https://github.com/tylixjs" })
    return items
  }

action
  toggleMobileMenu() {
    this.mobileMenuOpen = not this.mobileMenuOpen
  }

  closeMobileMenu() {
    this.mobileMenuOpen = false
  }

  isActive(href) {
    const path = window.location.pathname
    return path is href or (href is not "/" and path.startsWith(href + "/"))
  }

  linkClass(href) {
    const base = "text-sm px-3.5 py-1.5 rounded-lg transition-colors "
    if this.isActive(href) {
      return base + "text-ink bg-raised font-medium tx-nav-link-active"
    }
    return base + "text-soft hover:text-ink hover:bg-raised "
  }

template
  <header class="tx-nav">
    <nav class="max-w-6xl mx-auto h-16 px-6 flex items-center justify-between">
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/logo-mark.svg" alt="" class="h-[22px] w-auto" />
          <span class="text-[17px] font-bold tracking-tight">Tylix</span>
        </a>

        <div class="hidden md:flex items-center gap-1">
{{#each link in links}}
          <a href="{{ link.href }}" class="{{ linkClass(link.href) }}">{{ link.label }}</a>
{{/each}}
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          onclick="{{ Theme.toggle() }}"
          aria-label="Toggle color theme"
          class="tx-icon-btn"
        >
{{#if Theme.mode is "dark"}}
          <IconSun class="w-[18px] h-[18px]" />
{{#else}}
          <IconMoon class="w-[18px] h-[18px]" />
{{/if}}
        </button>

{{#if Auth.user}}
        <button onclick="{{ Auth.logout() }}" class="hidden sm:inline-flex text-sm px-3.5 py-1.5 rounded-lg border border-line text-soft hover:bg-raised transition-colors">Log out</button>
{{#else}}
        <a href="/login" class="hidden sm:inline-flex text-sm px-3.5 py-1.5 rounded-lg text-soft hover:bg-raised transition-colors">Log in</a>
        <a href="/register" class="hidden sm:inline-flex text-sm px-4 py-1.5 rounded-lg bg-brand text-white font-semibold hover:bg-brand-hover transition-colors">Get started</a>
{{/if}}

        <button
          onclick="{{ toggleMobileMenu() }}"
          aria-label="Toggle menu"
          aria-expanded="{{ mobileMenuOpen }}"
          aria-controls="mobile-menu"
          class="md:hidden w-9 h-9 flex items-center justify-center rounded-lg text-muted hover:bg-raised transition-colors"
        >
{{#if mobileMenuOpen}}
          <IconX class="w-[18px] h-[18px]" />
{{#else}}
          <IconMenu class="w-[18px] h-[18px]" />
{{/if}}
        </button>
      </div>
    </nav>

{{#if mobileMenuOpen}}
    <div id="mobile-menu" class="md:hidden border-t border-line bg-canvas px-6 py-4 flex flex-col gap-1">
{{#each link in links}}
      <a href="{{ link.href }}" onclick="{{ closeMobileMenu() }}" class="text-sm text-soft hover:bg-raised rounded-lg px-3 py-2.5 transition-colors">{{ link.label }}</a>
{{/each}}
      <div class="h-px bg-line my-2"></div>
{{#if Auth.user}}
      <button onclick="{{ Auth.logout() }}" class="text-sm text-left text-soft hover:bg-raised rounded-lg px-3 py-2.5 transition-colors">Log out</button>
{{#else}}
      <a href="/login" onclick="{{ closeMobileMenu() }}" class="text-sm text-soft hover:bg-raised rounded-lg px-3 py-2.5 transition-colors">Log in</a>
      <a href="/register" onclick="{{ closeMobileMenu() }}" class="text-sm text-center font-semibold bg-brand text-white rounded-lg px-3 py-2.5 mt-1">Get started</a>
{{/if}}
    </div>
{{/if}}
  </header>
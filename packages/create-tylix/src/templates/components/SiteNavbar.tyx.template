component SiteNavbar

import { IconSun, IconMoon, IconMenu, IconX } from "tylix-icons"

props
  showPosts: boolean

uses
  Auth
  Theme

state
  mobileMenuOpen: false

computed
  links() {
    const items = []
    if this.showPosts {
      items.push({ label: "Posts", href: "/posts" })
    }
    if Auth.user {
      items.push({ label: "Dashboard", href: "/dashboard" })
    }
    items.push({ label: "Docs", href: "https://tylix.dev/docs" })
    items.push({ label: "GitHub", href: "https://github.com/tylixjs" })
    return items
  }

action
  toggleMobileMenu() {
    this.mobileMenuOpen = not this.mobileMenuOpen
  }

  closeMobileMenu() {
    this.mobileMenuOpen = false
  }

  isActive(href) {
    const path = window.location.pathname
    return path is href or (href is not "/" and path.startsWith(href + "/"))
  }

  linkClass(href) {
    const base = "text-sm px-3.5 py-1.5 rounded-md transition-colors "
    if this.isActive(href) {
      return base + "text-zinc-900 dark:text-white bg-zinc-100 dark:bg-zinc-900 font-medium"
    }
    return base + "text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-900"
  }

template
  <header class="sticky top-0 z-50 border-b border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-950/80 backdrop-blur">
    <nav class="max-w-6xl mx-auto h-16 px-6 flex items-center justify-between">
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
          <span class="font-semibold tracking-tight">Tylix</span>
        </a>

        <div class="hidden md:flex items-center gap-1">
{{#each link in links}}
          <a href="{{ link.href }}" class="{{ linkClass(link.href) }}">{{ link.label }}</a>
{{/each}}
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          onclick="{{ Theme.toggle() }}"
          aria-label="Toggle color theme"
          class="w-9 h-9 flex items-center justify-center rounded-md text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
        >
{{#if Theme.mode is "dark"}}
          <IconSun class="w-[18px] h-[18px]" />
{{#else}}
          <IconMoon class="w-[18px] h-[18px]" />
{{/if}}
        </button>

{{#if Auth.user}}
        <button onclick="{{ Auth.logout() }}" class="hidden sm:inline-flex text-sm px-3.5 py-1.5 rounded-md border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors">Log out</button>
{{#else}}
        <a href="/login" class="hidden sm:inline-flex text-sm px-3.5 py-1.5 rounded-md text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors">Log in</a>
        <a href="/register" class="hidden sm:inline-flex text-sm px-4 py-1.5 rounded-md bg-emerald-500 text-white dark:text-zinc-950 font-semibold hover:bg-emerald-400 transition-colors">Get started</a>
{{/if}}

        <button
          onclick="{{ toggleMobileMenu() }}"
          aria-label="Toggle menu"
          aria-expanded="{{ mobileMenuOpen }}"
          aria-controls="mobile-menu"
          class="md:hidden w-9 h-9 flex items-center justify-center rounded-md text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
        >
{{#if mobileMenuOpen}}
          <IconX class="w-[18px] h-[18px]" />
{{#else}}
          <IconMenu class="w-[18px] h-[18px]" />
{{/if}}
        </button>
      </div>
    </nav>

{{#if mobileMenuOpen}}
    <div id="mobile-menu" class="md:hidden border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-6 py-4 flex flex-col gap-1">
{{#each link in links}}
      <a href="{{ link.href }}" onclick="{{ closeMobileMenu() }}" class="text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 rounded-md px-3 py-2.5 transition-colors">{{ link.label }}</a>
{{/each}}
      <div class="h-px bg-zinc-200 dark:bg-zinc-800 my-2"></div>
{{#if Auth.user}}
      <button onclick="{{ Auth.logout() }}" class="text-sm text-left text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 rounded-md px-3 py-2.5 transition-colors">Log out</button>
{{#else}}
      <a href="/login" onclick="{{ closeMobileMenu() }}" class="text-sm text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 rounded-md px-3 py-2.5 transition-colors">Log in</a>
      <a href="/register" onclick="{{ closeMobileMenu() }}" class="text-sm text-center font-semibold bg-emerald-500 text-white dark:text-zinc-950 rounded-md px-3 py-2.5 mt-1">Get started</a>
{{/if}}
    </div>
{{/if}}
  </header>
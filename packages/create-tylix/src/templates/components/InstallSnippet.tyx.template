component InstallSnippet

import { IconCheck, IconClipboard } from "tylix-icons"

state
  copied: false
  codeSample: `page Posts

state
  posts: []
  query: ""

computed
  visible() {
    return this.posts.filter(p => p.title has this.query or this.query is "")
  }

onMount
  async {
    const result = await getApi("posts")
    this.posts = result.data
  }

// the template, right below it:
  <input value="{{ query }}" oninput="{{ query = $event.target.value }}" />

{{#each p in visible}}
  <li>{{ p.title }}</li>
{{/each}}`

action
  async copyInstallCommand() {
    if this.copied {
      return null
    }
    await navigator.clipboard.writeText("npx create-tylix my-app")
    this.copied = true
    setTimeout(() => { this.copied = false }, 2000)
  }

template
  <section class="max-w-3xl mx-auto px-6 py-20">
    <div class="rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3 border-b border-zinc-200 dark:border-zinc-800">
        <code class="text-sm font-mono text-zinc-700 dark:text-zinc-300"><span class="text-zinc-400 select-none">$ </span>npx create-tylix my-app</code>
        <button
          onclick="{{ copyInstallCommand() }}"
          aria-label="Copy install command"
          class="inline-flex items-center gap-1.5 text-xs text-zinc-500 hover:text-emerald-500 px-2 py-1 rounded-md hover:bg-zinc-200 dark:hover:bg-zinc-800 transition-colors"
        >
{{#if copied}}
          <IconCheck class="w-3.5 h-3.5" /> Copied
{{#else}}
          <IconClipboard class="w-3.5 h-3.5" /> Copy
{{/if}}
        </button>
      </div>
      <div class="whitespace-pre overflow-x-auto p-6 text-[13px] leading-relaxed font-mono text-zinc-600 dark:text-zinc-300">{{ codeSample }}</div>
    </div>
  </section>
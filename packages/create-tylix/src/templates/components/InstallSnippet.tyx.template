component InstallSnippet

import { IconCheck, IconClipboard } from "tylix-icons"

state
  copied: false
  codeSample: `page Posts

state
  posts: []
  query: ""

computed
  visible() {
    return this.posts.filter(p => p.title has this.query or this.query is "")
  }

onMount
  async {
    const result = await getApi("posts")
    this.posts = result.data
  }

// the template, right below it:
  <input value="{{ query }}" oninput="{{ query = $event.target.value }}" />

{{#each p in visible}}
  <li>{{ p.title }}</li>
{{/each}}`

action
  async copyInstallCommand() {
    if this.copied {
      return null
    }
    await navigator.clipboard.writeText("npx create-tylix my-app")
    this.copied = true
    setTimeout(() => { this.copied = false }, 2000)
  }

template
  <section class="max-w-3xl mx-auto px-6 py-20">
    <div class="tx-glow overflow-hidden">
      <div class="flex items-center justify-between gap-4 px-5 py-3 border-b border-line bg-raised">
        <span class="tx-leds"><i></i><i></i><i></i></span>
        <code class="flex-1 truncate text-sm font-mono text-soft"><span class="text-muted select-none">$ </span>npx create-tylix my-app</code>
        <button
          onclick="{{ copyInstallCommand() }}"
          aria-label="Copy install command"
          class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-ink px-2 py-1 rounded-lg hover:bg-panel transition-colors"
        >
{{#if copied}}
          <IconCheck class="w-3.5 h-3.5" /> Copied
{{#else}}
          <IconClipboard class="w-3.5 h-3.5" /> Copy
{{/if}}
        </button>
      </div>
      <div class="whitespace-pre overflow-x-auto p-6 text-[13px] leading-relaxed font-mono text-soft bg-well">{{ codeSample }}</div>
    </div>
  </section>
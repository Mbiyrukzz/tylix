component InstallSnippet

state
  copied: false
  installing: false

action
  async copyInstallCommand() {
    if not this.copied and not this.installing {
      await navigator.clipboard.writeText("npx create-tylix my-app")
      this.copied = true
    }
  }

template
  <section class="px-6 pb-24 max-w-3xl mx-auto">
    <div class="rounded-2xl border border-slate-800 bg-slate-900 overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-800 bg-slate-950/40">
        <div class="flex gap-1.5">
          <span class="w-3 h-3 rounded-full bg-slate-700"></span>
          <span class="w-3 h-3 rounded-full bg-slate-700"></span>
          <span class="w-3 h-3 rounded-full bg-slate-700"></span>
        </div>
        <button
          onclick="{{ copyInstallCommand() }}"
          aria-label="Copy install command"
          class="text-xs text-slate-400 hover:text-emerald-400 transition px-2 py-1 rounded hover:bg-slate-800"
        >
          <span aria-live="polite">
{{#if copied}}
            Copied &#10003;
{{/if}}
{{#if not copied}}
            Copy
{{/if}}
          </span>
        </button>
      </div>
      <pre class="text-slate-300 text-[13px] font-mono p-6 overflow-x-auto leading-relaxed">$ npx create-tylix my-app

page Post

state
  posts: []
  query: ""

computed
  visiblePosts() {
    return this.posts.filter(p => p.title has this.query or this.query is "")
  }

onMount
  async {
    const result = await getApi("posts")
    this.posts = result.data
  }

template
    render each post title as a list item</pre>
    </div>
  </section>
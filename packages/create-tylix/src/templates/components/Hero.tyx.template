component Hero

import { IconArrowRight } from "tylix-icons"

props
  loggedIn: boolean
  hasAuth: boolean
  hasPosts: boolean

template
  <section class="border-b border-line">
    <div class="max-w-6xl mx-auto px-6 pt-20 pb-20 grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
      <div>
        <p class="tx-eyebrow mb-6">Full-stack JavaScript framework</p>

        <h1 class="text-5xl md:text-6xl font-semibold tracking-tight leading-[1.05] mb-6">
          Full-stack JavaScript,
          <br />
          <span class="tx-gradient-text">without the virtual DOM</span>
        </h1>

        <p class="text-lg text-muted max-w-xl mb-10 leading-relaxed">
          A reactive compiler, a generator-first CLI and a database-agnostic ORM,
          wired together so you write pages, not plumbing.
        </p>

        <div class="flex flex-wrap items-center gap-3">
{{#if loggedIn}}
          <a href="/dashboard" class="tx-btn tx-btn-primary">
            Go to Dashboard
            <IconArrowRight class="w-4 h-4" />
          </a>
{{#else if hasAuth}}
          <a href="/register" class="tx-btn tx-btn-primary">
            Get started
            <IconArrowRight class="w-4 h-4" />
          </a>
{{#else}}
          <a href="https://tylix.dev/docs" class="tx-btn tx-btn-primary">
            Read the docs
            <IconArrowRight class="w-4 h-4" />
          </a>
{{/if}}
{{#if hasPosts}}
          <a href="/posts" class="tx-btn tx-btn-outline">Browse posts</a>
{{/if}}
        </div>
      </div>

      <div class="flex justify-center lg:justify-end">
        <div class="tx-console" aria-hidden="true">
          <div class="tx-console-mosaic"></div>
          <div class="tx-console-screen">
            <span><span class="dim">$</span> npx create-tylix my-app</span>
            <span><span class="ok">✓</span> pages, auth, database</span>
            <span><span class="ok">✓</span> 0 virtual DOM diffs</span>
            <span><span class="dim">➜</span> <span class="url">localhost:3000</span></span>
          </div>
          <div class="tx-console-chevrons"></div>
          <div class="tx-console-leds"><i></i><i></i><i></i><i></i><i></i></div>
          <div class="tx-console-signal"></div>
          <div class="tx-console-meter"><i></i><i></i><i></i><i></i></div>
        </div>
      </div>
    </div>
  </section>
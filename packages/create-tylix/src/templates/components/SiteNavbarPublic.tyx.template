component SiteNavbarPublic

import { IconSun, IconMoon, IconMenu, IconX } from "tylix-icons"

uses
  Theme

state
  mobileMenuOpen: false
  links: [
    { label: "Docs", href: "https://tylix.dev/docs" },
    { label: "GitHub", href: "https://github.com/tylixjs" },
    { label: "Discord", href: "https://discord.gg/tylix" }
  ]

action
  toggleMobileMenu() {
    this.mobileMenuOpen = not this.mobileMenuOpen
  }

  closeMobileMenu() {
    this.mobileMenuOpen = false
  }

template
  <header class="tx-nav">
    <nav class="max-w-6xl mx-auto h-16 px-6 flex items-center justify-between">
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/logo-mark.svg" alt="" class="h-[22px] w-auto" />
          <span class="text-[17px] font-bold tracking-tight">Tylix</span>
        </a>

        <div class="hidden md:flex items-center gap-1">
{{#each link in links}}
          <a href="{{ link.href }}" class="text-sm px-3.5 py-1.5 rounded-lg text-soft hover:text-ink hover:bg-raised transition-colors">{{ link.label }}</a>
{{/each}}
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          onclick="{{ Theme.toggle() }}"
          aria-label="Toggle color theme"
          class="tx-icon-btn"
        >
{{#if Theme.mode is "dark"}}
          <IconSun class="w-[18px] h-[18px]" />
{{#else}}
          <IconMoon class="w-[18px] h-[18px]" />
{{/if}}
        </button>

        <button
          onclick="{{ toggleMobileMenu() }}"
          aria-label="Toggle menu"
          aria-expanded="{{ mobileMenuOpen }}"
          aria-controls="mobile-menu"
          class="md:hidden w-9 h-9 flex items-center justify-center rounded-lg text-muted hover:bg-raised transition-colors"
        >
{{#if mobileMenuOpen}}
          <IconX class="w-[18px] h-[18px]" />
{{#else}}
          <IconMenu class="w-[18px] h-[18px]" />
{{/if}}
        </button>
      </div>
    </nav>

{{#if mobileMenuOpen}}
    <div id="mobile-menu" class="md:hidden border-t border-line bg-canvas px-6 py-4 flex flex-col gap-1">
{{#each link in links}}
      <a href="{{ link.href }}" onclick="{{ closeMobileMenu() }}" class="text-sm text-soft hover:bg-raised rounded-lg px-3 py-2.5 transition-colors">{{ link.label }}</a>
{{/each}}
    </div>
{{/if}}
  </header>
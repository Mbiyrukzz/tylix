page PostDetailPublic

title "Post"

props
  id: string

state
  post: null
  loading: true
  gone: false
  error: ""

action
  formatDate(value) {
    if not value {
      return ""
    }
    return new Date(value).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  }

onMount
  async {
    const result = await useApi(`/api/public/posts/${this.id}`)
    if result.ok {
      this.post = result.data
      document.title = result.data.title
    } else if result.status is 404 {
      this.gone = true
    } else {
      this.error = result.error ?? "Couldn't load this post."
    }
    this.loading = false
  }

template
  <article class="max-w-2xl mx-auto px-6 py-16">
    <a href="/posts" class="inline-flex items-center text-sm text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors mb-10">
      &larr; All posts
    </a>

{{#if loading}}
    <p class="text-sm text-zinc-500">Loading…</p>
{{#else if gone}}
    <h1 class="text-3xl font-semibold tracking-tight mb-3">Post not found</h1>
    <p class="text-zinc-500 dark:text-zinc-400">It may have been removed, or the link is wrong.</p>
{{#else if error}}
    <div role="alert" class="rounded-md border border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3">
      <p class="text-sm text-rose-700 dark:text-rose-400">{{ error }}</p>
    </div>
{{#else if post}}
    <p class="text-xs text-zinc-500 mb-4">{{ formatDate(post.created_at) }} · {{ post.author }}</p>
    <h1 class="text-4xl font-semibold tracking-tight mb-8 leading-tight">{{ post.title }}</h1>
{{#if post.cover_image}}
    <img src="{{ post.cover_image }}" alt="" class="w-full aspect-video object-cover rounded-lg border border-zinc-200 dark:border-zinc-800 mb-8" />
{{/if}}
    <div class="text-zinc-700 dark:text-zinc-300 leading-relaxed whitespace-pre-wrap">{{ post.body }}</div>
{{/if}}
  </article>
import { renderWithData } from '@tylix/svelte/server'
// @if ts
import type { RenderOptions } from '@tylix/svelte/server'
// @endif
import App from './App.svelte'

// Server-side rendering (frontend.ssr in tylix.config). Tylix calls this
// for every page request and puts the result in index.html's
// <!--ssr-outlet-->. The browser then hydrates it (see main).
//
//   url      the requested path and query
//   session  the visitor's session: { user } or { user: null }
//   load     loads one /api/ URL in-process as this visitor
//
// renderWithData renders, loads what useApi asked for, and renders again
// until the page has its data. Components read the request's state with
// useRoute()/useSession(), and can set the HTTP status or answer with a
// redirect through useServerContext() (see NotFound, App).
// @if ts
export function render({ url, session, load }: RenderOptions) {
// @endif
// @if !ts
export function render({ url, session, load }) {
// @endif
  return renderWithData(App, { url, session, load })
}

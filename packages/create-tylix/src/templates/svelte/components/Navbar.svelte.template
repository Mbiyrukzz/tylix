<script__LANG__>
  import { onMount } from 'svelte'
  import { useRoute } from '@tylix/svelte'
  // @if auth
  import { auth, navigate, useSession } from '@tylix/svelte'
  // @endif

  // The request's state during SSR, the browser's otherwise.
  const route = useRoute()
  // @if auth
  const session = useSession()
  // @endif

  // Unknown until mounted: the server can't see the visitor's theme, and the
  // first browser render must match the server's. The script in index.html
  // has already applied the right class to <html> by then.
  let dark = $state(false)
  let themeKnown = $state(false)
  onMount(() => {
    dark = document.documentElement.classList.contains('dark')
    themeKnown = true
  })

  $effect(() => {
    if (!themeKnown) return
    document.documentElement.classList.toggle('dark', dark)
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light')
    } catch {
      // private mode: the theme just isn't remembered
    }
  })

  const base = 'text-sm px-3.5 py-1.5 rounded-lg transition-colors '
  const idle =
    base +
    'text-soft hover:text-ink hover:bg-raised '
  const active = base + 'text-ink bg-raised font-medium tx-nav-link-active'

  // @if ts
  const linkClass = (href: string) =>
  // @endif
  // @if !ts
  const linkClass = (href) =>
  // @endif
    $route.path === href || (href !== '/' && $route.path.startsWith(href + '/')) ? active : idle
  // @if auth

  async function logOut() {
    // Leave the page first, so a protected page doesn't bounce to /login
    // the moment the session ends.
    navigate('/', { replace: true })
    await auth.logout()
  }
  // @endif
</script>

<header class="tx-nav">
  <nav class="max-w-6xl mx-auto h-16 px-6 flex items-center justify-between">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2.5">
        <img src="/logo-mark.svg" alt="" class="h-[22px] w-auto" />
        <span class="text-[17px] font-bold tracking-tight">__APP_NAME__</span>
      </a>
      <div class="hidden md:flex items-center gap-1">
        <a href="/" class={linkClass('/')}>Home</a>
        <!-- @if posts -->
        <a href="/posts" class={linkClass('/posts')}>Posts</a>
        <!-- @endif -->
        <!-- @if auth -->
        {#if $session.isAuthenticated}
          <a href="/dashboard" class={linkClass('/dashboard')}>Dashboard</a>
        {/if}
        <!-- @endif -->
        <a href="https://tylix.dev/docs" class={idle}>Docs</a>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button
        type="button"
        onclick={() => (dark = !dark)}
        aria-label="Toggle color theme"
        class="tx-icon-btn"
      >
        {dark ? '☀' : '☾'}
      </button>
      <!-- @if auth -->
      {#if $session.isAuthenticated}
        <button
          type="button"
          onclick={logOut}
          data-testid="logout"
          class="text-sm px-3.5 py-1.5 rounded-lg border border-line text-soft hover:bg-raised transition-colors"
        >
          Log out
        </button>
      {:else if !$session.loading}
        <a
          href="/login"
          class="text-sm px-3.5 py-1.5 rounded-lg text-soft hover:bg-raised transition-colors"
        >
          Log in
        </a>
        <a
          href="/register"
          class="text-sm px-4 py-1.5 rounded-lg bg-brand text-white font-semibold hover:bg-brand-hover transition-colors"
        >
          Get started
        </a>
      {/if}
      <!-- @endif -->
    </div>
  </nav>
</header>

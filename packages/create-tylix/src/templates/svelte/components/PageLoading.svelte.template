  // never flash it.
  //
  //   <PageLoading />                               a whole page
  //   <PageLoading compact label="Loading posts" /> one section of a page
  // @if ts
  let { label = '', compact = false }: { label?: string; compact?: boolean } = $props()
  // @endif
  // @if !ts
  let { label = '', compact = false } = $props()
  // @endif
</script>


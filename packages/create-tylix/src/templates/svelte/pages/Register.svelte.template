<script__LANG__>
  import { auth, useHydrated } from '@tylix/svelte'
  import OAuthButtons from '../components/OAuthButtons.svelte'
  import { firstError } from '@tylix/shared/validation'
  import { MIN_PASSWORD_LENGTH, validateRegister } from '../../validators/AuthValidator'

  const inputClass =
    'tx-input'

  const perks = [
    'Auth, database and styling already wired',
    'Svelte on the front, Tylix on the back',
    'Generate new features with one command',
  ]
  const strengthLabels = ['Too short', 'Weak', 'Fair', 'Good', 'Strong']

  let name = $state('')
  let email = $state('')
  let password = $state('')
  let confirmPassword = $state('')
  let agreed = $state(false)
  let error = $state('')
  let submitting = $state(false)
  let registered = $state(false)

  const score = $derived.by(() => {
    if (password.length < MIN_PASSWORD_LENGTH) return 0
    let points = 1
    if (/[a-z]/.test(password) && /[A-Z]/.test(password)) points++
    if (/[0-9]/.test(password)) points++
    if (/[^A-Za-z0-9]/.test(password)) points++
    return points
  })

  function validate() {
    // The same rules the API checks (app/validators/AuthValidator).
    const problem = firstError(validateRegister({ name: name.trim(), email, password }))
    if (problem) return problem
    if (password !== confirmPassword) return "Passwords don't match."
    if (!agreed) return 'Please agree to the Terms of Service to continue.'
    return ''
  }

  async function submit() {
    if (submitting) return
    error = validate()
    if (error) return

    submitting = true
    const result = await auth.register({ name: name.trim(), email, password })
    submitting = false

    if (result.ok) registered = true
    else if (result.status === 429) error = 'Too many attempts. Wait a minute and try again.'
    else if (result.status === 0) error = 'Network error. Check your connection and try again.'
    else error = result.error ?? 'Could not create account. Check your details and try again.'
  }

  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
</script>

<div class="flex items-center justify-center px-6 py-16">
  <div class="tx-auth tx-glow">
    <div class="tx-auth-aside">
      <p class="tx-eyebrow mb-5">New account</p>
      <h2 class="text-2xl font-semibold tracking-tight mb-3">Create your account</h2>
      <p class="text-sm text-muted mb-8 leading-relaxed">It takes less than a minute.</p>
      <ul class="space-y-3">
        {#each perks as perk (perk)}
          <li class="flex items-start gap-2.5 text-sm text-soft">
            <span class="text-mint">✓</span>
            {perk}
          </li>
        {/each}
      </ul>
    </div>

    <div class="tx-auth-form">
      {#if registered}
        <div class="w-full max-w-sm" data-testid="registered">
          <div class="w-11 h-11 rounded-lg bg-brand/10 flex items-center justify-center mb-5 text-link">✓</div>
          <h1 class="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
          <p class="text-sm text-muted mb-8">
            We sent a verification link to <span class="text-ink">{email}</span>. Click it, then log in.
          </p>
          <a
            href="/login"
            class="tx-btn tx-btn-primary tx-btn-block"
          >
            Go to login
          </a>
          {#if import.meta.env.DEV}
            <p class="text-xs text-muted text-center mt-4">
              No mail server yet? <a href="/dev/mail" class="tx-link">Open the dev mail log</a>
            </p>
          {/if}
        </div>
      {:else}
        <form
          class="w-full max-w-sm"
          novalidate
          onsubmit={(event) => {
            event.preventDefault()
            submit()
          }}
        >
          <h1 class="text-2xl font-semibold tracking-tight mb-1">Create account</h1>
          <p class="text-sm text-muted mb-8">Start building with Tylix.</p>

          {#if error}
            <div role="alert" aria-live="polite" class="tx-alert tx-alert-error mb-6">
              <p class="text-sm">{error}</p>
            </div>
          {/if}

          <OAuthButtons />

          <label for="name" class="tx-label">Name</label>
          <!-- svelte-ignore a11y_autofocus -->
          <input id="name" name="name" autocomplete="name" autofocus bind:value={name} class={inputClass} />

          <label for="email" class="tx-label">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" bind:value={email} class={inputClass} />

          <label for="password" class="tx-label">Password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" bind:value={password} class={inputClass} />
          {#if password}
            <p class="-mt-3 mb-4 text-xs text-muted">Strength: {strengthLabels[score]}</p>
          {/if}

          <label for="confirmPassword" class="tx-label">Confirm password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" bind:value={confirmPassword} class={inputClass} />

          <label class="flex items-center gap-2 text-sm text-muted mb-6">
            <input type="checkbox" name="terms" bind:checked={agreed} class="rounded border-line-strong" />
            I agree to the Terms of Service
          </label>

          <button
            type="submit"
            disabled={submitting || !$hydrated}
            class="tx-btn tx-btn-primary tx-btn-block"
          >
            {submitting ? 'Creating account…' : 'Create account'}
          </button>

          <p class="text-sm text-muted text-center mt-6">
            Already have an account? <a href="/login" class="tx-link">Log in</a>
          </p>
        </form>
      {/if}
    </div>
  </div>
</div>

<script__LANG__>
  import { auth, useHydrated } from '@tylix/svelte'
  import { firstError } from '@tylix/shared/validation'
  import { MIN_PASSWORD_LENGTH, validateRegister } from '../../validators/AuthValidator'

  const inputClass =
    'w-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 rounded-md px-3.5 py-2.5 mb-4 text-sm outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition'

  const perks = [
    'Auth, database and styling already wired',
    'Svelte on the front, Tylix on the back',
    'Generate new features with one command',
  ]
  const strengthLabels = ['Too short', 'Weak', 'Fair', 'Good', 'Strong']

  let name = $state('')
  let email = $state('')
  let password = $state('')
  let confirmPassword = $state('')
  let agreed = $state(false)
  let error = $state('')
  let submitting = $state(false)
  let registered = $state(false)

  const score = $derived.by(() => {
    if (password.length < MIN_PASSWORD_LENGTH) return 0
    let points = 1
    if (/[a-z]/.test(password) && /[A-Z]/.test(password)) points++
    if (/[0-9]/.test(password)) points++
    if (/[^A-Za-z0-9]/.test(password)) points++
    return points
  })

  function validate() {
    // The same rules the API checks (app/validators/AuthValidator).
    const problem = firstError(validateRegister({ name: name.trim(), email, password }))
    if (problem) return problem
    if (password !== confirmPassword) return "Passwords don't match."
    if (!agreed) return 'Please agree to the Terms of Service to continue.'
    return ''
  }

  async function submit() {
    if (submitting) return
    error = validate()
    if (error) return

    submitting = true
    const result = await auth.register({ name: name.trim(), email, password })
    submitting = false

    if (result.ok) registered = true
    else if (result.status === 429) error = 'Too many attempts. Wait a minute and try again.'
    else if (result.status === 0) error = 'Network error. Check your connection and try again.'
    else error = result.error ?? 'Could not create account. Check your details and try again.'
  }

  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
</script>

<div class="flex items-center justify-center px-6 py-16">
  <div class="w-full max-w-4xl grid grid-cols-1 lg:grid-cols-2 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden">
    <div class="hidden lg:flex flex-col justify-center border-r border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/60 p-10">
      <h2 class="text-2xl font-semibold tracking-tight mb-3">Create your account</h2>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-8 leading-relaxed">It takes less than a minute.</p>
      <ul class="space-y-3">
        {#each perks as perk (perk)}
          <li class="flex items-start gap-2.5 text-sm text-zinc-600 dark:text-zinc-300">
            <span class="text-emerald-500">✓</span>
            {perk}
          </li>
        {/each}
      </ul>
    </div>

    <div class="flex items-center justify-center px-6 py-12">
      {#if registered}
        <div class="w-full max-w-sm" data-testid="registered">
          <div class="w-11 h-11 rounded-md bg-emerald-500/10 flex items-center justify-center mb-5 text-emerald-600">✓</div>
          <h1 class="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
          <p class="text-sm text-zinc-500 mb-8">
            We sent a verification link to <span class="text-zinc-900 dark:text-zinc-200">{email}</span>. Click it, then log in.
          </p>
          <a
            href="/login"
            class="inline-block w-full text-center bg-emerald-500 text-white dark:text-zinc-950 rounded-md py-2.5 text-sm font-semibold hover:bg-emerald-400 transition-colors"
          >
            Go to login
          </a>
          {#if import.meta.env.DEV}
            <p class="text-xs text-zinc-500 text-center mt-4">
              No mail server yet? <a href="/dev/mail" class="text-emerald-600 dark:text-emerald-400 hover:underline">Open the dev mail log</a>
            </p>
          {/if}
        </div>
      {:else}
        <form
          class="w-full max-w-sm"
          novalidate
          onsubmit={(event) => {
            event.preventDefault()
            submit()
          }}
        >
          <h1 class="text-2xl font-semibold tracking-tight mb-1">Create account</h1>
          <p class="text-sm text-zinc-500 mb-8">Start building with Tylix.</p>

          {#if error}
            <div role="alert" aria-live="polite" class="rounded-md border border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
              <p class="text-rose-700 dark:text-rose-400 text-sm">{error}</p>
            </div>
          {/if}

          <label for="name" class="block text-zinc-500 text-xs font-medium mb-1.5">Name</label>
          <!-- svelte-ignore a11y_autofocus -->
          <input id="name" name="name" autocomplete="name" autofocus bind:value={name} class={inputClass} />

          <label for="email" class="block text-zinc-500 text-xs font-medium mb-1.5">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" bind:value={email} class={inputClass} />

          <label for="password" class="block text-zinc-500 text-xs font-medium mb-1.5">Password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" bind:value={password} class={inputClass} />
          {#if password}
            <p class="-mt-3 mb-4 text-xs text-zinc-500">Strength: {strengthLabels[score]}</p>
          {/if}

          <label for="confirmPassword" class="block text-zinc-500 text-xs font-medium mb-1.5">Confirm password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" bind:value={confirmPassword} class={inputClass} />

          <label class="flex items-center gap-2 text-sm text-zinc-500 mb-6">
            <input type="checkbox" name="terms" bind:checked={agreed} class="rounded border-zinc-300 dark:border-zinc-700" />
            I agree to the Terms of Service
          </label>

          <button
            type="submit"
            disabled={submitting || !$hydrated}
            class="w-full bg-emerald-500 text-white dark:text-zinc-950 rounded-md py-2.5 text-sm font-semibold hover:bg-emerald-400 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {submitting ? 'Creating account…' : 'Create account'}
          </button>

          <p class="text-sm text-zinc-500 text-center mt-6">
            Already have an account? <a href="/login" class="text-emerald-600 dark:text-emerald-400 hover:underline">Log in</a>
          </p>
        </form>
      {/if}
    </div>
  </div>
</div>

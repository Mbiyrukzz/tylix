<script__LANG__>
  import { auth, useHydrated } from '@tylix/svelte'
  import { firstError } from '@tylix/shared/validation'
  import { validateForgotPassword } from '../../validators/AuthValidator'

  let email = $state('')
  let error = $state('')
  let submitting = $state(false)
  let sent = $state(false)

  async function submit() {
    if (submitting) return
    const problem = firstError(validateForgotPassword({ email }))
    if (problem) {
      error = problem
      return
    }
    error = ''
    submitting = true
    const result = await auth.forgotPassword(email)
    submitting = false

    // The server answers the same way whether or not the email is
    // registered, so this page can't be used to find out who has an account.
    if (result.ok) sent = true
    else if (result.status === 429) error = 'Too many requests. Wait a minute and try again.'
    else if (result.status === 0) error = 'Network error. Check your connection and try again.'
    else error = result.error ?? 'Could not send the reset link. Try again.'
  }

  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
</script>

<div class="flex items-center justify-center px-6 py-16">
  <div class="tx-card tx-glow">
    {#if sent}
      <div data-testid="reset-sent">
        <h1 class="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
        <p class="text-sm text-muted mb-6">
          If <span class="text-ink">{email}</span> has an account, a link to reset the password is on its way.
        </p>
        {#if import.meta.env.DEV}
          <p class="text-xs text-muted mb-6">
            No mail server yet? <a href="/dev/mail" class="tx-link">Open the dev mail log</a>
          </p>
        {/if}
        <a href="/login" class="text-sm tx-link">Back to login</a>
      </div>
    {:else}
      <form
        novalidate
        onsubmit={(event) => {
          event.preventDefault()
          submit()
        }}
      >
        <h1 class="text-2xl font-semibold tracking-tight mb-1">Forgot your password?</h1>
        <p class="text-sm text-muted mb-6">We'll email you a link to choose a new one.</p>

        {#if error}
          <div role="alert" class="tx-alert tx-alert-error mb-6">
            <p class="text-sm">{error}</p>
          </div>
        {/if}

        <label for="email" class="tx-label">Email</label>
        <!-- svelte-ignore a11y_autofocus -->
        <input
          id="email"
          type="email"
          autocomplete="email"
          autofocus
          bind:value={email}
          class="tx-input"
        />
        <button
          type="submit"
          disabled={submitting || !$hydrated}
          class="tx-btn tx-btn-primary tx-btn-block"
        >
          {submitting ? 'Sending…' : 'Send reset link'}
        </button>
        <p class="text-sm text-muted text-center mt-6">
          <a href="/login" class="tx-link">Back to login</a>
        </p>
      </form>
    {/if}
  </div>
</div>

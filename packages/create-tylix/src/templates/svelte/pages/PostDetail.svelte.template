<script__LANG__>
  import { usePost } from '../providers/posts'

  // The post for this URL's :id (providers/posts).
  const post = usePost()
  // A fixed locale and time zone: with SSR, a date must read the same on the
  // server and in the visitor's browser, or hydration fails.
  const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' })
</script>

<article class="max-w-3xl mx-auto px-6 py-12">
  <a href="/posts" class="text-sm text-emerald-600 dark:text-emerald-400 hover:underline">← All posts</a>
  {#if $post.loading && !$post.post}
    <p class="text-sm text-zinc-500 mt-8">Loading…</p>
  {:else if $post.notFound}
    <div class="mt-8">
      <h1 class="text-2xl font-semibold">Post not found</h1>
      <p class="text-sm text-zinc-500 mt-2">It may have been deleted.</p>
    </div>
  {:else if $post.error}
    <p class="text-sm text-rose-600 mt-8">{$post.error}</p>
  {:else if $post.post}
    <h1 class="text-4xl font-semibold tracking-tight mt-6 mb-3" data-testid="post-title">{$post.post.title}</h1>
    <p class="text-sm text-zinc-500 mb-8">{$post.post.author} · {dateFormat.format(new Date($post.post.created_at))}</p>
    <div class="text-zinc-700 dark:text-zinc-300 leading-relaxed whitespace-pre-line">{$post.post.body}</div>
  {/if}
</article>

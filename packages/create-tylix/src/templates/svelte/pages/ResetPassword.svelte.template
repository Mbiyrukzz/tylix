<script__LANG__>
  import { auth, useHydrated, useRoute } from '@tylix/svelte'
  import { firstError } from '@tylix/shared/validation'
  import { validateResetPassword } from '../../validators/AuthValidator'

  // The request's state during SSR, the browser's otherwise.
  const route = useRoute()

  const inputClass =
    'tx-input'
  const card = 'tx-card tx-glow'

  // Opened from the link in the reset email:
  //   /reset-password?token=...&email=...
  const token = $derived($route.query.get('token') ?? '')
  const email = $derived($route.query.get('email') ?? '')

  let password = $state('')
  let confirmPassword = $state('')
  let error = $state('')
  let submitting = $state(false)
  let done = $state(false)

  async function submit() {
    if (submitting) return
    const problem = firstError(validateResetPassword({ email, token, password }))
    if (problem) {
      error = problem
      return
    }
    if (password !== confirmPassword) {
      error = "Passwords don't match."
      return
    }
    error = ''
    submitting = true
    const result = await auth.resetPassword({ email, token, password })
    submitting = false

    if (result.ok) done = true
    else if (result.status === 0) error = 'Network error. Check your connection and try again.'
    else error = result.error ?? 'Could not reset the password. Try again.'
  }

  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
</script>

<div class="flex items-center justify-center px-6 py-16">
  <div class={card}>
    {#if !token || !email}
      <h1 class="text-2xl font-semibold tracking-tight mb-2">This link is incomplete</h1>
      <p class="text-sm text-muted mb-6">Open the link from the email again, or ask for a new one.</p>
      <a href="/forgot-password" class="text-sm tx-link">Request a new link</a>
    {:else if done}
      <div data-testid="reset-done">
        <h1 class="text-2xl font-semibold tracking-tight mb-2">Password updated</h1>
        <p class="text-sm text-muted mb-6">For your security, every device was logged out. Log in with your new password.</p>
        <a
          href="/login"
          class="tx-btn tx-btn-primary tx-btn-block"
        >
          Go to login
        </a>
      </div>
    {:else}
      <form
        novalidate
        onsubmit={(event) => {
          event.preventDefault()
          submit()
        }}
      >
        <h1 class="text-2xl font-semibold tracking-tight mb-1">Choose a new password</h1>
        <p class="text-sm text-muted mb-6">For {email}</p>

        {#if error}
          <div role="alert" class="tx-alert tx-alert-error mb-6">
            <p class="text-sm">{error}</p>
          </div>
        {/if}

        <label for="password" class="tx-label">New password</label>
        <!-- svelte-ignore a11y_autofocus -->
        <input id="password" type="password" autocomplete="new-password" autofocus bind:value={password} class={inputClass} />

        <label for="confirmPassword" class="tx-label">Confirm new password</label>
        <input id="confirmPassword" type="password" autocomplete="new-password" bind:value={confirmPassword} class={inputClass} />

        <button
          type="submit"
          disabled={submitting || !$hydrated}
          class="tx-btn tx-btn-primary tx-btn-block"
        >
          {submitting ? 'Saving…' : 'Update password'}
        </button>
      </form>
    {/if}
  </div>
</div>

<script__LANG__>
  import { IconMail, IconServer, IconShieldCheck } from 'tylix-icons/svelte'
  import { useHydrated, useSession } from '@tylix/svelte'
  // @if posts
  import { useMyPosts } from '../providers/posts'
  // @endif

  // The request's state during SSR, the browser's otherwise.
  const session = useSession()
  // @if posts

  // Your posts (providers/posts): the list plus create and remove, which
  // reload it. Only the logged-in user's posts.
  const posts = useMyPosts()

  let title = $state('')
  let body = $state('')
  let error = $state('')
  let saving = $state(false)

  async function create() {
    if (saving) return
    if (!title.trim() || !body.trim()) {
      error = 'Give the post a title and some text.'
      return
    }
    saving = true
    const problem = await posts.create({ title: title.trim(), body: body.trim() })
    saving = false
    if (problem) {
      error = problem
      return
    }
    error = ''
    title = ''
    body = ''
  }

  // @if ts
  async function remove(id: number) {
  // @endif
  // @if !ts
  async function remove(id) {
  // @endif
    const problem = await posts.remove(id)
    if (problem) error = problem
  }
  // @endif

  const cardClass = 'tx-panel p-5'

  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
</script>

<div class="max-w-6xl mx-auto px-6 py-12">
  <p class="text-sm text-muted mb-1">Signed in as</p>
  <h1 class="text-3xl font-semibold tracking-tight mb-8" data-testid="dashboard-name">{$session.user?.name}</h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
    <div class={cardClass}>
      <IconMail class="w-4 h-4 text-mint mb-3" />
      <p class="text-xs text-muted mb-1">Email</p>
      <p class="text-sm font-semibold truncate">{$session.user?.email}</p>
    </div>
    <div class={cardClass}>
      <IconShieldCheck class="w-4 h-4 text-mint mb-3" />
      <p class="text-xs text-muted mb-1">Session</p>
      <p class="text-sm font-semibold">httpOnly cookie, refreshed automatically</p>
    </div>
    <div class={cardClass}>
      <IconServer class="w-4 h-4 text-mint mb-3" />
      <p class="text-xs text-muted mb-1">Protected API</p>
      <p class="text-sm font-semibold">GET /api/me</p>
    </div>
  </div>
  <!-- @if posts -->

  <section>
    <h2 class="text-xl font-semibold tracking-tight mb-4">Your posts</h2>

    <form
      class="{cardClass} mb-6"
      onsubmit={(event) => {
        event.preventDefault()
        create()
      }}
    >
      {#if error}
        <p role="alert" class="text-coral text-sm mb-3">{error}</p>
      {/if}
      <input
        name="title"
        placeholder="Title"
        bind:value={title}
        class="tx-input mb-3"
      />
      <textarea
        name="body"
        placeholder="Write something…"
        rows="3"
        bind:value={body}
        class="tx-input mb-3"
      ></textarea>
      <button
        type="submit"
        disabled={saving || !$hydrated}
        class="px-4 py-2 rounded-lg bg-brand text-white text-sm font-semibold hover:bg-brand-hover transition-colors disabled:opacity-50"
      >
        {saving ? 'Saving…' : 'Publish post'}
      </button>
    </form>

    {#if $posts.loading && $posts.posts.length === 0}
      <p class="text-sm text-muted">Loading posts…</p>
    {:else if $posts.error}
      <p class="text-sm text-coral">{$posts.error}</p>
    {:else if $posts.posts.length > 0}
      <ul class="space-y-3" data-testid="posts">
        {#each $posts.posts as post (post.id)}
          <li class="{cardClass} flex items-start justify-between gap-4">
            <div>
              <p class="font-semibold">{post.title}</p>
              <p class="text-sm text-muted mt-1 whitespace-pre-line">{post.body}</p>
            </div>
            <button type="button" onclick={() => remove(post.id)} class="text-sm text-muted hover:text-coral transition-colors">
              Delete
            </button>
          </li>
        {/each}
      </ul>
    {:else}
      <p class="text-sm text-muted">No posts yet. Publish your first one above.</p>
    {/if}
  </section>
  <!-- @endif -->
</div>

<script__LANG__>
  import { usePublicPosts } from '../providers/posts'
  import PageLoading from '../components/PageLoading.svelte'

  // Everyone's posts, newest first (providers/posts).
  const posts = usePublicPosts()
  // A fixed locale and time zone: with SSR, a date must read the same on the
  // server and in the visitor's browser, or hydration fails.
  const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' })
</script>

<div class="max-w-3xl mx-auto px-6 py-12">
  <h1 class="text-3xl font-semibold tracking-tight mb-8">Posts</h1>
  {#if $posts.loading && $posts.posts.length === 0}
    <PageLoading compact label="Loading posts" />
  {:else if $posts.error}
    <p class="text-sm text-coral">{$posts.error}</p>
  {:else if $posts.posts.length > 0}
    <ul class="space-y-4" data-testid="public-posts">
      {#each $posts.posts as post (post.id)}
        <li>
          <a
            href="/posts/{post.id}"
            class="block tx-panel p-5 hover:border-line-strong transition-colors"
          >
            <p class="font-semibold">{post.title}</p>
            <p class="text-sm text-muted mt-1">{post.excerpt}</p>
            <p class="text-xs text-muted mt-3">{post.author} · {dateFormat.format(new Date(post.created_at))}</p>
          </a>
        </li>
      {/each}
    </ul>
  {:else}
    <p class="text-sm text-muted">No posts yet.</p>
  {/if}
</div>

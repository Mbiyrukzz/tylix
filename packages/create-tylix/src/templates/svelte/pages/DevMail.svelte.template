<script__LANG__>
  import { useMailLog } from '../providers/mail'
  import PageLoading from '../components/PageLoading.svelte'

  // Development only (App.svelte registers this route when
  // import.meta.env.DEV is true, and the API behind it doesn't exist in
  // production). With MAIL_DRIVER=log, mails are recorded instead of sent,
  // so verification and password-reset links can be clicked from here.
  const logs = useMailLog()
  const mails = $derived($logs.mails)

  // A mail usually holds each link twice (href and text). The links are
  // made relative, so they open on this server whatever APP_URL says.
  // @if ts
  const linksIn = (body: string) =>
  // @endif
  // @if !ts
  const linksIn = (body) =>
  // @endif
    Array.from(new Set(String(body).match(/https?:\/\/[^\s"'<>]+/g) ?? [])).map((link) => ({
      label: link,
      href: link.replace(/^https?:\/\/[^/]+/, ''),
    }))
  // A fixed locale and time zone: with SSR, a date must read the same on the
  // server and in the visitor's browser, or hydration fails.
  const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' })
</script>

<div class="max-w-4xl mx-auto px-6 py-12">
  <div class="flex items-center justify-between mb-2">
    <h1 class="text-3xl font-semibold tracking-tight">Dev mail log</h1>
    <button
      type="button"
      onclick={() => logs.reload()}
      class="text-sm px-3.5 py-1.5 rounded-lg border border-line hover:bg-raised transition-colors"
    >
      Refresh
    </button>
  </div>
  <p class="text-sm text-muted mb-8">The last 50 mails, newest first. Only available in development.</p>

  {#if $logs.loading && mails.length === 0}
    <PageLoading compact label="Loading mail" />
  {:else if $logs.error}
    <p class="text-sm text-coral">{$logs.error}</p>
  {:else if mails.length === 0}
    <p class="text-sm text-muted">No mails yet.</p>
  {:else}
    <ul class="space-y-3" data-testid="mail-log">
      {#each mails as mail (mail.id)}
        <li class="tx-panel p-5">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-semibold">{mail.subject}</p>
              <p class="text-sm text-muted">To {mail.recipient}</p>
            </div>
            <p class="text-xs text-muted shrink-0">{dateFormat.format(new Date(mail.created_at))}</p>
          </div>
          <div class="mt-3 flex flex-col gap-1">
            {#each linksIn(mail.body) as link (link.href)}
              <a href={link.href} class="text-sm tx-link break-all">{link.label}</a>
            {/each}
          </div>
        </li>
      {/each}
    </ul>
  {/if}
</div>

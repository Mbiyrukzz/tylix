page Register

title "Create account"

needs
  Auth

state
  name: ""
  email: ""
  password: ""
  confirmPassword: ""
  agreedToTerms: false
  error: ""
  submitting: false
  registered: false

computed
  passwordsMatch() {
    return this.password is this.confirmPassword
  }

  passwordScore() {
    if this.password.length < 8 {
      return 0
    }

    const hasMixedCase = /[a-z]/.test(this.password) and /[A-Z]/.test(this.password)
    const hasDigit = /[0-9]/.test(this.password)
    const hasSymbol = /[^A-Za-z0-9]/.test(this.password)

    let score = 1
    if hasMixedCase {
      score += 1
    }
    if hasDigit {
      score += 1
    }
    if hasSymbol {
      score += 1
    }
    return score
  }

action
  setField(field, value) {
    this[field] = value
  }

  toggleTerms() {
    this.agreedToTerms = not this.agreedToTerms
  }

  validate() {
    const emailOk = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(this.email)

    if this.name.trim().length is 0 {
      return "Enter your name."
    }
    if not emailOk {
      return "Enter a valid email address."
    }
    if this.password.length < 8 {
      return "Password must be at least 8 characters."
    }
    if not this.passwordsMatch {
      return "Passwords don't match."
    }
    if not this.agreedToTerms {
      return "Please agree to the Terms of Service to continue."
    }
    return ""
  }

  messageFor(result) {
    switch result.status {
      case 409 {
        return "An account with this email already exists."
      }
      case 422 {
        const errors = result.data?.errors
        if errors {
          const firstField = Object.keys(errors)[0]
          return errors[firstField][0]
        }
        return "Check your details and try again."
      }
      case 429 {
        return "Too many attempts. Wait a minute and try again."
      }
      default {
        return result.error ?? "Could not create account. Check your details and try again."
      }
    }
  }

  async submit() {
    if this.submitting {
      return null
    }

    this.error = this.validate()
    if this.error {
      return null
    }

    this.submitting = true

    try {
      const result = await useApi("/api/register", {
        method: "POST",
        body: { name: this.name, email: this.email, password: this.password }
      })

      if result.ok {
        this.registered = true
      } else {
        this.error = this.messageFor(result)
      }
    } catch (err) {
      this.error = "Network error. Check your connection and try again."
    } finally {
      this.submitting = false
    }
  }

onMount
  {
    if Auth.user {
      window.location.href = "/dashboard"
    }
  }

template
  <div class="min-h-[calc(100vh-4rem)] flex items-center justify-center bg-slate-200 dark:bg-slate-950 transition-colors px-6 py-16">
    <div class="w-full max-w-4xl grid grid-cols-1 lg:grid-cols-2 rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 shadow-sm dark:shadow-none overflow-hidden">

      <div class="hidden lg:flex flex-col justify-between bg-slate-200 dark:bg-slate-950/60 border-r border-slate-300 dark:border-slate-800 p-10">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
          <span class="text-slate-800 dark:text-slate-200 font-semibold tracking-tight">Tylix</span>
        </a>

        <div class="rounded-2xl border border-slate-300 dark:border-slate-800 bg-slate-200 dark:bg-slate-900 p-5">
          <p class="text-slate-800 dark:text-slate-200 text-lg font-medium leading-snug mb-4">
            "Probably one of the best frameworks for JS. Building new projects has never been this easy."
          </p>
          <p class="text-slate-500 text-sm">Amara Osei — Full-stack developer</p>
        </div>

        <p class="text-slate-400 dark:text-slate-600 text-xs">© 2026 Tylix</p>
      </div>

      <div class="flex items-center justify-center px-6 py-12">
        <div class="w-full max-w-sm">
          <a href="/" class="lg:hidden flex items-center gap-2.5 justify-center mb-8">
            <img src="/logo-mark.png" alt="Tylix" class="w-7 h-7 rounded-md" />
            <span class="text-slate-800 dark:text-slate-200 font-semibold tracking-tight">Tylix</span>
          </a>

{{#if registered}}
          <div class="w-11 h-11 rounded-xl bg-emerald-500/10 flex items-center justify-center text-lg mb-5 text-emerald-700 dark:text-emerald-400">✓</div>
          <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-200 mb-2">Check your email</h1>
          <p class="text-slate-500 text-sm mb-8">
            We sent a verification link to <span class="text-slate-800 dark:text-slate-300">{{ email }}</span>.
            Click it, then log in below.
          </p>
          <a href="/login" class="inline-block w-full text-center bg-emerald-500 text-white dark:text-slate-950 rounded-full py-2.5 font-semibold shadow-sm hover:bg-emerald-400 hover:shadow transition-all">
            Go to Login
          </a>
{{/if}}

{{#if not registered}}
          <p class="text-emerald-700 dark:text-emerald-500 text-xs font-semibold uppercase tracking-wider mb-1">Get started</p>
          <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-200 mb-2">Create your account</h1>
          <p class="text-slate-500 text-sm mb-8">Start building with Tylix in under a minute.</p>

{{#if error}}
          <div role="alert" aria-live="polite" class="rounded-xl border border-rose-300 dark:border-rose-900/50 bg-rose-100 dark:bg-rose-950/30 px-4 py-3 mb-6">
            <p class="text-rose-700 dark:text-rose-400 text-sm">{{ error }}</p>
          </div>
{{/if}}

          <label for="name" class="block text-slate-500 dark:text-slate-400 text-xs font-medium mb-2">Name</label>
          <input
            id="name"
            name="name"
            autocomplete="name"
            autofocus
            placeholder="Jane Doe"
            value="{{ name }}"
            oninput="{{ setField('name', event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-800 dark:text-slate-200 rounded-xl px-4 py-2.5 mb-4 outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
          />

          <label for="email" class="block text-slate-500 dark:text-slate-400 text-xs font-medium mb-2">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="you@example.com"
            value="{{ email }}"
            oninput="{{ setField('email', event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-800 dark:text-slate-200 rounded-xl px-4 py-2.5 mb-4 outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
          />

          <label for="password" class="block text-slate-500 dark:text-slate-400 text-xs font-medium mb-2">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            placeholder="••••••••"
            value="{{ password }}"
            oninput="{{ setField('password', event.target.value) }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-800 dark:text-slate-200 rounded-xl px-4 py-2.5 mb-2 outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
          />

{{#if password.length > 0}}
          <div class="flex gap-1.5 mb-1.5">
{{#each n in [0, 1, 2, 3]}}
            <div class="{{ 'h-1 flex-1 rounded-full transition-colors ' + (n < passwordScore ? 'bg-emerald-500' : 'bg-slate-300 dark:bg-slate-700') }}"></div>
{{/each}}
          </div>
          <p class="text-slate-500 text-xs mb-4">{{ ['Too short', 'Weak', 'Okay', 'Good', 'Strong'][passwordScore] }}</p>
{{/if}}
{{#if password.length is 0}}
          <p class="text-slate-400 dark:text-slate-600 text-xs mb-4">At least 8 characters.</p>
{{/if}}

          <label for="confirmPassword" class="block text-slate-500 dark:text-slate-400 text-xs font-medium mb-2">Confirm password</label>
          <input
            id="confirmPassword"
            name="confirmPassword"
            type="password"
            autocomplete="new-password"
            placeholder="••••••••"
            value="{{ confirmPassword }}"
            oninput="{{ setField('confirmPassword', event.target.value) }}"
            onkeydown="{{ event.key is 'Enter' and submit() }}"
            class="w-full border border-slate-300 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-slate-800 dark:text-slate-200 rounded-xl px-4 py-2.5 mb-2 outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
          />
{{#if confirmPassword.length > 0 and not passwordsMatch}}
          <p class="text-rose-700 dark:text-rose-400 text-xs mb-3">Passwords don't match.</p>
{{/if}}

          <label class="flex items-start gap-2.5 text-sm text-slate-500 dark:text-slate-400 my-5">
            <input
              type="checkbox"
              checked="{{ agreedToTerms }}"
              onclick="{{ toggleTerms() }}"
              class="mt-0.5 rounded border-slate-300 dark:border-slate-700 bg-slate-200 dark:bg-slate-950 text-emerald-500 focus:ring-emerald-500"
            />
            <span>
              I agree to the
              <a href="https://tylix.dev/terms" class="text-emerald-700 dark:text-emerald-400 hover:underline">Terms of Service</a>
              and
              <a href="https://tylix.dev/privacy" class="text-emerald-700 dark:text-emerald-400 hover:underline">Privacy Policy</a>.
            </span>
          </label>

          <button
            onclick="{{ submit() }}"
            disabled="{{ submitting }}"
            class="w-full bg-emerald-500 text-white dark:text-slate-950 rounded-full py-2.5 font-semibold shadow-sm hover:bg-emerald-400 hover:shadow transition-all disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {{ submitting ? 'Creating account…' : 'Sign Up' }}
          </button>

          <p class="text-sm text-slate-500 text-center mt-6">
            Already have an account? <a href="/login" class="text-emerald-700 dark:text-emerald-400 hover:underline">Log in</a>
          </p>
{{/if}}
        </div>
      </div>
    </div>
  </div>
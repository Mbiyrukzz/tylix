<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>__APP_NAME__</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <!-- Served by Tylix from public/. Your own rules go in public/styles.css. -->
  <link rel="stylesheet" href="/styles.css" vite-ignore>
  <script>
    // Applies the saved color theme before the first paint, so dark mode
    // never flashes white on load.
    try {
      var saved = localStorage.getItem('theme')
      if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark')
      }
    } catch (e) {}
  </script>
</head>
<body>
  <div id="app"><!--ssr-outlet--></div>
  <script type="module" src="/__ENTRY__"></script>
</body>
</html>

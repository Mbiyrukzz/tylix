<script setup__LANG__>
import { ref } from 'vue'
import { useAuth, useHydrated } from '@tylix/vue'
import { firstError } from '@tylix/shared/validation'
import { validateForgotPassword } from '../../validators/AuthValidator'

const { forgotPassword } = useAuth()
const isDev = import.meta.env.DEV

const email = ref('')
const error = ref('')
const submitting = ref(false)
const sent = ref(false)

async function submit() {
  if (submitting.value) return
  const problem = firstError(validateForgotPassword({ email: email.value }))
  if (problem) {
    error.value = problem
    return
  }
  error.value = ''
  submitting.value = true
  const result = await forgotPassword(email.value)
  submitting.value = false

  // The server answers the same way whether or not the email is
  // registered, so this page can't be used to find out who has an account.
  if (result.ok) sent.value = true
  else if (result.status === 429) error.value = 'Too many requests. Wait a minute and try again.'
  else if (result.status === 0) error.value = 'Network error. Check your connection and try again.'
  else error.value = result.error ?? 'Could not send the reset link. Try again.'
}

// Submitting before hydration would reload the page; see useHydrated.
const hydrated = useHydrated()
</script>

<template>
  <div class="flex items-center justify-center px-6 py-16">
    <div class="tx-card tx-glow">
      <div v-if="sent" data-testid="reset-sent">
        <h1 class="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
        <p class="text-sm text-muted mb-6">
          If <span class="text-ink">{{ email }}</span> has an account, a link to reset the password is on its way.
        </p>
        <p v-if="isDev" class="text-xs text-muted mb-6">
          No mail server yet? <RouterLink to="/dev/mail" class="tx-link">Open the dev mail log</RouterLink>
        </p>
        <RouterLink to="/login" class="text-sm tx-link">Back to login</RouterLink>
      </div>

      <form v-else novalidate @submit.prevent="submit">
        <h1 class="text-2xl font-semibold tracking-tight mb-1">Forgot your password?</h1>
        <p class="text-sm text-muted mb-6">We'll email you a link to choose a new one.</p>

        <div v-if="error" role="alert" class="tx-alert tx-alert-error mb-6">
          <p class="text-sm">{{ error }}</p>
        </div>

        <label for="email" class="tx-label">Email</label>
        <input
          id="email"
          v-model="email"
          type="email"
          autocomplete="email"
          autofocus
          class="tx-input"
        />
        <button
          type="submit"
          :disabled="submitting || !hydrated"
          class="tx-btn tx-btn-primary tx-btn-block"
        >
          {{ submitting ? 'Sending…' : 'Send reset link' }}
        </button>
        <p class="text-sm text-muted text-center mt-6">
          <RouterLink to="/login" class="tx-link">Back to login</RouterLink>
        </p>
      </form>
    </div>
  </div>
</template>

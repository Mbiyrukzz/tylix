<script setup__LANG__>
import { computed, ref } from 'vue'
import { useAuth, useHydrated } from '@tylix/vue'
import OAuthButtons from '../components/OAuthButtons.vue'
import { firstError } from '@tylix/shared/validation'
import { MIN_PASSWORD_LENGTH, validateRegister } from '../../validators/AuthValidator'

const inputClass =
  'tx-input'

const perks = [
  'Auth, database and styling already wired',
  'Vue on the front, Tylix on the back',
  'Generate new features with one command',
]
const strengthLabels = ['Too short', 'Weak', 'Fair', 'Good', 'Strong']
const isDev = import.meta.env.DEV

const { register } = useAuth()

const name = ref('')
const email = ref('')
const password = ref('')
const confirmPassword = ref('')
const agreed = ref(false)
const error = ref('')
const submitting = ref(false)
const registered = ref(false)

const score = computed(() => {
  const value = password.value
  if (value.length < MIN_PASSWORD_LENGTH) return 0
  let points = 1
  if (/[a-z]/.test(value) && /[A-Z]/.test(value)) points++
  if (/[0-9]/.test(value)) points++
  if (/[^A-Za-z0-9]/.test(value)) points++
  return points
})

function validate() {
  // The same rules the API checks (app/validators/AuthValidator).
  const problem = firstError(validateRegister({ name: name.value.trim(), email: email.value, password: password.value }))
  if (problem) return problem
  if (password.value !== confirmPassword.value) return "Passwords don't match."
  if (!agreed.value) return 'Please agree to the Terms of Service to continue.'
  return ''
}

async function submit() {
  if (submitting.value) return
  error.value = validate()
  if (error.value) return

  submitting.value = true
  const result = await register({ name: name.value.trim(), email: email.value, password: password.value })
  submitting.value = false

  if (result.ok) registered.value = true
  else if (result.status === 429) error.value = 'Too many attempts. Wait a minute and try again.'
  else if (result.status === 0) error.value = 'Network error. Check your connection and try again.'
  else error.value = result.error ?? 'Could not create account. Check your details and try again.'
}

// Submitting before hydration would reload the page; see useHydrated.
const hydrated = useHydrated()
</script>

<template>
  <div class="flex items-center justify-center px-6 py-16">
    <div class="tx-auth tx-glow">
      <div class="tx-auth-aside">
        <p class="tx-eyebrow mb-5">New account</p>
        <h2 class="text-2xl font-semibold tracking-tight mb-3">Create your account</h2>
        <p class="text-sm text-muted mb-8 leading-relaxed">It takes less than a minute.</p>
        <ul class="space-y-3">
          <li v-for="perk in perks" :key="perk" class="flex items-start gap-2.5 text-sm text-soft">
            <span class="text-mint">✓</span>
            {{ perk }}
          </li>
        </ul>
      </div>

      <div class="tx-auth-form">
        <div v-if="registered" class="w-full max-w-sm" data-testid="registered">
          <div class="w-11 h-11 rounded-lg bg-brand/10 flex items-center justify-center mb-5 text-link">✓</div>
          <h1 class="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
          <p class="text-sm text-muted mb-8">
            We sent a verification link to <span class="text-ink">{{ email }}</span>. Click it, then log in.
          </p>
          <RouterLink
            to="/login"
            class="tx-btn tx-btn-primary tx-btn-block"
          >
            Go to login
          </RouterLink>
          <p v-if="isDev" class="text-xs text-muted text-center mt-4">
            No mail server yet? <RouterLink to="/dev/mail" class="tx-link">Open the dev mail log</RouterLink>
          </p>
        </div>

        <form v-else class="w-full max-w-sm" novalidate @submit.prevent="submit">
          <h1 class="text-2xl font-semibold tracking-tight mb-1">Create account</h1>
          <p class="text-sm text-muted mb-8">Start building with Tylix.</p>

          <div v-if="error" role="alert" aria-live="polite" class="tx-alert tx-alert-error mb-6">
            <p class="text-sm">{{ error }}</p>
          </div>

          <OAuthButtons />

          <label for="name" class="tx-label">Name</label>
          <input id="name" v-model="name" name="name" autocomplete="name" autofocus :class="inputClass" />

          <label for="email" class="tx-label">Email</label>
          <input id="email" v-model="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" :class="inputClass" />

          <label for="password" class="tx-label">Password</label>
          <input id="password" v-model="password" name="password" type="password" autocomplete="new-password" :class="inputClass" />
          <p v-if="password" class="-mt-3 mb-4 text-xs text-muted">Strength: {{ strengthLabels[score] }}</p>

          <label for="confirmPassword" class="tx-label">Confirm password</label>
          <input id="confirmPassword" v-model="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" :class="inputClass" />

          <label class="flex items-center gap-2 text-sm text-muted mb-6">
            <input v-model="agreed" type="checkbox" name="terms" class="rounded border-line-strong" />
            I agree to the Terms of Service
          </label>

          <button
            type="submit"
            :disabled="submitting || !hydrated"
            class="tx-btn tx-btn-primary tx-btn-block"
          >
            {{ submitting ? 'Creating account…' : 'Create account' }}
          </button>

          <p class="text-sm text-muted text-center mt-6">
            Already have an account? <RouterLink to="/login" class="tx-link">Log in</RouterLink>
          </p>
        </form>
      </div>
    </div>
  </div>
</template>

<script setup__LANG__>
import { computed, ref } from 'vue'
import { useAuth, useHydrated } from '@tylix/vue'

const inputClass =
  'w-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 rounded-md px-3.5 py-2.5 mb-4 text-sm outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition'

const perks = [
  'Auth, database and styling already wired',
  'Vue on the front, Tylix on the back',
  'Generate new features with one command',
]
const strengthLabels = ['Too short', 'Weak', 'Fair', 'Good', 'Strong']
const isDev = import.meta.env.DEV

const { register } = useAuth()

const name = ref('')
const email = ref('')
const password = ref('')
const confirmPassword = ref('')
const agreed = ref(false)
const error = ref('')
const submitting = ref(false)
const registered = ref(false)

const score = computed(() => {
  const value = password.value
  if (value.length < 8) return 0
  let points = 1
  if (/[a-z]/.test(value) && /[A-Z]/.test(value)) points++
  if (/[0-9]/.test(value)) points++
  if (/[^A-Za-z0-9]/.test(value)) points++
  return points
})

function validate() {
  if (name.value.trim().length === 0) return 'Enter your name.'
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email.value)) return 'Enter a valid email address.'
  if (password.value.length < 8) return 'Password must be at least 8 characters.'
  if (password.value !== confirmPassword.value) return "Passwords don't match."
  if (!agreed.value) return 'Please agree to the Terms of Service to continue.'
  return ''
}

async function submit() {
  if (submitting.value) return
  error.value = validate()
  if (error.value) return

  submitting.value = true
  const result = await register({ name: name.value.trim(), email: email.value, password: password.value })
  submitting.value = false

  if (result.ok) registered.value = true
  else if (result.status === 429) error.value = 'Too many attempts. Wait a minute and try again.'
  else if (result.status === 0) error.value = 'Network error. Check your connection and try again.'
  else error.value = result.error ?? 'Could not create account. Check your details and try again.'
}

// Submitting before hydration would reload the page; see useHydrated.
const hydrated = useHydrated()
</script>

<template>
  <div class="flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-4xl grid grid-cols-1 lg:grid-cols-2 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden">
      <div class="hidden lg:flex flex-col justify-center border-r border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/60 p-10">
        <h2 class="text-2xl font-semibold tracking-tight mb-3">Create your account</h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-8 leading-relaxed">It takes less than a minute.</p>
        <ul class="space-y-3">
          <li v-for="perk in perks" :key="perk" class="flex items-start gap-2.5 text-sm text-zinc-600 dark:text-zinc-300">
            <span class="text-emerald-500">✓</span>
            {{ perk }}
          </li>
        </ul>
      </div>

      <div class="flex items-center justify-center px-6 py-12">
        <div v-if="registered" class="w-full max-w-sm" data-testid="registered">
          <div class="w-11 h-11 rounded-md bg-emerald-500/10 flex items-center justify-center mb-5 text-emerald-600">✓</div>
          <h1 class="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
          <p class="text-sm text-zinc-500 mb-8">
            We sent a verification link to <span class="text-zinc-900 dark:text-zinc-200">{{ email }}</span>. Click it, then log in.
          </p>
          <RouterLink
            to="/login"
            class="inline-block w-full text-center bg-emerald-500 text-white dark:text-zinc-950 rounded-md py-2.5 text-sm font-semibold hover:bg-emerald-400 transition-colors"
          >
            Go to login
          </RouterLink>
          <p v-if="isDev" class="text-xs text-zinc-500 text-center mt-4">
            No mail server yet? <RouterLink to="/dev/mail" class="text-emerald-600 dark:text-emerald-400 hover:underline">Open the dev mail log</RouterLink>
          </p>
        </div>

        <form v-else class="w-full max-w-sm" novalidate @submit.prevent="submit">
          <h1 class="text-2xl font-semibold tracking-tight mb-1">Create account</h1>
          <p class="text-sm text-zinc-500 mb-8">Start building with Tylix.</p>

          <div v-if="error" role="alert" aria-live="polite" class="rounded-md border border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
            <p class="text-rose-700 dark:text-rose-400 text-sm">{{ error }}</p>
          </div>

          <label for="name" class="block text-zinc-500 text-xs font-medium mb-1.5">Name</label>
          <input id="name" v-model="name" name="name" autocomplete="name" autofocus :class="inputClass" />

          <label for="email" class="block text-zinc-500 text-xs font-medium mb-1.5">Email</label>
          <input id="email" v-model="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" :class="inputClass" />

          <label for="password" class="block text-zinc-500 text-xs font-medium mb-1.5">Password</label>
          <input id="password" v-model="password" name="password" type="password" autocomplete="new-password" :class="inputClass" />
          <p v-if="password" class="-mt-3 mb-4 text-xs text-zinc-500">Strength: {{ strengthLabels[score] }}</p>

          <label for="confirmPassword" class="block text-zinc-500 text-xs font-medium mb-1.5">Confirm password</label>
          <input id="confirmPassword" v-model="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" :class="inputClass" />

          <label class="flex items-center gap-2 text-sm text-zinc-500 mb-6">
            <input v-model="agreed" type="checkbox" name="terms" class="rounded border-zinc-300 dark:border-zinc-700" />
            I agree to the Terms of Service
          </label>

          <button
            type="submit"
            :disabled="submitting || !hydrated"
            class="w-full bg-emerald-500 text-white dark:text-zinc-950 rounded-md py-2.5 text-sm font-semibold hover:bg-emerald-400 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {{ submitting ? 'Creating account…' : 'Create account' }}
          </button>

          <p class="text-sm text-zinc-500 text-center mt-6">
            Already have an account? <RouterLink to="/login" class="text-emerald-600 dark:text-emerald-400 hover:underline">Log in</RouterLink>
          </p>
        </form>
      </div>
    </div>
  </div>
</template>

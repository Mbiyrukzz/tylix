<script setup__LANG__>
import { usePost } from '../providers/posts'
import PageLoading from '../components/PageLoading.vue'

// The post for this URL's :id (providers/posts).
const { post, notFound, loading, error } = usePost()
// A fixed locale and time zone: with SSR, a date must read the same on the
// server and in the visitor's browser, or hydration fails.
const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' })
</script>

<template>
  <article class="max-w-3xl mx-auto px-6 py-12">
    <RouterLink to="/posts" class="text-sm tx-link">← All posts</RouterLink>
    <PageLoading v-if="loading && !post" label="Loading post" />
    <div v-else-if="notFound" class="mt-8">
      <h1 class="text-2xl font-semibold">Post not found</h1>
      <p class="text-sm text-muted mt-2">It may have been deleted.</p>
    </div>
    <p v-else-if="error" class="text-sm text-coral mt-8">{{ error }}</p>
    <template v-else-if="post">
      <h1 class="text-4xl font-semibold tracking-tight mt-6 mb-3" data-testid="post-title">{{ post.title }}</h1>
      <p class="text-sm text-muted mb-8">{{ post.author }} · {{ dateFormat.format(new Date(post.created_at)) }}</p>
      <div class="text-soft leading-relaxed whitespace-pre-line">{{ post.body }}</div>
    </template>
  </article>
</template>

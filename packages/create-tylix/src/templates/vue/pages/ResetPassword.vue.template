<script setup__LANG__>
import { computed, ref } from 'vue'
import { useRoute } from 'vue-router'
import { useAuth, useHydrated } from '@tylix/vue'

const inputClass =
  'w-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 rounded-md px-3.5 py-2.5 mb-4 text-sm outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition'
const card = 'w-full max-w-sm rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-8'

const route = useRoute()
const { resetPassword } = useAuth()

// Opened from the link in the reset email:
//   /reset-password?token=...&email=...
const token = computed(() => (typeof route.query.token === 'string' ? route.query.token : ''))
const email = computed(() => (typeof route.query.email === 'string' ? route.query.email : ''))

const password = ref('')
const confirmPassword = ref('')
const error = ref('')
const submitting = ref(false)
const done = ref(false)

async function submit() {
  if (submitting.value) return
  if (password.value.length < 8) {
    error.value = 'Password must be at least 8 characters.'
    return
  }
  if (password.value !== confirmPassword.value) {
    error.value = "Passwords don't match."
    return
  }
  error.value = ''
  submitting.value = true
  const result = await resetPassword({ email: email.value, token: token.value, password: password.value })
  submitting.value = false

  if (result.ok) done.value = true
  else if (result.status === 0) error.value = 'Network error. Check your connection and try again.'
  else error.value = result.error ?? 'Could not reset the password. Try again.'
}

// Submitting before hydration would reload the page; see useHydrated.
const hydrated = useHydrated()
</script>

<template>
  <div class="flex items-center justify-center px-6 py-16">
    <div :class="card">
      <template v-if="!token || !email">
        <h1 class="text-2xl font-semibold tracking-tight mb-2">This link is incomplete</h1>
        <p class="text-sm text-zinc-500 mb-6">Open the link from the email again, or ask for a new one.</p>
        <RouterLink to="/forgot-password" class="text-sm text-emerald-600 dark:text-emerald-400 hover:underline">Request a new link</RouterLink>
      </template>

      <div v-else-if="done" data-testid="reset-done">
        <h1 class="text-2xl font-semibold tracking-tight mb-2">Password updated</h1>
        <p class="text-sm text-zinc-500 mb-6">For your security, every device was logged out. Log in with your new password.</p>
        <RouterLink
          to="/login"
          class="inline-block w-full text-center bg-emerald-500 text-white dark:text-zinc-950 rounded-md py-2.5 text-sm font-semibold hover:bg-emerald-400 transition-colors"
        >
          Go to login
        </RouterLink>
      </div>

      <form v-else novalidate @submit.prevent="submit">
        <h1 class="text-2xl font-semibold tracking-tight mb-1">Choose a new password</h1>
        <p class="text-sm text-zinc-500 mb-6">For {{ email }}</p>

        <div v-if="error" role="alert" class="rounded-md border border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
          <p class="text-rose-700 dark:text-rose-400 text-sm">{{ error }}</p>
        </div>

        <label for="password" class="block text-zinc-500 text-xs font-medium mb-1.5">New password</label>
        <input id="password" v-model="password" type="password" autocomplete="new-password" autofocus :class="inputClass" />

        <label for="confirmPassword" class="block text-zinc-500 text-xs font-medium mb-1.5">Confirm new password</label>
        <input id="confirmPassword" v-model="confirmPassword" type="password" autocomplete="new-password" :class="inputClass" />

        <button
          type="submit"
          :disabled="submitting || !hydrated"
          class="w-full bg-emerald-500 text-white dark:text-zinc-950 rounded-md py-2.5 text-sm font-semibold hover:bg-emerald-400 transition-colors disabled:opacity-50"
        >
          {{ submitting ? 'Saving…' : 'Update password' }}
        </button>
      </form>
    </div>
  </div>
</template>

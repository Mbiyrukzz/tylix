<script setup__LANG__>
import { computed, ref } from 'vue'
import { useRoute } from 'vue-router'
import { useAuth, useHydrated } from '@tylix/vue'
import { firstError } from '@tylix/shared/validation'
import { validateResetPassword } from '../../validators/AuthValidator'

const inputClass =
  'tx-input'
const card = 'tx-card tx-glow'

const route = useRoute()
const { resetPassword } = useAuth()

// Opened from the link in the reset email:
//   /reset-password?token=...&email=...
const token = computed(() => (typeof route.query.token === 'string' ? route.query.token : ''))
const email = computed(() => (typeof route.query.email === 'string' ? route.query.email : ''))

const password = ref('')
const confirmPassword = ref('')
const error = ref('')
const submitting = ref(false)
const done = ref(false)

async function submit() {
  if (submitting.value) return
  const problem = firstError(validateResetPassword({ email: email.value, token: token.value, password: password.value }))
  if (problem) {
    error.value = problem
    return
  }
  if (password.value !== confirmPassword.value) {
    error.value = "Passwords don't match."
    return
  }
  error.value = ''
  submitting.value = true
  const result = await resetPassword({ email: email.value, token: token.value, password: password.value })
  submitting.value = false

  if (result.ok) done.value = true
  else if (result.status === 0) error.value = 'Network error. Check your connection and try again.'
  else error.value = result.error ?? 'Could not reset the password. Try again.'
}

// Submitting before hydration would reload the page; see useHydrated.
const hydrated = useHydrated()
</script>

<template>
  <div class="flex items-center justify-center px-6 py-16">
    <div :class="card">
      <template v-if="!token || !email">
        <h1 class="text-2xl font-semibold tracking-tight mb-2">This link is incomplete</h1>
        <p class="text-sm text-muted mb-6">Open the link from the email again, or ask for a new one.</p>
        <RouterLink to="/forgot-password" class="text-sm tx-link">Request a new link</RouterLink>
      </template>

      <div v-else-if="done" data-testid="reset-done">
        <h1 class="text-2xl font-semibold tracking-tight mb-2">Password updated</h1>
        <p class="text-sm text-muted mb-6">For your security, every device was logged out. Log in with your new password.</p>
        <RouterLink
          to="/login"
          class="tx-btn tx-btn-primary tx-btn-block"
        >
          Go to login
        </RouterLink>
      </div>

      <form v-else novalidate @submit.prevent="submit">
        <h1 class="text-2xl font-semibold tracking-tight mb-1">Choose a new password</h1>
        <p class="text-sm text-muted mb-6">For {{ email }}</p>

        <div v-if="error" role="alert" class="tx-alert tx-alert-error mb-6">
          <p class="text-sm">{{ error }}</p>
        </div>

        <label for="password" class="tx-label">New password</label>
        <input id="password" v-model="password" type="password" autocomplete="new-password" autofocus :class="inputClass" />

        <label for="confirmPassword" class="tx-label">Confirm new password</label>
        <input id="confirmPassword" v-model="confirmPassword" type="password" autocomplete="new-password" :class="inputClass" />

        <button
          type="submit"
          :disabled="submitting || !hydrated"
          class="tx-btn tx-btn-primary tx-btn-block"
        >
          {{ submitting ? 'Saving…' : 'Update password' }}
        </button>
      </form>
    </div>
  </div>
</template>

<script setup__LANG__>
import { IconMail, IconServer, IconShieldCheck } from 'tylix-icons/vue'
import { useAuth, useHydrated } from '@tylix/vue'
// @if posts
import { ref } from 'vue'
import { useMyPosts } from '../providers/posts'

// Your posts (providers/posts): the list plus create and remove, which
// reload it. Only the logged-in user's posts.
const { posts, loading: postsLoading, error: postsError, create: createPost, remove: removePost } = useMyPosts()

const title = ref('')
const body = ref('')
const error = ref('')
const saving = ref(false)

async function create() {
  if (saving.value) return
  if (!title.value.trim() || !body.value.trim()) {
    error.value = 'Give the post a title and some text.'
    return
  }
  saving.value = true
  const problem = await createPost({ title: title.value.trim(), body: body.value.trim() })
  saving.value = false
  if (problem) {
    error.value = problem
    return
  }
  error.value = ''
  title.value = ''
  body.value = ''
}

// @if ts
async function remove(id: number) {
// @endif
// @if !ts
async function remove(id) {
// @endif
  const problem = await removePost(id)
  if (problem) error.value = problem
}
// @endif

const { user } = useAuth()
const cardClass = 'rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5'

// Submitting before hydration would reload the page; see useHydrated.
const hydrated = useHydrated()
</script>

<template>
  <div class="max-w-6xl mx-auto px-6 py-12">
    <p class="text-sm text-zinc-500 mb-1">Signed in as</p>
    <h1 class="text-3xl font-semibold tracking-tight mb-8" data-testid="dashboard-name">{{ user?.name }}</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
      <div :class="cardClass">
        <IconMail class="w-4 h-4 text-emerald-500 mb-3" />
        <p class="text-xs text-zinc-500 mb-1">Email</p>
        <p class="text-sm font-semibold truncate">{{ user?.email }}</p>
      </div>
      <div :class="cardClass">
        <IconShieldCheck class="w-4 h-4 text-emerald-500 mb-3" />
        <p class="text-xs text-zinc-500 mb-1">Session</p>
        <p class="text-sm font-semibold">httpOnly cookie, refreshed automatically</p>
      </div>
      <div :class="cardClass">
        <IconServer class="w-4 h-4 text-emerald-500 mb-3" />
        <p class="text-xs text-zinc-500 mb-1">Protected API</p>
        <p class="text-sm font-semibold">GET /api/me</p>
      </div>
    </div>
    <!-- @if posts -->

    <section>
      <h2 class="text-xl font-semibold tracking-tight mb-4">Your posts</h2>

      <form :class="[cardClass, 'mb-6']" @submit.prevent="create">
        <p v-if="error" role="alert" class="text-rose-600 dark:text-rose-400 text-sm mb-3">{{ error }}</p>
        <input
          v-model="title"
          name="title"
          placeholder="Title"
          class="w-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 rounded-md px-3.5 py-2.5 mb-3 text-sm outline-none focus:ring-2 focus:ring-emerald-500/40"
        />
        <textarea
          v-model="body"
          name="body"
          placeholder="Write something…"
          rows="3"
          class="w-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 rounded-md px-3.5 py-2.5 mb-3 text-sm outline-none focus:ring-2 focus:ring-emerald-500/40"
        ></textarea>
        <button
          type="submit"
          :disabled="saving || !hydrated"
          class="px-4 py-2 rounded-md bg-emerald-500 text-white dark:text-zinc-950 text-sm font-semibold hover:bg-emerald-400 transition-colors disabled:opacity-50"
        >
          {{ saving ? 'Saving…' : 'Publish post' }}
        </button>
      </form>

      <p v-if="postsLoading && posts.length === 0" class="text-sm text-zinc-500">Loading posts…</p>
      <p v-else-if="postsError" class="text-sm text-rose-600">{{ postsError }}</p>
      <ul v-else-if="posts.length > 0" class="space-y-3" data-testid="posts">
        <li v-for="post in posts" :key="post.id" :class="[cardClass, 'flex items-start justify-between gap-4']">
          <div>
            <p class="font-semibold">{{ post.title }}</p>
            <p class="text-sm text-zinc-500 mt-1 whitespace-pre-line">{{ post.body }}</p>
          </div>
          <button type="button" class="text-sm text-zinc-500 hover:text-rose-600 transition-colors" @click="remove(post.id)">
            Delete
          </button>
        </li>
      </ul>
      <p v-else class="text-sm text-zinc-500">No posts yet. Publish your first one above.</p>
    </section>
    <!-- @endif -->
  </div>
</template>

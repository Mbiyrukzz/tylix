import { computed, inject, provide } from 'vue'
// @if ts
import type { InjectionKey } from 'vue'
// @endif
import { useRoute } from 'vue-router'
import { useApi } from '@tylix/vue'
import { postUrls, postsService } from '../services/posts'
// @if ts
import type { Post, PostInput, PublicPost, PublicPostDetail } from '../services/posts'
// @endif

// Post data for the pages. A page calls usePublicPosts(), usePost() or
// useMyPosts() and gets refs and actions; the URLs stay in services/posts.
//
// The first component that calls one (usually the page) loads the data
// and provide()s it; components inside it that call the same function
// inject() that instance instead of loading again. With SSR the data is
// loaded on the server and reused in the browser.

// @if ts
function shared<T>(key: InjectionKey<T>, create: () => T): T {
// @endif
// @if !ts
function shared(key, create) {
// @endif
  const existing = inject(key, null)
  if (existing) return existing
  const value = create()
  provide(key, value)
  return value
}

// ---- Everyone's posts (/posts) ----------------------------------------

function createPublicPosts() {
// @if ts
  const result = useApi<PublicPost[]>(postUrls.publicList)
// @endif
// @if !ts
  const result = useApi(postUrls.publicList)
// @endif
  return {
    posts: computed(() => result.data.value ?? []),
    loading: result.loading,
    error: result.error,
    reload: result.reload,
  }
}
// @if ts
const PUBLIC_POSTS: InjectionKey<ReturnType<typeof createPublicPosts>> = Symbol('publicPosts')
// @endif
// @if !ts
const PUBLIC_POSTS = Symbol('publicPosts')
// @endif

export function usePublicPosts() {
  return shared(PUBLIC_POSTS, createPublicPosts)
}

// ---- One post (/posts/:id) --------------------------------------------

function createPost() {
  const route = useRoute()
  // A getter, so moving to another post loads it.
// @if ts
  const result = useApi<PublicPostDetail>(() => postUrls.publicOne(String(route.params.id)))
// @endif
// @if !ts
  const result = useApi(() => postUrls.publicOne(route.params.id))
// @endif
  return {
    post: result.data,
    notFound: computed(() => result.status.value === 404),
    loading: result.loading,
    error: result.error,
    reload: result.reload,
  }
}
// @if ts
const POST: InjectionKey<ReturnType<typeof createPost>> = Symbol('post')
// @endif
// @if !ts
const POST = Symbol('post')
// @endif

export function usePost() {
  return shared(POST, createPost)
}

// ---- The logged-in user's posts (/dashboard) --------------------------

// Writes reload the list afterwards and return null or the error to show.
function createMyPosts() {
// @if ts
  const result = useApi<Post[]>(postUrls.mine)

  async function create(input: PostInput) {
// @endif
// @if !ts
  const result = useApi(postUrls.mine)

  async function create(input) {
// @endif
    const saved = await postsService.create(input)
    if (!saved.ok) return saved.error ?? 'Could not save the post.'
    await result.reload()
    return null
  }

// @if ts
  async function remove(id: number) {
// @endif
// @if !ts
  async function remove(id) {
// @endif
    const removed = await postsService.remove(id)
    if (!removed.ok) return removed.error ?? 'Could not delete the post.'
    await result.reload()
    return null
  }

  return {
    posts: computed(() => result.data.value ?? []),
    loading: result.loading,
    error: result.error,
    reload: result.reload,
    create,
    remove,
  }
}
// @if ts
const MY_POSTS: InjectionKey<ReturnType<typeof createMyPosts>> = Symbol('myPosts')
// @endif
// @if !ts
const MY_POSTS = Symbol('myPosts')
// @endif

export function useMyPosts() {
  return shared(MY_POSTS, createMyPosts)
}

<script setup__LANG__>
import { computed, onMounted, ref } from 'vue'

// "Continue with Google / GitHub". Each button is a plain link to the
// server, which sends the browser to the provider and back
// (app/controllers/AuthController: oauthStart / oauthCallback). Set the
// provider's keys in .env; remove a button you don't want.

// @if ts
const props = withDefaults(defineProps<{ returnTo?: string }>(), { returnTo: '/dashboard' })
// @endif
// @if !ts
const props = defineProps({ returnTo: { type: String, default: '/dashboard' } })
// @endif

// A failed social sign-in comes back as /login?error=<code>.
// @if ts
const MESSAGES: Record<string, string> = {
// @endif
// @if !ts
const MESSAGES = {
// @endif
  oauth_cancelled: 'Sign-in was cancelled.',
  oauth_failed: 'Could not sign you in with that provider. Try again.',
  oauth_unavailable: "That sign-in option isn't set up yet.",
  oauth_unknown: "That sign-in option isn't available.",
  oauth_no_email: 'That account has no email address we can use.',
  oauth_email_unverified: 'Verify your email address with that provider first, then try again.',
  oauth_rate_limited: 'Too many sign-in attempts. Wait a few minutes and try again.',
}

const error = ref('')
const query = computed(() => `?returnTo=${encodeURIComponent(props.returnTo)}`)

onMounted(() => {
  const code = new URLSearchParams(window.location.search).get('error') ?? ''
  error.value = Object.prototype.hasOwnProperty.call(MESSAGES, code) ? MESSAGES[code] : ''
})
</script>

<template>
  <div v-if="error" role="alert" aria-live="polite" class="tx-alert tx-alert-error mb-6">
    <p class="text-sm">{{ error }}</p>
  </div>
  <div class="tx-oauth-row">
    <a :href="`/api/auth/oauth/google${query}`" class="tx-oauth" aria-label="Continue with Google">
      <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2A11.9 11.9 0 0 1 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3a12 12 0 0 1-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>
      Google
    </a>
    <a :href="`/api/auth/oauth/github${query}`" class="tx-oauth" aria-label="Continue with GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.73 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
      GitHub
    </a>
  </div>
  <div class="tx-or">or</div>
</template>

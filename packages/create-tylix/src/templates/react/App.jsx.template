import { Route, Routes } from 'react-router'
// @if auth
import { GuestOnly, RequireAuth } from '@tylix/react'
import { RedirectAfterLogin, RedirectToLogin } from './components/Redirects'
// @endif
import Layout, { PageLoading } from './components/Layout'
import Home from './pages/Home'
// @if auth
import Login from './pages/Login'
import Register from './pages/Register'
import ForgotPassword from './pages/ForgotPassword'
import ResetPassword from './pages/ResetPassword'
import Dashboard from './pages/Dashboard'
import DevMail from './pages/DevMail'
// @endif
// @if posts
import Posts from './pages/Posts'
import PostDetail from './pages/PostDetail'
// @endif
// tylix:imports (make:page adds page imports above this line)
import NotFound from './pages/NotFound'

// Frontend routes only. Tylix serves the API (/api/*) itself, so those
// requests never reach this router.
//
// RequireAuth and GuestOnly decide what to show. They don't protect data:
// the API routes behind requireAuth do. The server also redirects guests
// away from the paths in frontend.protected (tylix.config) before any
// HTML is sent.
export default function App() {
  return (
    <Routes>
      <Route element={<Layout />}>
        <Route index element={<Home />} />
        {/* @if posts */}
        <Route path="posts" element={<Posts />} />
        <Route path="posts/:id" element={<PostDetail />} />
        {/* @endif */}
        {/* @if auth */}
        <Route
          path="login"
          element={
            <GuestOnly fallback={<RedirectAfterLogin />} loading={<PageLoading />}>
              <Login />
            </GuestOnly>
          }
        />
        <Route
          path="register"
          element={
            <GuestOnly fallback={<RedirectAfterLogin />} loading={<PageLoading />}>
              <Register />
            </GuestOnly>
          }
        />
        <Route
          path="forgot-password"
          element={
            <GuestOnly fallback={<RedirectAfterLogin />} loading={<PageLoading />}>
              <ForgotPassword />
            </GuestOnly>
          }
        />
        {/* Not guarded: the link in the reset email must work in any state. */}
        <Route path="reset-password" element={<ResetPassword />} />
        <Route
          path="dashboard"
          element={
            <RequireAuth fallback={<RedirectToLogin />} loading={<PageLoading />}>
              <Dashboard />
            </RequireAuth>
          }
        />
        {/* Development only: the mails MAIL_DRIVER=log recorded, so you can
            click verification and reset links without a mail server. */}
        {import.meta.env.DEV && <Route path="dev/mail" element={<DevMail />} />}
        {/* @endif */}
        {/* tylix:routes (make:page adds routes above this line) */}
        <Route path="*" element={<NotFound />} />
      </Route>
    </Routes>
  )
}

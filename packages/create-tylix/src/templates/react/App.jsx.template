import AppProviders from './providers/AppProviders'
import AppRoutes from './AppRoutes'

// The app: shared providers around the routes. Pages and their URLs are in
// AppRoutes ("tylix make:page" adds new ones there); data comes from the
// providers in providers/, which use the API calls in services/.
export default function App() {
  return (
    <AppProviders>
      <AppRoutes />
    </AppProviders>
  )
}

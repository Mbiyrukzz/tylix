import { useMailLog } from '../providers/MailLogProvider'
import PageLoading from '../components/PageLoading'

// A fixed locale and time zone: with SSR, a date must read the same on the
// server and in the visitor's browser, or hydration fails.
const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' })

// Development only (AppRoutes registers this route when import.meta.env.DEV
// is true, and the API behind it doesn't exist in production). With
// MAIL_DRIVER=log, mails are recorded instead of sent, so verification and
// password-reset links can be clicked from here.
export default function DevMail() {
  const { mails, loading, error, reload } = useMailLog()

  return (
    <div className="max-w-4xl mx-auto px-6 py-12">
      <div className="flex items-center justify-between mb-2">
        <h1 className="text-3xl font-semibold tracking-tight">Dev mail log</h1>
        <button
          type="button"
          onClick={() => reload()}
          className="text-sm px-3.5 py-1.5 rounded-lg border border-line hover:bg-raised transition-colors"
        >
          Refresh
        </button>
      </div>
      <p className="text-sm text-muted mb-8">The last 50 mails, newest first. Only available in development.</p>

      {loading && mails.length === 0 ? (
        <PageLoading compact label="Loading mail" />
      ) : error ? (
        <p className="text-sm text-coral">{error}</p>
      ) : mails.length === 0 ? (
        <p className="text-sm text-muted">No mails yet.</p>
      ) : (
        <ul className="space-y-3" data-testid="mail-log">
          {mails.map((mail) => (
            <li key={mail.id} className="tx-panel p-5">
              <div className="flex items-start justify-between gap-4">
                <div>
                  <p className="font-semibold">{mail.subject}</p>
                  <p className="text-sm text-muted">To {mail.recipient}</p>
                </div>
                <p className="text-xs text-muted shrink-0">{dateFormat.format(new Date(mail.created_at))}</p>
              </div>
              <div className="mt-3 flex flex-col gap-1">
                {/* A mail usually holds each link twice (href and text). */}
                {Array.from(new Set(String(mail.body).match(/https?:\/\/[^\s"'<>]+/g) ?? [])).map((link) => (
                  // Opened on this server whatever APP_URL says, so the
                  // links work on any dev port.
                  <a
                    key={link}
                    href={link.replace(/^https?:\/\/[^/]+/, '')}
                    className="text-sm tx-link break-all"
                  >
                    {link}
                  </a>
                ))}
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}

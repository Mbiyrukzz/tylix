import { useState } from 'react'
import { Link } from 'react-router'
import { useAuth, useHydrated } from '@tylix/react'
import { firstError } from '@tylix/shared/validation'
import { MIN_PASSWORD_LENGTH, validateRegister } from '../../validators/AuthValidator'

const inputClass =
  'w-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 rounded-md px-3.5 py-2.5 mb-4 text-sm outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition'

const perks = [
  'Auth, database and styling already wired',
  'React on the front, Tylix on the back',
  'Generate new features with one command',
]

const strengthLabels = ['Too short', 'Weak', 'Fair', 'Good', 'Strong']

export default function Register() {
  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
  const { register } = useAuth()
  const [name, setName] = useState('')
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [confirmPassword, setConfirmPassword] = useState('')
  const [agreed, setAgreed] = useState(false)
  const [error, setError] = useState('')
  const [submitting, setSubmitting] = useState(false)
  const [registered, setRegistered] = useState(false)

  let score = 0
  if (password.length >= MIN_PASSWORD_LENGTH) {
    score = 1
    if (/[a-z]/.test(password) && /[A-Z]/.test(password)) score++
    if (/[0-9]/.test(password)) score++
    if (/[^A-Za-z0-9]/.test(password)) score++
  }

  function validate() {
    // The same rules the API checks (app/validators/AuthValidator).
    const problem = firstError(validateRegister({ name: name.trim(), email, password }))
    if (problem) return problem
    if (password !== confirmPassword) return "Passwords don't match."
    if (!agreed) return 'Please agree to the Terms of Service to continue.'
    return ''
  }

  async function submit() {
    if (submitting) return
    const problem = validate()
    setError(problem)
    if (problem) return

    setSubmitting(true)
    const result = await register({ name: name.trim(), email, password })
    setSubmitting(false)

    if (result.ok) setRegistered(true)
    else if (result.status === 429) setError('Too many attempts. Wait a minute and try again.')
    else if (result.status === 0) setError('Network error. Check your connection and try again.')
    else setError(result.error ?? 'Could not create account. Check your details and try again.')
  }

  return (
    <div className="flex items-center justify-center px-6 py-16">
      <div className="w-full max-w-4xl grid grid-cols-1 lg:grid-cols-2 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden">
        <div className="hidden lg:flex flex-col justify-center border-r border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/60 p-10">
          <h2 className="text-2xl font-semibold tracking-tight mb-3">Create your account</h2>
          <p className="text-sm text-zinc-500 dark:text-zinc-400 mb-8 leading-relaxed">It takes less than a minute.</p>
          <ul className="space-y-3">
            {perks.map((perk) => (
              <li key={perk} className="flex items-start gap-2.5 text-sm text-zinc-600 dark:text-zinc-300">
                <span className="text-emerald-500">✓</span>
                {perk}
              </li>
            ))}
          </ul>
        </div>

        <div className="flex items-center justify-center px-6 py-12">
          {registered ? (
            <div className="w-full max-w-sm" data-testid="registered">
              <div className="w-11 h-11 rounded-md bg-emerald-500/10 flex items-center justify-center mb-5 text-emerald-600">✓</div>
              <h1 className="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
              <p className="text-sm text-zinc-500 mb-8">
                We sent a verification link to <span className="text-zinc-900 dark:text-zinc-200">{email}</span>. Click it,
                then log in.
              </p>
              <Link
                to="/login"
                className="inline-block w-full text-center bg-emerald-500 text-white dark:text-zinc-950 rounded-md py-2.5 text-sm font-semibold hover:bg-emerald-400 transition-colors"
              >
                Go to login
              </Link>
              {import.meta.env.DEV && (
                <p className="text-xs text-zinc-500 text-center mt-4">
                  No mail server yet?{' '}
                  <Link to="/dev/mail" className="text-emerald-600 dark:text-emerald-400 hover:underline">
                    Open the dev mail log
                  </Link>
                </p>
              )}
            </div>
          ) : (
            <form
              className="w-full max-w-sm"
              noValidate
              onSubmit={(event) => {
                event.preventDefault()
                submit()
              }}
            >
              <h1 className="text-2xl font-semibold tracking-tight mb-1">Create account</h1>
              <p className="text-sm text-zinc-500 mb-8">Start building with Tylix.</p>

              {error && (
                <div role="alert" aria-live="polite" className="rounded-md border border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
                  <p className="text-rose-700 dark:text-rose-400 text-sm">{error}</p>
                </div>
              )}

              <label htmlFor="name" className="block text-zinc-500 text-xs font-medium mb-1.5">Name</label>
              <input id="name" name="name" autoComplete="name" autoFocus value={name} onChange={(event) => setName(event.target.value)} className={inputClass} />

              <label htmlFor="email" className="block text-zinc-500 text-xs font-medium mb-1.5">Email</label>
              <input id="email" name="email" type="email" autoComplete="email" placeholder="you@example.com" value={email} onChange={(event) => setEmail(event.target.value)} className={inputClass} />

              <label htmlFor="password" className="block text-zinc-500 text-xs font-medium mb-1.5">Password</label>
              <input id="password" name="password" type="password" autoComplete="new-password" value={password} onChange={(event) => setPassword(event.target.value)} className={inputClass} />
              {password && <p className="-mt-3 mb-4 text-xs text-zinc-500">Strength: {strengthLabels[score]}</p>}

              <label htmlFor="confirmPassword" className="block text-zinc-500 text-xs font-medium mb-1.5">Confirm password</label>
              <input id="confirmPassword" name="confirmPassword" type="password" autoComplete="new-password" value={confirmPassword} onChange={(event) => setConfirmPassword(event.target.value)} className={inputClass} />

              <label className="flex items-center gap-2 text-sm text-zinc-500 mb-6">
                <input type="checkbox" name="terms" checked={agreed} onChange={(event) => setAgreed(event.target.checked)} className="rounded border-zinc-300 dark:border-zinc-700" />
                I agree to the Terms of Service
              </label>

              <button
                type="submit"
                disabled={submitting || !hydrated}
                className="w-full bg-emerald-500 text-white dark:text-zinc-950 rounded-md py-2.5 text-sm font-semibold hover:bg-emerald-400 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
              >
                {submitting ? 'Creating account…' : 'Create account'}
              </button>

              <p className="text-sm text-zinc-500 text-center mt-6">
                Already have an account?{' '}
                <Link to="/login" className="text-emerald-600 dark:text-emerald-400 hover:underline">
                  Log in
                </Link>
              </p>
            </form>
          )}
        </div>
      </div>
    </div>
  )
}

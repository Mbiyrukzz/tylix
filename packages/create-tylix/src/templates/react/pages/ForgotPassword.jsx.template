import { useState } from 'react'
import { Link } from 'react-router'
import { useAuth, useHydrated } from '@tylix/react'
import { firstError } from '@tylix/shared/validation'
import { validateForgotPassword } from '../../validators/AuthValidator'

export default function ForgotPassword() {
  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
  const { forgotPassword } = useAuth()
  const [email, setEmail] = useState('')
  const [error, setError] = useState('')
  const [submitting, setSubmitting] = useState(false)
  const [sent, setSent] = useState(false)

  async function submit() {
    if (submitting) return
    const problem = firstError(validateForgotPassword({ email }))
    if (problem) {
      setError(problem)
      return
    }
    setError('')
    setSubmitting(true)
    const result = await forgotPassword(email)
    setSubmitting(false)

    // The server answers the same way whether or not the email is
    // registered, so this page can't be used to find out who has an account.
    if (result.ok) setSent(true)
    else if (result.status === 429) setError('Too many requests. Wait a minute and try again.')
    else if (result.status === 0) setError('Network error. Check your connection and try again.')
    else setError(result.error ?? 'Could not send the reset link. Try again.')
  }

  return (
    <div className="flex items-center justify-center px-6 py-16">
      <div className="w-full max-w-sm rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-8">
        {sent ? (
          <div data-testid="reset-sent">
            <h1 className="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
            <p className="text-sm text-zinc-500 mb-6">
              If <span className="text-zinc-900 dark:text-zinc-200">{email}</span> has an account, a link to reset the
              password is on its way.
            </p>
            {import.meta.env.DEV && (
              <p className="text-xs text-zinc-500 mb-6">
                No mail server yet?{' '}
                <Link to="/dev/mail" className="text-emerald-600 dark:text-emerald-400 hover:underline">
                  Open the dev mail log
                </Link>
              </p>
            )}
            <Link to="/login" className="text-sm text-emerald-600 dark:text-emerald-400 hover:underline">
              Back to login
            </Link>
          </div>
        ) : (
          <form
            noValidate
            onSubmit={(event) => {
              event.preventDefault()
              submit()
            }}
          >
            <h1 className="text-2xl font-semibold tracking-tight mb-1">Forgot your password?</h1>
            <p className="text-sm text-zinc-500 mb-6">We'll email you a link to choose a new one.</p>

            {error && (
              <div role="alert" className="rounded-md border border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
                <p className="text-rose-700 dark:text-rose-400 text-sm">{error}</p>
              </div>
            )}

            <label htmlFor="email" className="block text-zinc-500 text-xs font-medium mb-1.5">Email</label>
            <input
              id="email"
              type="email"
              autoComplete="email"
              autoFocus
              value={email}
              onChange={(event) => setEmail(event.target.value)}
              className="w-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 rounded-md px-3.5 py-2.5 mb-4 text-sm outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition"
            />
            <button
              type="submit"
              disabled={submitting || !hydrated}
              className="w-full bg-emerald-500 text-white dark:text-zinc-950 rounded-md py-2.5 text-sm font-semibold hover:bg-emerald-400 transition-colors disabled:opacity-50"
            >
              {submitting ? 'Sending…' : 'Send reset link'}
            </button>
            <p className="text-sm text-zinc-500 text-center mt-6">
              <Link to="/login" className="text-emerald-600 dark:text-emerald-400 hover:underline">
                Back to login
              </Link>
            </p>
          </form>
        )}
      </div>
    </div>
  )
}

import { useState } from 'react'
import { Link } from 'react-router'
import { useAuth, useHydrated } from '@tylix/react'
import { firstError } from '@tylix/shared/validation'
import { validateForgotPassword } from '../../validators/AuthValidator'

export default function ForgotPassword() {
  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
  const { forgotPassword } = useAuth()
  const [email, setEmail] = useState('')
  const [error, setError] = useState('')
  const [submitting, setSubmitting] = useState(false)
  const [sent, setSent] = useState(false)

  async function submit() {
    if (submitting) return
    const problem = firstError(validateForgotPassword({ email }))
    if (problem) {
      setError(problem)
      return
    }
    setError('')
    setSubmitting(true)
    const result = await forgotPassword(email)
    setSubmitting(false)

    // The server answers the same way whether or not the email is
    // registered, so this page can't be used to find out who has an account.
    if (result.ok) setSent(true)
    else if (result.status === 429) setError('Too many requests. Wait a minute and try again.')
    else if (result.status === 0) setError('Network error. Check your connection and try again.')
    else setError(result.error ?? 'Could not send the reset link. Try again.')
  }

  return (
    <div className="flex items-center justify-center px-6 py-16">
      <div className="tx-card tx-glow">
        {sent ? (
          <div data-testid="reset-sent">
            <h1 className="text-2xl font-semibold tracking-tight mb-2">Check your email</h1>
            <p className="text-sm text-muted mb-6">
              If <span className="text-ink">{email}</span> has an account, a link to reset the
              password is on its way.
            </p>
            {import.meta.env.DEV && (
              <p className="text-xs text-muted mb-6">
                No mail server yet?{' '}
                <Link to="/dev/mail" className="tx-link">
                  Open the dev mail log
                </Link>
              </p>
            )}
            <Link to="/login" className="text-sm tx-link">
              Back to login
            </Link>
          </div>
        ) : (
          <form
            noValidate
            onSubmit={(event) => {
              event.preventDefault()
              submit()
            }}
          >
            <h1 className="text-2xl font-semibold tracking-tight mb-1">Forgot your password?</h1>
            <p className="text-sm text-muted mb-6">We'll email you a link to choose a new one.</p>

            {error && (
              <div role="alert" className="tx-alert tx-alert-error mb-6">
                <p className="text-sm">{error}</p>
              </div>
            )}

            <label htmlFor="email" className="tx-label">Email</label>
            <input
              id="email"
              type="email"
              autoComplete="email"
              autoFocus
              value={email}
              onChange={(event) => setEmail(event.target.value)}
              className="tx-input"
            />
            <button
              type="submit"
              disabled={submitting || !hydrated}
              className="tx-btn tx-btn-primary tx-btn-block"
            >
              {submitting ? 'Sending…' : 'Send reset link'}
            </button>
            <p className="text-sm text-muted text-center mt-6">
              <Link to="/login" className="tx-link">
                Back to login
              </Link>
            </p>
          </form>
        )}
      </div>
    </div>
  )
}

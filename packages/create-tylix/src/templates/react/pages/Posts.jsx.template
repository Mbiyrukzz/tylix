import { Link } from 'react-router'
import { usePublicPosts } from '../providers/PostsProvider'
import PageLoading from '../components/PageLoading'

// A fixed locale and time zone: with SSR, a date must read the same on the
// server and in the visitor's browser, or hydration fails.
const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' })

// Everyone's posts, newest first, from <PublicPostsProvider> (AppRoutes).
export default function Posts() {
  const { posts, loading, error } = usePublicPosts()

  return (
    <div className="max-w-3xl mx-auto px-6 py-12">
      <h1 className="text-3xl font-semibold tracking-tight mb-8">Posts</h1>
      {loading && posts.length === 0 ? (
        <PageLoading compact label="Loading posts" />
      ) : error ? (
        <p className="text-sm text-coral">{error}</p>
      ) : posts.length > 0 ? (
        <ul className="space-y-4" data-testid="public-posts">
          {posts.map((post) => (
            <li key={post.id}>
              <Link
                to={`/posts/${post.id}`}
                className="block tx-panel p-5 hover:border-line-strong transition-colors"
              >
                <p className="font-semibold">{post.title}</p>
                <p className="text-sm text-muted mt-1">{post.excerpt}</p>
                <p className="text-xs text-muted mt-3">
                  {post.author} · {dateFormat.format(new Date(post.created_at))}
                </p>
              </Link>
            </li>
          ))}
        </ul>
      ) : (
        <p className="text-sm text-muted">No posts yet.</p>
      )}
    </div>
  )
}

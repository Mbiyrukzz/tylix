}
// @if posts

// Your posts, from <MyPostsProvider> (AppRoutes): the list plus create
// and remove, which reload it. Only the logged-in user's posts.
function Posts() {
  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
  const { posts, loading, error: loadError, create: createPost, remove: removePost } = useMyPosts()
  const [title, setTitle] = useState('')
  const [body, setBody] = useState('')
  const [error, setError] = useState('')
  const [saving, setSaving] = useState(false)

  async function create() {
    if (saving) return
    if (!title.trim() || !body.trim()) {
      setError('Give the post a title and some text.')
      return
    }
    setSaving(true)
    const problem = await createPost({ title: title.trim(), body: body.trim() })
    setSaving(false)
    if (problem) {
      setError(problem)
      return
    }
    setError('')
    setTitle('')
    setBody('')
  }

  return (
    <section>
      <h2 className="text-xl font-semibold tracking-tight mb-4">Your posts</h2>

      <form
        className={`${cardClass} mb-6`}
        onSubmit={(event) => {
          event.preventDefault()
          create()
        }}
      >
        {error && (
          <p role="alert" className="text-coral text-sm mb-3">
            {error}
          </p>
        )}
        <input
          name="title"
          placeholder="Title"
          value={title}
          onChange={(event) => setTitle(event.target.value)}
          className="tx-input mb-3"
        />
        <textarea
          name="body"
          placeholder="Write something…"
          rows={3}
          value={body}
          onChange={(event) => setBody(event.target.value)}
          className="tx-input mb-3"
        />
        <button
          type="submit"
          disabled={saving || !hydrated}
          className="px-4 py-2 rounded-lg bg-brand text-white text-sm font-semibold hover:bg-brand-hover transition-colors disabled:opacity-50"
        >
          {saving ? 'Saving…' : 'Publish post'}
        </button>
      </form>

      {loading && posts.length === 0 ? (
        <p className="text-sm text-muted">Loading posts…</p>
      ) : loadError ? (
        <p className="text-sm text-coral">{loadError}</p>
      ) : posts.length > 0 ? (
        <ul className="space-y-3" data-testid="posts">
          {posts.map((post) => (
            <li key={post.id} className={`${cardClass} flex items-start justify-between gap-4`}>
              <div>
                <p className="font-semibold">{post.title}</p>
                <p className="text-sm text-muted mt-1 whitespace-pre-line">{post.body}</p>
              </div>
              <button
                type="button"
                onClick={async () => {
                  const problem = await removePost(post.id)
                  if (problem) setError(problem)
                }}
                className="text-sm text-muted hover:text-coral transition-colors"
              >
                Delete
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p className="text-sm text-muted">No posts yet. Publish your first one above.</p>
      )}
    </section>
  )
}
// @endif

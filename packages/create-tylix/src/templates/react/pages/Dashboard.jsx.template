}
// @if posts

// Your posts, from <MyPostsProvider> (AppRoutes): the list plus create
// and remove, which reload it. Only the logged-in user's posts.
function Posts() {
  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
  const { posts, loading, error: loadError, create: createPost, remove: removePost, uploadImage } = useMyPosts()
  const [title, setTitle] = useState('')
  const [body, setBody] = useState('')
  const [coverImage, setCoverImage] = useState('')
  const [error, setError] = useState('')
  const [saving, setSaving] = useState(false)
  const [uploading, setUploading] = useState(false)

  // Uploads the picked image straight away; the post sends its URL.
// @if ts
  async function pickImage(event: ChangeEvent<HTMLInputElement>) {
// @endif
// @if !ts
  async function pickImage(event) {
// @endif
    const input = event.target
    const file = input.files?.[0]
    input.value = ''
    if (!file) return
    setUploading(true)
    setError('')
    const uploaded = await uploadImage(file)
    setUploading(false)
    if (uploaded.error) {
      setError(uploaded.error)
      return
    }
    setCoverImage(uploaded.url ?? '')
  }

  async function create() {
    if (saving || uploading) return
    if (!title.trim() || !body.trim()) {
      setError('Give the post a title and some text.')
      return
    }
    setSaving(true)
    const problem = await createPost({ title: title.trim(), body: body.trim(), cover_image: coverImage || null })
    setSaving(false)
    if (problem) {
      setError(problem)
      return
    }
    setError('')
    setTitle('')
    setBody('')
    setCoverImage('')
  }

  return (
    <section>
      <h2 className="text-xl font-semibold tracking-tight mb-4">Your posts</h2>

      <form
        className={`${cardClass} mb-6`}
        onSubmit={(event) => {
          event.preventDefault()
          create()
        }}
      >
        {error && (
          <p role="alert" className="text-coral text-sm mb-3">
            {error}
          </p>
        )}
        <input
          name="title"
          placeholder="Title"
          value={title}
          onChange={(event) => setTitle(event.target.value)}
          className="tx-input mb-3"
        />
        <textarea
          name="body"
          placeholder="Write something…"
          rows={3}
          value={body}
          onChange={(event) => setBody(event.target.value)}
          className="tx-input mb-3"
        />
        {coverImage ? (
          <div className="relative mb-3">
            <img src={coverImage} alt="Cover preview" className="w-full aspect-video object-cover rounded-lg border border-line" />
            <button
              type="button"
              onClick={() => setCoverImage('')}
              className="absolute top-2 right-2 text-xs font-medium px-2.5 py-1 rounded-lg bg-panel/90 border border-line"
            >
              Remove
            </button>
          </div>
        ) : (
          <label className="block mb-3">
            <span className="text-xs text-muted">Cover image (optional, PNG, JPEG, WebP or GIF, up to 2 MB)</span>
            <input
              type="file"
              name="cover_image"
              accept="image/png,image/jpeg,image/webp,image/gif"
              onChange={pickImage}
              disabled={uploading || !hydrated}
              className="block w-full text-sm text-muted mt-1"
            />
          </label>
        )}
        {uploading && <p className="text-xs text-muted mb-3">Uploading…</p>}
        <button
          type="submit"
          disabled={saving || uploading || !hydrated}
          className="px-4 py-2 rounded-lg bg-brand text-white text-sm font-semibold hover:bg-brand-hover transition-colors disabled:opacity-50"
        >
          {saving ? 'Saving…' : 'Publish post'}
        </button>
      </form>

      {loading && posts.length === 0 ? (
        <PageLoading compact label="Loading posts" />
      ) : loadError ? (
        <p className="text-sm text-coral">{loadError}</p>
      ) : posts.length > 0 ? (
        <ul className="space-y-3" data-testid="posts">
          {posts.map((post) => (
            <li key={post.id} className={`${cardClass} flex items-start justify-between gap-4`}>
              {post.cover_image && (
                <img src={post.cover_image} alt="" className="w-20 h-14 object-cover rounded-lg border border-line shrink-0" />
              )}
              <div className="flex-1 min-w-0">
                <p className="font-semibold">{post.title}</p>
                <p className="text-sm text-muted mt-1 whitespace-pre-line">{post.body}</p>
              </div>
              <button
                type="button"
                onClick={async () => {
                  const problem = await removePost(post.id)
                  if (problem) setError(problem)
                }}
                className="text-sm text-muted hover:text-coral transition-colors"
              >
                Delete
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p className="text-sm text-muted">No posts yet. Publish your first one above.</p>
      )}
    </section>
  )
}
// @endif

// @if posts

// @if ts
// The fields GET /api/posts returns (app/models/Post).
type Post = {
  id: number
  title: string
  body: string
  cover_image: string | null
}

// @endif
// Your posts, from the Post feature the starter generated. /api/posts is
// behind requireAuth and only returns the logged-in user's posts.
function Posts() {
  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
  // @if ts
  const posts = useApi<Post[]>('/api/posts')
  // @endif
  // @if !ts
  const posts = useApi('/api/posts')
  // @endif
  const [title, setTitle] = useState('')
  const [body, setBody] = useState('')
  const [error, setError] = useState('')
  const [saving, setSaving] = useState(false)

  async function create() {
    if (saving) return
    if (!title.trim() || !body.trim()) {
      setError('Give the post a title and some text.')
      return
    }
    setSaving(true)
    const result = await api.post('/api/posts', { title: title.trim(), body: body.trim() })
    setSaving(false)
    if (!result.ok) {
      setError(result.error ?? 'Could not save the post.')
      return
    }
    setError('')
    setTitle('')
    setBody('')
    posts.reload()
  }

  return (
    <section>
      <h2 className="text-xl font-semibold tracking-tight mb-4">Your posts</h2>

      <form
        className={`${cardClass} mb-6`}
        onSubmit={(event) => {
          event.preventDefault()
          create()
        }}
      >
        {error && (
          <p role="alert" className="text-rose-600 dark:text-rose-400 text-sm mb-3">
            {error}
          </p>
        )}
        <input
          name="title"
          placeholder="Title"
          value={title}
          onChange={(event) => setTitle(event.target.value)}
          className="w-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 rounded-md px-3.5 py-2.5 mb-3 text-sm outline-none focus:ring-2 focus:ring-emerald-500/40"
        />
        <textarea
          name="body"
          placeholder="Write something…"
          rows={3}
          value={body}
          onChange={(event) => setBody(event.target.value)}
          className="w-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 rounded-md px-3.5 py-2.5 mb-3 text-sm outline-none focus:ring-2 focus:ring-emerald-500/40"
        />
        <button
          type="submit"
          disabled={saving || !hydrated}
          className="px-4 py-2 rounded-md bg-emerald-500 text-white dark:text-zinc-950 text-sm font-semibold hover:bg-emerald-400 transition-colors disabled:opacity-50"
        >
          {saving ? 'Saving…' : 'Publish post'}
        </button>
      </form>

      {posts.loading && !posts.data ? (
        <p className="text-sm text-zinc-500">Loading posts…</p>
      ) : posts.error ? (
        <p className="text-sm text-rose-600">{posts.error}</p>
      ) : posts.data && posts.data.length > 0 ? (
        <ul className="space-y-3" data-testid="posts">
          {posts.data.map((post) => (
            <li key={post.id} className={`${cardClass} flex items-start justify-between gap-4`}>
              <div>
                <p className="font-semibold">{post.title}</p>
                <p className="text-sm text-zinc-500 mt-1 whitespace-pre-line">{post.body}</p>
              </div>
              <button
                type="button"
                onClick={async () => {
                  const result = await api.delete(`/api/posts/${post.id}`)
                  if (result.ok) posts.reload()
                  else setError(result.error ?? 'Could not delete the post.')
                }}
                className="text-sm text-zinc-500 hover:text-rose-600 transition-colors"
              >
                Delete
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p className="text-sm text-zinc-500">No posts yet. Publish your first one above.</p>
      )}
    </section>
  )
}
// @endif

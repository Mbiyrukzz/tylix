import { IconMail, IconServer, IconShieldCheck } from 'tylix-icons/react'
// @if posts
import { useState } from 'react'
import { useAuth, useHydrated } from '@tylix/react'
import { useMyPosts } from '../providers/PostsProvider'
// @endif
// @if !posts
import { useAuth } from '@tylix/react'
// @endif

const cardClass = 'tx-panel p-5'

export default function Dashboard() {
  const { user } = useAuth()

  return (
    <div className="max-w-6xl mx-auto px-6 py-12">
      <p className="text-sm text-muted mb-1">Signed in as</p>
      <h1 className="text-3xl font-semibold tracking-tight mb-8" data-testid="dashboard-name">
        {user?.name}
      </h1>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
        <div className={cardClass}>
          <IconMail className="w-4 h-4 text-mint mb-3" />
          <p className="text-xs text-muted mb-1">Email</p>
          <p className="text-sm font-semibold truncate">{user?.email}</p>
        </div>
        <div className={cardClass}>
          <IconShieldCheck className="w-4 h-4 text-mint mb-3" />
          <p className="text-xs text-muted mb-1">Session</p>
          <p className="text-sm font-semibold">httpOnly cookie, refreshed automatically</p>
        </div>
        <div className={cardClass}>
          <IconServer className="w-4 h-4 text-mint mb-3" />
          <p className="text-xs text-muted mb-1">Protected API</p>

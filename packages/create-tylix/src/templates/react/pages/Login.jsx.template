import { useState } from 'react'
import { Link, useNavigate } from 'react-router'
import { useAuth, useHydrated } from '@tylix/react'
import { useNextPath } from '../components/Redirects'
import { firstError } from '@tylix/shared/validation'
import { validateLogin } from '../../validators/AuthValidator'

const inputClass =
  'w-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 rounded-md px-3.5 py-2.5 mb-4 text-sm outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500 transition'

const perks = [
  'Manage your posts from one dashboard',
  'Your session refreshes automatically',
  'The same login works across every tab',
]

export default function Login() {
  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
  const { login, expired } = useAuth()
  const navigate = useNavigate()
  const next = useNextPath()
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [error, setError] = useState(expired ? 'Your session ended. Log in again.' : '')
  const [submitting, setSubmitting] = useState(false)

  // The same rules the API checks (app/validators/AuthValidator).
  function validate() {
    return firstError(validateLogin({ email, password }))
  }

  async function submit() {
    if (submitting) return
    const problem = validate()
    setError(problem)
    if (problem) return

    setSubmitting(true)
    const result = await login(email, password)
    if (result.ok) {
      navigate(next, { replace: true })
      return
    }

    setSubmitting(false)
    if (result.status === 401) setError('Invalid email or password.')
    else if (result.status === 403) setError(result.error ?? 'Please verify your email before logging in.')
    else if (result.status === 429) setError('Too many attempts. Wait a minute and try again.')
    else if (result.status === 0) setError('Network error. Check your connection and try again.')
    else setError(result.error ?? 'Could not log in. Try again.')
  }

  return (
    <div className="flex items-center justify-center px-6 py-16">
      <div className="w-full max-w-4xl grid grid-cols-1 lg:grid-cols-2 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden">
        <div className="hidden lg:flex flex-col justify-center border-r border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/60 p-10">
          <h2 className="text-2xl font-semibold tracking-tight mb-3">Welcome back</h2>
          <p className="text-sm text-zinc-500 dark:text-zinc-400 mb-8 leading-relaxed">Log in to pick up where you left off.</p>
          <ul className="space-y-3">
            {perks.map((perk) => (
              <li key={perk} className="flex items-start gap-2.5 text-sm text-zinc-600 dark:text-zinc-300">
                <span className="text-emerald-500">✓</span>
                {perk}
              </li>
            ))}
          </ul>
        </div>

        <form
          className="flex items-center justify-center px-6 py-12"
          noValidate
          onSubmit={(event) => {
            event.preventDefault()
            submit()
          }}
        >
          <div className="w-full max-w-sm">
            <h1 className="text-2xl font-semibold tracking-tight mb-1">Log in</h1>
            <p className="text-sm text-zinc-500 mb-8">Continue to your dashboard.</p>

            {error && (
              <div role="alert" aria-live="polite" className="rounded-md border border-rose-300 dark:border-rose-900/50 bg-rose-50 dark:bg-rose-950/30 px-4 py-3 mb-6">
                <p className="text-rose-700 dark:text-rose-400 text-sm">{error}</p>
              </div>
            )}

            <label htmlFor="email" className="block text-zinc-500 text-xs font-medium mb-1.5">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autoComplete="email"
              autoFocus
              placeholder="you@example.com"
              value={email}
              onChange={(event) => setEmail(event.target.value)}
              className={inputClass}
            />

            <label htmlFor="password" className="block text-zinc-500 text-xs font-medium mb-1.5">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              autoComplete="current-password"
              placeholder="••••••••"
              value={password}
              onChange={(event) => setPassword(event.target.value)}
              className={inputClass}
            />

            <div className="flex justify-end -mt-1 mb-4">
              <Link to="/forgot-password" className="text-sm text-emerald-600 dark:text-emerald-400 hover:underline">
                Forgot password?
              </Link>
            </div>

            <button
              type="submit"
              disabled={submitting || !hydrated}
              className="w-full bg-emerald-500 text-white dark:text-zinc-950 rounded-md py-2.5 text-sm font-semibold hover:bg-emerald-400 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              {submitting ? 'Logging in…' : 'Log in'}
            </button>

            <p className="text-sm text-zinc-500 text-center mt-6">
              Need an account?{' '}
              <Link to="/register" className="text-emerald-600 dark:text-emerald-400 hover:underline">
                Sign up
              </Link>
            </p>
          </div>
        </form>
      </div>
    </div>
  )
}

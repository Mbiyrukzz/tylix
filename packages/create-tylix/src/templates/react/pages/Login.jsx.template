import { useState } from 'react'
import { Link, useNavigate } from 'react-router'
import { useAuth, useHydrated } from '@tylix/react'
import { useNextPath } from '../components/Redirects'
import OAuthButtons from '../components/OAuthButtons'
import { firstError } from '@tylix/shared/validation'
import { validateLogin } from '../../validators/AuthValidator'

const inputClass =
  'tx-input'

const perks = [
  'Manage your posts from one dashboard',
  'Your session refreshes automatically',
  'The same login works across every tab',
]

export default function Login() {
  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
  const { login, expired } = useAuth()
  const navigate = useNavigate()
  const next = useNextPath()
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [error, setError] = useState(expired ? 'Your session ended. Log in again.' : '')
  const [submitting, setSubmitting] = useState(false)

  // The same rules the API checks (app/validators/AuthValidator).
  function validate() {
    return firstError(validateLogin({ email, password }))
  }

  async function submit() {
    if (submitting) return
    const problem = validate()
    setError(problem)
    if (problem) return

    setSubmitting(true)
    const result = await login(email, password)
    if (result.ok) {
      navigate(next, { replace: true })
      return
    }

    setSubmitting(false)
    if (result.status === 401) setError('Invalid email or password.')
    else if (result.status === 403) setError(result.error ?? 'Please verify your email before logging in.')
    else if (result.status === 429) setError('Too many attempts. Wait a minute and try again.')
    else if (result.status === 0) setError('Network error. Check your connection and try again.')
    else setError(result.error ?? 'Could not log in. Try again.')
  }

  return (
    <div className="flex items-center justify-center px-6 py-16">
      <div className="tx-auth tx-glow">
        <div className="tx-auth-aside">
          <p className="tx-eyebrow mb-5">Signed-in session</p>
          <h2 className="text-2xl font-semibold tracking-tight mb-3">Welcome back</h2>
          <p className="text-sm text-muted mb-8 leading-relaxed">Log in to pick up where you left off.</p>
          <ul className="space-y-3">
            {perks.map((perk) => (
              <li key={perk} className="flex items-start gap-2.5 text-sm text-soft">
                <span className="text-mint">✓</span>
                {perk}
              </li>
            ))}
          </ul>
        </div>

        <form
          className="tx-auth-form"
          noValidate
          onSubmit={(event) => {
            event.preventDefault()
            submit()
          }}
        >
          <div className="w-full max-w-sm">
            <h1 className="text-2xl font-semibold tracking-tight mb-1">Log in</h1>
            <p className="text-sm text-muted mb-8">Continue to your dashboard.</p>

            {error && (
              <div role="alert" aria-live="polite" className="tx-alert tx-alert-error mb-6">
                <p className="text-sm">{error}</p>
              </div>
            )}

            <OAuthButtons returnTo={next} />

            <label htmlFor="email" className="tx-label">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              autoComplete="email"
              autoFocus
              placeholder="you@example.com"
              value={email}
              onChange={(event) => setEmail(event.target.value)}
              className={inputClass}
            />

            <label htmlFor="password" className="tx-label">Password</label>
            <input
              id="password"
              name="password"
              type="password"
              autoComplete="current-password"
              placeholder="••••••••"
              value={password}
              onChange={(event) => setPassword(event.target.value)}
              className={inputClass}
            />

            <div className="flex justify-end -mt-1 mb-4">
              <Link to="/forgot-password" className="text-sm tx-link">
                Forgot password?
              </Link>
            </div>

            <button
              type="submit"
              disabled={submitting || !hydrated}
              className="tx-btn tx-btn-primary tx-btn-block"
            >
              {submitting ? 'Logging in…' : 'Log in'}
            </button>

            <p className="text-sm text-muted text-center mt-6">
              Need an account?{' '}
              <Link to="/register" className="tx-link">
                Sign up
              </Link>
            </p>
          </div>
        </form>
      </div>
    </div>
  )
}

import { useState } from 'react'
import { Link, useSearchParams } from 'react-router'
import { useAuth, useHydrated } from '@tylix/react'
import { firstError } from '@tylix/shared/validation'
import { validateResetPassword } from '../../validators/AuthValidator'

const inputClass =
  'tx-input'

// Opened from the link in the reset email:
//   /reset-password?token=...&email=...
export default function ResetPassword() {
  // Submitting before hydration would reload the page; see useHydrated.
  const hydrated = useHydrated()
  const { resetPassword } = useAuth()
  const [params] = useSearchParams()
  const token = params.get('token') ?? ''
  const email = params.get('email') ?? ''

  const [password, setPassword] = useState('')
  const [confirmPassword, setConfirmPassword] = useState('')
  const [error, setError] = useState('')
  const [submitting, setSubmitting] = useState(false)
  const [done, setDone] = useState(false)

  async function submit() {
    if (submitting) return
    const problem = firstError(validateResetPassword({ email, token, password }))
    if (problem) return setError(problem)
    if (password !== confirmPassword) return setError("Passwords don't match.")

    setError('')
    setSubmitting(true)
    const result = await resetPassword({ email, token, password })
    setSubmitting(false)

    if (result.ok) setDone(true)
    else if (result.status === 0) setError('Network error. Check your connection and try again.')
    else setError(result.error ?? 'Could not reset the password. Try again.')
  }

  const card = 'tx-card tx-glow'

  if (!token || !email) {
    return (
      <div className="flex items-center justify-center px-6 py-16">
        <div className={card}>
          <h1 className="text-2xl font-semibold tracking-tight mb-2">This link is incomplete</h1>
          <p className="text-sm text-muted mb-6">Open the link from the email again, or ask for a new one.</p>
          <Link to="/forgot-password" className="text-sm tx-link">
            Request a new link
          </Link>
        </div>
      </div>
    )
  }

  return (
    <div className="flex items-center justify-center px-6 py-16">
      <div className={card}>
        {done ? (
          <div data-testid="reset-done">
            <h1 className="text-2xl font-semibold tracking-tight mb-2">Password updated</h1>
            <p className="text-sm text-muted mb-6">
              For your security, every device was logged out. Log in with your new password.
            </p>
            <Link
              to="/login"
              className="tx-btn tx-btn-primary tx-btn-block"
            >
              Go to login
            </Link>
          </div>
        ) : (
          <form
            noValidate
            onSubmit={(event) => {
              event.preventDefault()
              submit()
            }}
          >
            <h1 className="text-2xl font-semibold tracking-tight mb-1">Choose a new password</h1>
            <p className="text-sm text-muted mb-6">For {email}</p>

            {error && (
              <div role="alert" className="tx-alert tx-alert-error mb-6">
                <p className="text-sm">{error}</p>
              </div>
            )}

            <label htmlFor="password" className="tx-label">New password</label>
            <input id="password" type="password" autoComplete="new-password" autoFocus value={password} onChange={(event) => setPassword(event.target.value)} className={inputClass} />

            <label htmlFor="confirmPassword" className="tx-label">Confirm new password</label>
            <input id="confirmPassword" type="password" autoComplete="new-password" value={confirmPassword} onChange={(event) => setConfirmPassword(event.target.value)} className={inputClass} />

            <button
              type="submit"
              disabled={submitting || !hydrated}
              className="tx-btn tx-btn-primary tx-btn-block"
            >
              {submitting ? 'Saving…' : 'Update password'}
            </button>
          </form>
        )}
      </div>
    </div>
  )
}

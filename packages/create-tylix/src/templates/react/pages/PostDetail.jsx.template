import { Link } from 'react-router'
import { usePost } from '../providers/PostsProvider'

// A fixed locale and time zone: with SSR, a date must read the same on the
// server and in the visitor's browser, or hydration fails.
const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' })

export default function PostDetail() {
  // The post for this URL's :id, from <PostProvider> (AppRoutes).
  const { post, notFound, loading, error } = usePost()

  return (
    <article className="max-w-3xl mx-auto px-6 py-12">
      <Link to="/posts" className="text-sm tx-link">
        ← All posts
      </Link>
      {loading && !post ? (
        <p className="text-sm text-muted mt-8">Loading…</p>
      ) : notFound ? (
        <div className="mt-8">
          <h1 className="text-2xl font-semibold">Post not found</h1>
          <p className="text-sm text-muted mt-2">It may have been deleted.</p>
        </div>
      ) : error ? (
        <p className="text-sm text-coral mt-8">{error}</p>
      ) : post ? (
        <>
          <h1 className="text-4xl font-semibold tracking-tight mt-6 mb-3" data-testid="post-title">
            {post.title}
          </h1>
          <p className="text-sm text-muted mb-8">
            {post.author} · {dateFormat.format(new Date(post.created_at))}
          </p>
          <div className="text-soft leading-relaxed whitespace-pre-line">{post.body}</div>
        </>
      ) : null}
    </article>
  )
}

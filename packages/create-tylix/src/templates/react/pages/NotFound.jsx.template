import { Link } from 'react-router'
import { useServerContext } from '@tylix/react'

export default function NotFound() {
  // A server-rendered 404 page answers with HTTP status 404.
  const server = useServerContext()
  if (server) server.status = 404

  return (
    <div className="min-h-[70vh] flex flex-col items-center justify-center text-center px-6">
      <p className="font-mono text-6xl font-semibold tracking-tight tx-gradient-text mb-3">404</p>
      <h1 className="mt-2 text-3xl font-semibold text-ink">Page not found</h1>
      <p className="mt-3 text-muted">The page you're looking for doesn't exist.</p>
      <Link to="/" className="mt-6 px-5 py-2 rounded-full bg-brand text-white font-semibold hover:bg-brand-hover transition-colors">
        Go home
      </Link>
    </div>
  )
}

import { createContext, useContext } from 'react'
// @if ts
import type { ReactNode } from 'react'
// @endif
import { Outlet, useParams } from 'react-router'
import { useApi } from '@tylix/react'
import { postUrls, postsService } from '../services/posts'
// @if ts
import type { Post, PostInput, PublicPost, PublicPostDetail } from '../services/posts'
// @endif

// Post data for the pages, as context. Pages call usePublicPosts(),
// usePost() or useMyPosts() and get data and actions; the URLs stay in
// services/posts.
//
// Each provider sits on the routes that need it (see AppRoutes), so the
// data is loaded only there, and on the server when the page is server
// rendered. Without children a provider renders the matching child route.

// @if ts
type Loadable = { loading: boolean; error: string | null; reload: () => Promise<unknown> }
type Children = { children?: ReactNode }

// @endif
// @if ts
function required<T>(value: T | null, hook: string, provider: string): T {
// @endif
// @if !ts
function required(value, hook, provider) {
// @endif
  if (value === null) throw new Error(`${hook}() needs a <${provider}> above it (see AppRoutes).`)
  return value
}

// ---- Everyone's posts (/posts) ----------------------------------------

// @if ts
type PublicPostsValue = Loadable & { posts: PublicPost[] }
const PublicPostsContext = createContext<PublicPostsValue | null>(null)

export function PublicPostsProvider({ children }: Children) {
  const result = useApi<PublicPost[]>(postUrls.publicList)
// @endif
// @if !ts
const PublicPostsContext = createContext(null)

export function PublicPostsProvider({ children }) {
  const result = useApi(postUrls.publicList)
// @endif
  const value = { posts: result.data ?? [], loading: result.loading, error: result.error, reload: result.reload }
  return <PublicPostsContext.Provider value={value}>{children ?? <Outlet />}</PublicPostsContext.Provider>
}

export function usePublicPosts() {
  return required(useContext(PublicPostsContext), 'usePublicPosts', 'PublicPostsProvider')
}

// ---- One post (/posts/:id) --------------------------------------------

// @if ts
type PostValue = Loadable & { post: PublicPostDetail | null; notFound: boolean }
const PostContext = createContext<PostValue | null>(null)

export function PostProvider({ children }: Children) {
  const { id } = useParams()
  const result = useApi<PublicPostDetail>(id ? postUrls.publicOne(id) : null)
// @endif
// @if !ts
const PostContext = createContext(null)

export function PostProvider({ children }) {
  const { id } = useParams()
  const result = useApi(id ? postUrls.publicOne(id) : null)
// @endif
  const value = {
    post: result.data ?? null,
    notFound: result.status === 404,
    loading: result.loading,
    error: result.error,
    reload: result.reload,
  }
  return <PostContext.Provider value={value}>{children ?? <Outlet />}</PostContext.Provider>
}

export function usePost() {
  return required(useContext(PostContext), 'usePost', 'PostProvider')
}

// ---- The logged-in user's posts (/dashboard) --------------------------

// Writes reload the list afterwards and return null or the error to show.
// @if ts
type MyPostsValue = Loadable & {
  posts: Post[]
  create: (input: PostInput) => Promise<string | null>
  remove: (id: number) => Promise<string | null>
}
const MyPostsContext = createContext<MyPostsValue | null>(null)

export function MyPostsProvider({ children }: Children) {
  const result = useApi<Post[]>(postUrls.mine)

  async function create(input: PostInput) {
// @endif
// @if !ts
const MyPostsContext = createContext(null)

export function MyPostsProvider({ children }) {
  const result = useApi(postUrls.mine)

  async function create(input) {
// @endif
    const saved = await postsService.create(input)
    if (!saved.ok) return saved.error ?? 'Could not save the post.'
    await result.reload()
    return null
  }

// @if ts
  async function remove(id: number) {
// @endif
// @if !ts
  async function remove(id) {
// @endif
    const removed = await postsService.remove(id)
    if (!removed.ok) return removed.error ?? 'Could not delete the post.'
    await result.reload()
    return null
  }

  const value = {
    posts: result.data ?? [],
    loading: result.loading,
    error: result.error,
    reload: result.reload,
    create,
    remove,
  }
  return <MyPostsContext.Provider value={value}>{children ?? <Outlet />}</MyPostsContext.Provider>
}

export function useMyPosts() {
  return required(useContext(MyPostsContext), 'useMyPosts', 'MyPostsProvider')
}

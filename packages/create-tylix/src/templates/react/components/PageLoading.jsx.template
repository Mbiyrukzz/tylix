// The loading indicator for anything a page waits on: the session before a
// guarded page, or the data a page loads. The Tylix mark, lit stroke by
// stroke (.tx-loader in tylix-ui.css), like the loading screen the whole
// page shows while it starts. It fades in after 150ms, so quick loads never
// flash it.
//
//   <PageLoading />                               a whole page
//   <PageLoading compact label="Loading posts" /> one section of a page
// @if ts
type PageLoadingProps = { label?: string; compact?: boolean }
// @endif

// @if ts
export default function PageLoading({ label, compact = false }: PageLoadingProps) {
// @endif
// @if !ts
export default function PageLoading({ label, compact = false }) {
// @endif
  return (
    <div
      className={compact ? 'tx-loader tx-loader-sm' : 'tx-loader'}
      role="status"
      aria-label={label || 'Loading'}
      data-testid="page-loading"
    >
      <svg className="tx-loader-mark" viewBox="0 0 552 366" aria-hidden="true"><path className="tx-loader-s1" d="M0 96 74 22Q96 0 120 0H552L482 77Q462 96 436 96Z"/><path className="tx-loader-s2" d="M34 366 148 151Q160 127 190 127H290L163 366Z"/><path className="tx-loader-s3" d="M218 339 294 192Q304 171 334 171H442L378 264Q368 277 353 283Z"/></svg>
      {label && <span className="tx-loader-label">{label}…</span>}
    </div>
  )
}

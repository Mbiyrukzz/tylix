import { useEffect, useState } from 'react'
import { Link, NavLink, Outlet, useLocation } from 'react-router'
import { ErrorBoundary } from '@tylix/react'
import ErrorPage from '../pages/ErrorPage'
// @if auth
import { useNavigate } from 'react-router'
import { useAuth } from '@tylix/react'
// @endif

const linkClass = ({ isActive = false }) =>
  'text-sm px-3.5 py-1.5 rounded-lg transition-colors ' +
  (isActive
    ? 'text-ink bg-raised font-medium tx-nav-link-active'
    : 'text-soft hover:text-ink hover:bg-raised ')

function useTheme() {
  // Unknown until mounted: the server can't see the visitor's theme, and the
  // first browser render must match the server's. The script in index.html
  // has already applied the right class to <html> by then.
  // @if ts
  const [dark, setDark] = useState<boolean | null>(null)
  // @endif
  // @if !ts
  const [dark, setDark] = useState(null)
  // @endif

  useEffect(() => {
    setDark(document.documentElement.classList.contains('dark'))
  }, [])

  useEffect(() => {
    if (dark === null) return
    document.documentElement.classList.toggle('dark', dark)
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light')
    } catch {
      // private mode: the theme just isn't remembered
    }
  }, [dark])

  return { dark: Boolean(dark), toggle: () => setDark((value) => !value) }
}

function Navbar() {
  const theme = useTheme()
  // @if auth
  const navigate = useNavigate()
  const { user, logout } = useAuth()

  async function handleLogout() {
    await logout()
    navigate('/', { replace: true })
  }
  // @endif

  return (
    <header className="tx-nav">
      <nav className="max-w-6xl mx-auto h-16 px-6 flex items-center justify-between">
        <div className="flex items-center gap-8">
          <Link to="/" className="flex items-center gap-2.5">
            <img src="/logo-mark.svg" alt="" className="h-[22px] w-auto" />
            <span className="text-[17px] font-bold tracking-tight">__APP_NAME__</span>
          </Link>
          <div className="hidden md:flex items-center gap-1">
            <NavLink to="/" end className={linkClass}>
              Home
            </NavLink>
            {/* @if posts */}
            <NavLink to="/posts" className={linkClass}>
              Posts
            </NavLink>
            {/* @endif */}
            {/* @if auth */}
            {user && (
              <NavLink to="/dashboard" className={linkClass}>
                Dashboard
              </NavLink>
            )}
            {/* @endif */}
            <a href="https://tylix.dev/docs" className={linkClass({})}>
              Docs
            </a>
          </div>
        </div>
        <div className="flex items-center gap-2">
          <button
            type="button"
            onClick={theme.toggle}
            aria-label="Toggle color theme"
            className="tx-icon-btn"
          >
            {theme.dark ? '☀' : '☾'}
          </button>
          {/* @if auth */}
          {user ? (
            <button
              type="button"
              onClick={handleLogout}
              data-testid="logout"
              className="text-sm px-3.5 py-1.5 rounded-lg border border-line text-soft hover:bg-raised transition-colors"
            >
              Log out
            </button>
          ) : (
            <>
              <Link
                to="/login"
                className="text-sm px-3.5 py-1.5 rounded-lg text-soft hover:bg-raised transition-colors"
              >
                Log in
              </Link>
              <Link
                to="/register"
                className="text-sm px-4 py-1.5 rounded-lg bg-brand text-white font-semibold hover:bg-brand-hover transition-colors"
              >
                Get started
              </Link>
            </>
          )}
          {/* @endif */}
        </div>
      </nav>
    </header>
  )
}

// Shown while the session is checked before a guarded page. The Tylix
// mark, lit stroke by stroke (.tx-loader in tylix-ui.css), like the
// loading screen the whole page shows while it starts.
export function PageLoading() {
  return (
    <div className="tx-loader" role="status" aria-label="Loading">
      <svg className="tx-loader-mark" viewBox="0 0 552 366" aria-hidden="true"><path className="tx-loader-s1" d="M0 96 74 22Q96 0 120 0H552L482 77Q462 96 436 96Z"/><path className="tx-loader-s2" d="M34 366 148 151Q160 127 190 127H290L163 366Z"/><path className="tx-loader-s3" d="M218 339 294 192Q304 171 334 171H442L378 264Q368 277 353 283Z"/></svg>
    </div>
  )
}

export default function Layout() {
  // A page that throws while rendering shows ErrorPage instead of a blank
  // screen. Keyed on the URL, so going to another page clears the error.
  const location = useLocation()
  return (
    <div className="tx-shell">
      <Navbar />
      <main className="flex-1">
        <ErrorBoundary resetKey={location.pathname} fallback={({ error, reset }) => <ErrorPage error={error} reset={reset} />}>
          <Outlet />
        </ErrorBoundary>
      </main>
      <footer className="border-t border-line">
        <div className="max-w-6xl mx-auto px-6 py-8 text-sm text-muted">
          Built with Tylix and React.
        </div>
      </footer>
    </div>
  )
}

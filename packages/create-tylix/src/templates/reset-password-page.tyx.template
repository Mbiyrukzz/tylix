page ResetPassword

title "Reset password"

state
  token: ""
  email: ""
  password: ""
  confirmPassword: ""
  error: ""
  submitting: false
  done: false
  linkComplete: true

action
  setField(field, value) {
    this[field] = value
  }

  async submit() {
    if this.submitting {
      return null
    }

    if this.password.length < 8 {
      this.error = "Password must be at least 8 characters."
      return null
    }
    if this.password is not this.confirmPassword {
      this.error = "Passwords don't match."
      return null
    }

    this.error = ""
    this.submitting = true

    try {
      const result = await useApi("/api/auth/reset-password", {
        method: "POST",
        body: { email: this.email, token: this.token, password: this.password }
      })

      if result.ok {
        this.done = true
      } else {
        this.error = result.error ?? "Could not reset the password. Try again."
      }
    } catch (err) {
      this.error = "Network error. Check your connection and try again."
    } finally {
      this.submitting = false
    }
  }

onMount
  {
    const params = new URLSearchParams(window.location.search)
    this.token = params.get("token") ?? ""
    this.email = params.get("email") ?? ""
    this.linkComplete = this.token.length > 0 and this.email.length > 0
  }

template
  <div class="flex items-center justify-center px-6 py-16">
    <div class="tx-card tx-glow">
{{#if not linkComplete}}
      <h1 class="text-2xl font-semibold tracking-tight mb-2">This link is incomplete</h1>
      <p class="text-sm text-muted mb-6">Open the link from the email again, or ask for a new one.</p>
      <a href="/forgot-password" class="text-sm tx-link">Request a new link</a>
{{#else}}
{{#if done}}
      <div data-testid="reset-done">
        <h1 class="text-2xl font-semibold tracking-tight mb-2">Password updated</h1>
        <p class="text-sm text-muted mb-6">For your security, every device was logged out. Log in with your new password.</p>
        <a href="/login" class="tx-btn tx-btn-primary tx-btn-block">Go to login</a>
      </div>
{{#else}}
      <h1 class="text-2xl font-semibold tracking-tight mb-1">Choose a new password</h1>
      <p class="text-sm text-muted mb-6">For {{ email }}</p>

{{#if error}}
      <div role="alert" aria-live="polite" class="tx-alert tx-alert-error mb-6">
        <p class="text-sm">{{ error }}</p>
      </div>
{{/if}}

      <label for="password" class="tx-label">New password</label>
      <input
        id="password"
        type="password"
        autocomplete="new-password"
        autofocus
        value="{{ password }}"
        oninput="{{ setField('password', event.target.value) }}"
        class="tx-input"
      />

      <label for="confirmPassword" class="tx-label">Confirm new password</label>
      <input
        id="confirmPassword"
        type="password"
        autocomplete="new-password"
        value="{{ confirmPassword }}"
        oninput="{{ setField('confirmPassword', event.target.value) }}"
        onkeydown="{{ event.key is 'Enter' and submit() }}"
        class="tx-input"
      />

      <button
        onclick="{{ submit() }}"
        disabled="{{ submitting }}"
        class="tx-btn tx-btn-primary tx-btn-block"
      >
        {{ submitting ? 'Saving…' : 'Update password' }}
      </button>
{{/if}}
{{/if}}
    </div>
  </div>

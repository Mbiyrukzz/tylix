{
  "name": "@tylix/angular",
  "version": "0.6.0",
  "description": "Angular frontend for Tylix: auth and API signals, route guards, an HttpClient interceptor, plus the Vite adapter the Tylix CLI loads.",
  "type": "module",
  "keywords": [
    "tylix",
    "angular",
    "adapter"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./adapter": {
      "types": "./src/adapter.d.ts",
      "default": "./src/adapter.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "node --test src/*.test.js"
  },
  "dependencies": {
    "@tylix/client": "^0.6.0"
  },
  "peerDependencies": {
    "@angular/common": ">=20.0.0",
    "@angular/core": ">=20.0.0",
    "@angular/router": ">=20.0.0",
    "rxjs": "^7.4.0",
    "@angular/platform-server": ">=20.0.0"
  },
  "devDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "@angular/platform-server": {
      "optional": true
    }
  }
}

{
  "name": "@tylix/angular",
  "version": "1.5.0",
  "description": "Angular frontend for Tylix: auth and API signals, route guards, an HttpClient interceptor, plus the Vite adapter the Tylix CLI loads.",
  "license": "MIT",
  "author": "Mbiyrukzz",
  "type": "module",
  "keywords": [
    "tylix",
    "angular",
    "adapter",
    "signals",
    "ssr",
    "vite"
  ],
  "homepage": "https://github.com/Mbiyrukzz/tylix/tree/main/packages/angular#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mbiyrukzz/tylix.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/Mbiyrukzz/tylix/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./adapter": {
      "types": "./src/adapter.d.ts",
      "default": "./src/adapter.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    }
  },
  "files": [
    "src",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test src/*.test.js"
  },
  "dependencies": {
    "@tylix/client": "^1.5.0"
  },
  "peerDependencies": {
    "@angular/common": ">=20.0.0 <23.0.0",
    "@angular/core": ">=20.0.0 <23.0.0",
    "@angular/router": ">=20.0.0 <23.0.0",
    "rxjs": "^7.4.0",
    "@angular/platform-server": ">=20.0.0 <23.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/platform-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "^7.8.0"
  }
}

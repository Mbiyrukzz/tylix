{
  "name": "@tylix/orm",
  "version": "2.1.1",
  "description": "The Tylix ORM: models with observers and traits, a query builder, a schema builder for migrations (indexes, foreign keys, column changes), and adapters for SQLite, PostgreSQL, CockroachDB, MySQL, MariaDB and MongoDB.",
  "license": "MIT",
  "author": "Mbiyrukzz",
  "type": "module",
  "keywords": [
    "tylix",
    "orm",
    "database",
    "mongodb",
    "mysql",
    "postgresql",
    "sqlite",
    "postgres",
    "mariadb",
    "cockroachdb",
    "cockroach",
    "migrations",
    "schema-builder"
  ],
  "homepage": "https://github.com/Mbiyrukzz/tylix/tree/main/packages/orm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mbiyrukzz/tylix.git",
    "directory": "packages/orm"
  },
  "bugs": {
    "url": "https://github.com/Mbiyrukzz/tylix/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test 'src/**/*.test.js'"
  },
  "dependencies": {
    "@tylix/shared": "^2.1.1",
    "mongodb": "^6.5.0",
    "mysql2": "^3.23.1",
    "pg": "^8.11.0"
  }
}

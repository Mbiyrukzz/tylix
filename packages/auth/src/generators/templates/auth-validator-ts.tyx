// The rules for the auth forms. The API checks requests with them, and the
// frontend's login and register pages import this same file to check the
// form before sending it, so both always agree. That is why it imports
// from "@tylix/shared/validation", which runs in the browser too.
import {
    validate,
    required,
    isString,
    isEmail,
    minLength,
    maxLength,
    withMessage,
} from "@tylix/shared/validation";

export const MIN_PASSWORD_LENGTH = 8;
export const MAX_PASSWORD_LENGTH = 128;

const email = [
    withMessage(required, "Enter your email address."),
    isString,
    withMessage(isEmail, "Enter a valid email address."),
];

// Only for passwords being set (register, reset). Login must not enforce
// the length, so people with older, shorter passwords can still sign in.
const newPassword = [
    withMessage(required, "Choose a password."),
    isString,
    minLength(MIN_PASSWORD_LENGTH, `Password must be at least ${MIN_PASSWORD_LENGTH} characters.`),
    maxLength(MAX_PASSWORD_LENGTH, `Password must be at most ${MAX_PASSWORD_LENGTH} characters.`),
];

export const registerSchema = {
    name: [withMessage(required, "Enter your name."), isString, maxLength(100)],
    email,
    password: newPassword,
};

export const loginSchema = {
    email,
    password: [withMessage(required, "Enter your password."), isString],
};

export const forgotPasswordSchema = {
    email,
};

export const changePasswordSchema = {
    currentPassword: [withMessage(required, "Enter your current password."), isString],
    password: newPassword,
};

export const resendVerificationSchema = {
    email,
};

export const resetPasswordSchema = {
    email,
    token: [withMessage(required, "This reset link is incomplete."), isString],
    password: newPassword,
};

export function validateRegister(data: unknown) {
    return validate(data, registerSchema);
}

export function validateLogin(data: unknown) {
    return validate(data, loginSchema);
}

export function validateForgotPassword(data: unknown) {
    return validate(data, forgotPasswordSchema);
}

export function validateResetPassword(data: unknown) {
    return validate(data, resetPasswordSchema);
}

export function validateChangePassword(data: unknown) {
    return validate(data, changePasswordSchema);
}

export function validateResendVerification(data: unknown) {
    return validate(data, resendVerificationSchema);
}

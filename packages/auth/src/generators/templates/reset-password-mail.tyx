import { Mailable } from '@tylix/mail';

export class ResetPasswordMail extends Mailable {
    constructor(resetUrl) {
        super();
        this.resetUrl = resetUrl;
    }

    build() {
        return {
            subject: 'Reset your password',
            view: 'reset-password',
            data: { resetUrl: this.resetUrl },
        };
    }
}
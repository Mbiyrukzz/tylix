import { Model } from "@tylix/orm";

// One row per social login linked to a user ("Continue with Google /
// GitHub"). A user can have several; the provider's account id, not the
// email, is what identifies a returning user.
export class OAuthAccount extends Model {
    static table = "oauth_accounts";

    static fillable = [
        "provider_key",
        "provider",
        "provider_user_id",
        "user_id",
        "email",
    ];

    static keyFor(provider, providerUserId) {
        return `${provider}:${providerUserId}`;
    }

    static async findFor(provider, providerUserId) {
        return this.query().where("provider_key", this.keyFor(provider, providerUserId)).first();
    }

    // profile is what @tylix/auth's oauth.callback() returns.
    static async link(userId, profile) {
        return this.create({
            provider_key: this.keyFor(profile.provider, profile.id),
            provider: profile.provider,
            provider_user_id: String(profile.id),
            user_id: userId,
            email: profile.email ?? null,
        });
    }
}

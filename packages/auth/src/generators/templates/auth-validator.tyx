import { validate, required, isString, isEmail } from "@tylix/shared";

const MIN_PASSWORD_LENGTH = 8;
const MAX_PASSWORD_LENGTH = 128;

const registerSchema = {
    name: [required, isString],
    email: [required, isString, isEmail],
    password: [required, isString],
};

const loginSchema = {
    email: [required, isString, isEmail],
    password: [required, isString],
};

const forgotPasswordSchema = {
    email: [required, isString, isEmail],
};

const resetPasswordSchema = {
    email: [required, isString, isEmail],
    token: [required, isString],
    password: [required, isString],
};

// Only for passwords being set (register, reset). Login must not enforce
// it, so people with older, shorter passwords can still sign in.
function enforcePasswordLength(data, result) {
    const password = data?.password;
    if (typeof password !== "string") return result;
    if (result.errors?.password?.length) return result;

    let message = null;
    if (password.length < MIN_PASSWORD_LENGTH) {
        message = `Password must be at least ${MIN_PASSWORD_LENGTH} characters.`;
    } else if (password.length > MAX_PASSWORD_LENGTH) {
        message = `Password must be at most ${MAX_PASSWORD_LENGTH} characters.`;
    }
    if (!message) return result;

    return {
        ...result,
        valid: false,
        errors: { ...(result.errors ?? {}), password: [message] },
    };
}

export function validateRegister(data) {
    return enforcePasswordLength(data, validate(data, registerSchema));
}

export function validateLogin(data) {
    return validate(data, loginSchema);
}

export function validateForgotPassword(data) {
    return validate(data, forgotPasswordSchema);
}

export function validateResetPassword(data) {
    return enforcePasswordLength(data, validate(data, resetPasswordSchema));

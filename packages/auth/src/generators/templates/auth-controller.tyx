    async forgotPassword(req, res) {
        const ipLimit = forgotIpLimiter(clientIp(req));
        if (!ipLimit.allowed) {
            return res.status(429).json({
                error: `Too many requests. Try again in ${ipLimit.retryAfterSeconds} seconds.`,
            });

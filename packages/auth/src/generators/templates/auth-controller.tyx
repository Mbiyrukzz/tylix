    async resetPassword(req, res) {
        const result = validateResetPassword(req.body);
        if (!result.valid) {
            return res.status(422).json({ errors: result.errors });
        }

        // An unknown email gets the same answer as a bad token, so this
        // endpoint can't be used to find out who is registered.
        const user = await User.findByEmail(normalizeEmail(req.body.email));
        const record = user ? await PasswordReset.findValid(req.body.token, user.email) : null;
        if (!user || !record) {
            return res.status(400).json({ error: "Invalid or expired reset link." });
        }

        // Checked before the link is used up, so a rejected password can be retried.
        const passwordErrors = await this.passwordProblems(req.body.password, user);
        if (passwordErrors) {
            return res.status(422).json({ errors: { password: passwordErrors } });
        }

        if (!(await PasswordReset.consume(record))) {
            return res.status(400).json({ error: "Invalid or expired reset link." });
        }

        await User.updatePassword(user.id, req.body.password);
        await PasswordReset.invalidateFor(user.email);
        // The link reached the inbox, which proves the address.
        if (!User.isEmailVerified(user)) await User.markEmailVerified(user.id);
        // Resetting the password ends every session, in case the reset was
        // triggered because the account was compromised.
        await this.auth.revokeAllSessions(user.id);
        applyCookies(res, this.auth.clearCookies(req));

        return res.json({ ok: true, message: "Password updated. Please log in again." });
    }

    // For a signed-in user: needs the current password; keeps this session
    // and ends all others.
    async changePassword(req, res) {
        const limit = await changePasswordLimiter(String(req.user.userId));
        if (!limit.allowed) return tooMany(res, limit.retryAfterSeconds);

        const result = validateChangePassword(req.body);
        if (!result.valid) {
            return res.status(422).json({ errors: result.errors });
        }

        const user = await User.find(req.user.userId);
        if (!user || !(await verifyPassword(req.body.currentPassword, user.password))) {
            return res.status(422).json({ errors: { currentPassword: ["Your current password is incorrect."] } });
        }

        const passwordErrors = await this.passwordProblems(req.body.password, user);
        if (passwordErrors) {
            return res.status(422).json({ errors: { password: passwordErrors } });
        }

        await User.updatePassword(user.id, req.body.password);
        await this.auth.revokeAllSessions(user.id, { exceptSessionId: req.user.sid });
        return res.json({ ok: true, message: "Password changed. You have been signed out on other devices." });
    }

    // --- Social sign-in -------------------------------------------------

    // Which providers this app offers, for pages that want to hide the
    // buttons of providers that aren't configured yet.
    async oauthProviders(req, res) {
        return res.json({
            providers: Object.entries(OAUTH_PROVIDERS).map(([id, p]) => ({
                id,
                name: p.name,
                enabled: Boolean(process.env[`${p.env}_CLIENT_ID`] && process.env[`${p.env}_CLIENT_SECRET`]),
            })),
        });
    }

    oauthProviderFor(req, id) {
        const entry = Object.hasOwn(OAUTH_PROVIDERS, id) ? OAUTH_PROVIDERS[id] : null;
        if (!entry) return { error: "oauth_unknown" };
        const clientId = process.env[`${entry.env}_CLIENT_ID`];
        const clientSecret = process.env[`${entry.env}_CLIENT_SECRET`];
        const base = (this.appUrl || `http://${req.headers.host ?? "localhost:3000"}`).replace(/\/$/, "");
        const redirectUri = `${base}/api/auth/oauth/${id}/callback`;
        if (!clientId || !clientSecret) {
            console.warn(
                `[auth] ${entry.name} sign-in isn't configured. Set ${entry.env}_CLIENT_ID and ${entry.env}_CLIENT_SECRET in .env, ` +
                    `and register ${redirectUri} as the callback URL with ${entry.name}.`,
            );
            return { error: "oauth_unavailable" };
        }
        return { provider: entry.create({ clientId, clientSecret, redirectUri }), name: entry.name };
    }

    // GET /api/auth/oauth/:provider -> the provider's consent screen.
    async oauthStart(req, res) {
        const { provider, error } = this.oauthProviderFor(req, String(req.params.provider ?? ""));
        if (!provider) return backToLogin(res, error);
        const returnTo = typeof req.query.returnTo === "string" ? req.query.returnTo : "/dashboard";
        const { url, cookies } = await this.oauth.start(provider, req, { returnTo });
        return redirect(res, url, cookies);
    }

    // GET /api/auth/oauth/:provider/callback: the provider sends the user
    // back here. Signs them in (creating or linking the account) and
    // returns them to where they started.
    async oauthCallback(req, res) {
        const limit = await oauthLimiter(clientIp(req));
        if (!limit.allowed) return backToLogin(res, "oauth_rate_limited");

        const { provider, name, error } = this.oauthProviderFor(req, String(req.params.provider ?? ""));
        if (!provider) return backToLogin(res, error);

        let result;
        try {
            result = await this.oauth.callback(provider, req);
        } catch (err) {
            if (!(err instanceof OAuthError)) throw err;
            if (err.code === "provider_error") return backToLogin(res, "oauth_cancelled", err.cookies);
            console.warn(`[auth] ${name} sign-in failed (${err.code}): ${err.message}`);
            return backToLogin(res, "oauth_failed", err.cookies);
        }

        const { user, error: problem } = await this.userForOAuthProfile(result.profile);
        if (!user) return backToLogin(res, problem, result.cookies);

        const { cookies } = await this.auth.signIn(req, user.id, { persistent: true });
        return redirect(res, result.returnTo, [...result.cookies, ...cookies]);
    }

    // The user a provider profile belongs to: the linked account, else the
    // account with the same (provider-verified) email, else a new one.
    async userForOAuthProfile(profile) {
        const linked = await OAuthAccount.findFor(profile.provider, profile.id);
        if (linked) {
            const user = await User.find(linked.user_id);
            if (user) return { user };
            await OAuthAccount.delete(linked.id); // its user was deleted
        }

        // Only an address the provider has verified may be matched or used:
        // otherwise anyone could take over an account by putting its email
        // on their own GitHub profile.
        const email = normalizeEmail(profile.email);
        if (!email) return { error: "oauth_no_email" };
        if (!profile.emailVerified) return { error: "oauth_email_unverified" };

        let user = await User.findByEmail(email);
        if (user && !User.isEmailVerified(user)) {
            // An unverified account with this address may have been opened
            // by someone else, waiting for the real owner to link it. The
            // owner, now proven, takes it over: that password and every
            // session of the account stop working.
            await User.updatePassword(user.id, unusablePassword());
            await this.auth.revokeAllSessions(user.id);
            await User.markEmailVerified(user.id);
        }
        if (!user) {
            user = await User.create({
                name: profile.name || email.split("@")[0],
                email,
                password: unusablePassword(),
            });
            if (!user) return { error: "oauth_failed" };
            await User.markEmailVerified(user.id);
        }

        try {
            await OAuthAccount.link(user.id, profile);
        } catch (err) {
            // Two callbacks raced and the other one linked it first.
            if (!(await OAuthAccount.findFor(profile.provider, profile.id))) throw err;
        }
        return { user };
    }
}

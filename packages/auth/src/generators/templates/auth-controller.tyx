    async login(req, res) {
        const result = validateLogin(req.body);
        if (!result.valid) {
            return res.status(422).json({ errors: result.errors });
        }

        const email = normalizeEmail(req.body.email);
        const { allowed, retryAfterSeconds } = checkLoginAllowed(email);

    constructor({ secret, tokenExpiresInSeconds, mailConfig, checkBreachedPasswords = false, appUrl } = {}) {
        this.mailConfig = mailConfig;
        this.appUrl = appUrl ?? process.env.APP_URL;
        this.checkBreachedPasswords = checkBreachedPasswords;
        this.auth = createAuth({
            secret,
            adapter: modelAdapter(AuthSession),
            accessTokenTtl: Math.min(tokenExpiresInSeconds ?? DEFAULT_ACCESS_TOKEN_TTL_SECONDS, MAX_ACCESS_TOKEN_TTL_SECONDS),
            sessionTtl: "30d",
            idleTimeout: "14d",
            cookies: {
                accessName: ACCESS_TOKEN_COOKIE,
                refreshName: REFRESH_TOKEN_COOKIE,
                // The names are fixed (the SSR session code and devtools read
                // them); the Tylix server adds HSTS in production instead.

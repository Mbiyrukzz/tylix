        const result = validateForgotPassword(req.body);
        if (!result.valid) {
            return res.status(422).json({ errors: result.errors });
        }

        const email = normalizeEmail(req.body.email);

        // Counted for every address, registered or not, so hitting this limit
        // reveals nothing. When it is hit we answer as normal but send nothing.
        const emailLimit = forgotEmailLimiter(email);
        const user = await User.findByEmail(email);

        if (user && emailLimit.allowed) {

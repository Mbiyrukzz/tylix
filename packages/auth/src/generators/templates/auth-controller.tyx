        const user = await User.find(payload.uid);
        if (!user || payload.eh !== (await emailFingerprint(user.email))) {
            return res.status(400).json({ error: "Invalid or expired verification link." });
        }

        if (!User.isEmailVerified(user)) await User.markEmailVerified(user.id);
        return res.json({ ok: true, message: "Email verified. You can now log in." });
    }

    async resendVerification(req, res) {
        const ipLimit = await resendIpLimiter(clientIp(req));
        if (!ipLimit.allowed) return tooMany(res, ipLimit.retryAfterSeconds);

        const result = validateResendVerification(req.body);

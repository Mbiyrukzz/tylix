                // Reaches /api/auth/refresh AND /api/auth/logout, so logging
                // out really ends the session server-side.
                refreshPath: "/api/auth",
                legacyRefreshPaths: ["/api/auth/refresh"],
            },
            // The Tylix server already refuses cross-site writes (Sec-Fetch-Site

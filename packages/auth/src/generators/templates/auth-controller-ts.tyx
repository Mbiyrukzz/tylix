    async sendVerification(user: { id: number; email: string }) {
        const token = await this.auth.tokens.sign(
            { uid: user.id, eh: await emailFingerprint(user.email) },
            { type: "email-verify", expiresIn: EMAIL_VERIFY_TTL },

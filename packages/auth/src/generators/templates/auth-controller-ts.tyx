    async resetPassword(req: TylixRequest, res: TylixResponse) {
        const result = validateResetPassword(req.body);
        if (!result.valid) {
            return res.status(422).json({ errors: result.errors });
        }

        // An unknown email gets the same answer as a bad token, so this
        // endpoint can't be used to find out who is registered.
        const user = await User.findByEmail(normalizeEmail(req.body.email));
        const record = user ? await PasswordReset.findValid(req.body.token as string, user.email) : null;
        if (!user || !record) {
            return res.status(400).json({ error: "Invalid or expired reset link." });
        }

        // Checked before the link is used up, so a rejected password can be retried.
        const passwordErrors = await this.passwordProblems(req.body.password, user);
        if (passwordErrors) {
            return res.status(422).json({ errors: { password: passwordErrors } });
        }

        if (!(await PasswordReset.consume(record))) {
            return res.status(400).json({ error: "Invalid or expired reset link." });
        }

        await User.updatePassword(user.id, req.body.password as string);
        await PasswordReset.invalidateFor(user.email);
        // The link reached the inbox, which proves the address.
        if (!User.isEmailVerified(user)) await User.markEmailVerified(user.id);
        // Resetting the password ends every session, in case the reset was
        // triggered because the account was compromised.
        await this.auth.revokeAllSessions(user.id);
        applyCookies(res, this.auth.clearCookies(req));

        return res.json({ ok: true, message: "Password updated. Please log in again." });
    }

    // For a signed-in user: needs the current password; keeps this session
    // and ends all others.
    async changePassword(req: TylixRequest, res: TylixResponse) {
        const limit = await changePasswordLimiter(String(currentUser(req).userId));
        if (!limit.allowed) return tooMany(res, limit.retryAfterSeconds);

        const result = validateChangePassword(req.body);
        if (!result.valid) {
            return res.status(422).json({ errors: result.errors });
        }

        const user = await User.find(currentUser(req).userId);
        if (!user || !(await verifyPassword(req.body.currentPassword as string, user.password))) {
            return res.status(422).json({ errors: { currentPassword: ["Your current password is incorrect."] } });
        }

        const passwordErrors = await this.passwordProblems(req.body.password, user);
        if (passwordErrors) {
            return res.status(422).json({ errors: { password: passwordErrors } });
        }

        await User.updatePassword(user.id, req.body.password as string);
        await this.auth.revokeAllSessions(user.id, { exceptSessionId: currentUser(req).sid });
        return res.json({ ok: true, message: "Password changed. You have been signed out on other devices." });
    }

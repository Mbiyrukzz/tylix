    async register(req: TylixRequest, res: TylixResponse) {
        const limit = await registerLimiter(clientIp(req));
        if (!limit.allowed) return tooMany(res, limit.retryAfterSeconds, "Too many sign-ups from this address.");

        const result = validateRegister(req.body);
        if (!result.valid) {
            return res.status(422).json({ errors: result.errors });
        }

        const email = normalizeEmail(req.body.email);
        const passwordErrors = await this.passwordProblems(req.body.password, { email, name: req.body.name });
        if (passwordErrors) {
            return res.status(422).json({ errors: { password: passwordErrors } });
        }

        if (await User.findByEmail(email)) {

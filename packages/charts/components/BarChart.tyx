component BarChart

props
  series: Array
  categories?: Array
  label?: string
  width?: number
  height?: number
  orientation?: string
  stacked?: boolean
  legend?: boolean
  radius?: number
  padding?: number
  groupPadding?: number
  yDomain?: Array
  yTicks?: number
  formatValue?: Function
  formatCategory?: Function
  class?: string

state
  ready: false

computed
  rootClass() {
    return `tylix-chart text-zinc-500 dark:text-zinc-400 ${this.class ?? ""}`
  }

  ratio() {
    return `aspect-ratio:${this.width ?? 480} / ${this.height ?? 240}`
  }

  horizontal() {
    return this.orientation is "horizontal"
  }

  chart() {
    if not this.ready {
      return null
    }
    return window.__tylixCharts.barChart(this.series ?? [], {
      categories: this.categories,
      orientation: this.orientation ?? "vertical",
      stacked: this.stacked ?? false,
      width: this.width ?? 480,
      height: this.height ?? 240,
      yDomain: this.yDomain,
      yTicks: this.yTicks ?? 5,
      radius: this.radius ?? 4,
      padding: this.padding ?? 0.3,
      groupPadding: this.groupPadding ?? 0.08,
      formatValue: this.formatValue,
      formatCategory: this.formatCategory,
    })
  }

  showLegend() {
    if not this.ready {
      return false
    }
    if this.legend is false {
      return false
    }
    return this.chart.series.length > 1
  }

  // Vertical charts drop labels that would collide.
  catTicks() {
    if not this.ready {
      return []
    }
    const ticks = this.chart.categoryTicks
    if this.horizontal {
      return ticks
    }
    const step = this.chart.categoryScale.step()
    let longest = 1
    ticks.forEach(t => {
      longest = Math.max(longest, t.label.length)
    })
    const skip = Math.max(1, Math.ceil((longest * 6.2 + 6) / (step > 0 ? step : 1)))
    return ticks.filter(t => (t.index % skip) is 0)
  }

  bars() {
    if not this.ready {
      return []
    }
    const single = this.chart.series.length is 1
    const out = []
    this.chart.series.forEach(s => {
      s.bars.forEach(b => {
        if b.path {
          out.push({
            d: b.path,
            color: s.color,
            tip: single ? `${b.categoryLabel}: ${b.label}` : `${b.categoryLabel} · ${s.name}: ${b.label}`,
          })
        }
      })
    })
    return out
  }

onMount
  async {
    const load = window.__tylixChartsLoad ?? (window.__tylixChartsLoad = import("/_tylix/charts/index.js").then(m => { window.__tylixCharts = m }))
    try {
      await load
      this.ready = true
    } catch (e) {
      console.error("[tylix/charts] could not load geometry", e)
      window.__tylixChartsLoad = null
    }
  }

template
<div class="{{ rootClass }}">
{{#if ready}}
{{#if showLegend}}
  <div class="flex flex-wrap gap-x-4 gap-y-1 mb-2 text-xs text-zinc-600 dark:text-zinc-300">
{{#each s in chart.series}}
    <span class="inline-flex items-center gap-1.5">
      <span class="w-2.5 h-2.5 rounded-[3px]" style="{{ `background:${s.color}` }}"></span>{{ s.name }}
    </span>
{{/each}}
  </div>
{{/if}}
  <svg viewBox="{{ `0 0 ${chart.width} ${chart.height}` }}" class="w-full h-auto" font-size="11" role="img" aria-label="{{ label or 'Bar chart' }}">
{{#if horizontal}}
{{#each t in chart.valueTicks}}
    <line x1="{{ t.pos }}" x2="{{ t.pos }}" y1="{{ chart.plot.y }}" y2="{{ chart.plot.y + chart.plot.height }}" stroke="currentColor" stroke-opacity="0.1" stroke-dasharray="3 4" />
    <text x="{{ t.pos }}" y="{{ chart.plot.y + chart.plot.height + 16 }}" text-anchor="middle" fill="currentColor" fill-opacity="0.65">{{ t.label }}</text>
{{/each}}
    <line x1="{{ chart.baseline }}" x2="{{ chart.baseline }}" y1="{{ chart.plot.y }}" y2="{{ chart.plot.y + chart.plot.height }}" stroke="currentColor" stroke-opacity="0.3" />
{{#each t in catTicks}}
    <text x="{{ chart.plot.x - 8 }}" y="{{ t.pos }}" text-anchor="end" dominant-baseline="middle" fill="currentColor" fill-opacity="0.65">{{ t.label }}</text>
{{/each}}
{{#else}}
{{#each t in chart.valueTicks}}
    <line x1="{{ chart.plot.x }}" x2="{{ chart.plot.x + chart.plot.width }}" y1="{{ t.pos }}" y2="{{ t.pos }}" stroke="currentColor" stroke-opacity="0.1" stroke-dasharray="3 4" />
    <text x="{{ chart.plot.x - 8 }}" y="{{ t.pos }}" text-anchor="end" dominant-baseline="middle" fill="currentColor" fill-opacity="0.65">{{ t.label }}</text>
{{/each}}
    <line x1="{{ chart.plot.x }}" x2="{{ chart.plot.x + chart.plot.width }}" y1="{{ chart.baseline }}" y2="{{ chart.baseline }}" stroke="currentColor" stroke-opacity="0.3" />
{{#each t in catTicks}}
    <text x="{{ t.pos }}" y="{{ chart.plot.y + chart.plot.height + 16 }}" text-anchor="middle" fill="currentColor" fill-opacity="0.65">{{ t.label }}</text>
{{/each}}
{{/if}}

{{#each b in bars}}
    <path d="{{ b.d }}" fill="{{ b.color }}" class="opacity-90 hover:opacity-100 transition-opacity">
      <title>{{ b.tip }}</title>
    </path>
{{/each}}
  </svg>
{{#else}}
  <div class="w-full" style="{{ ratio }}"></div>
{{/if}}
</div>
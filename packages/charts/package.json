{
  "name": "@tylix/charts",
  "version": "1.4.0",
  "description": "SVG charts for Tylix .tyx pages, React, Vue, Svelte or plain JS: line, area, bar, pie, donut, scatter/bubble, gauge, calendar heatmap and sparklines, with time axes, tooltips and accessible output. No dependencies.",
  "license": "MIT",
  "author": "Mbiyrukzz",
  "type": "module",
  "keywords": [
    "tylix",
    "charts",
    "svg",
    "components"
  ],
  "homepage": "https://github.com/Mbiyrukzz/tylix/tree/main/packages/charts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mbiyrukzz/tylix.git",
    "directory": "packages/charts"
  },
  "bugs": {
    "url": "https://github.com/Mbiyrukzz/tylix/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/frameworks/react.d.ts",
      "default": "./src/frameworks/react.js"
    },
    "./vue": {
      "types": "./src/frameworks/vue.d.ts",
      "default": "./src/frameworks/vue.js"
    },
    "./svelte": {
      "types": "./src/frameworks/svelte/index.d.ts",
      "svelte": "./src/frameworks/svelte/index.js",
      "default": "./src/frameworks/svelte/index.js"
    }
  },
  "files": [
    "src",
    "components",
    "tylix-components.json",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@tylix/compiler": "^1.4.0",
    "jsdom": "^29.1.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3",
    "svelte": ">=5.20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}

{
  "manifest_version": 3,
  "name": "Tylix DevTools",
  "version": "2.1.0",
  "description": "Inspect and edit the live state of Tylix pages, components and capabilities.",
  "devtools_page": "devtools.html",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "devtools@tylix.dev",
      "strict_min_version": "128.0"
    }
  },
  "homepage_url": "https://github.com/Mbiyrukzz/tylix/tree/main/devtools/extension"
}
